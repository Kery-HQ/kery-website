---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/sections/SiteHeader';
import SiteFooter from '@/components/sections/SiteFooter';
import { buttonVariants } from '@/components/ui/button';
---

<Layout title="404 - Kery" description="The page you are looking for does not exist." robots="noindex, nofollow">
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-4 py-24">
    <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-muted-foreground">This page doesn't exist.</p>
    <a href="/" class={buttonVariants({ variant: 'outline', className: 'mt-8' })}>Back to home</a>
  </main>
  <SiteFooter />
</Layout>
