  .steps-list p {
    margin-top: 0.35rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .install-section {
    background:
      linear-gradient(90deg, rgba(38, 33, 21, 0.035) 1px, transparent 1px),
