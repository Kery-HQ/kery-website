  .kery-cursor {
    position: absolute;
    z-index: 8;
    left: 21%;
    top: 74%;
    width: 1.55rem;
    height: 1.55rem;
    transform-origin: 0 0;
    animation: kery-cursor-run var(--loop) linear infinite;
