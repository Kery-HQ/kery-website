    line-height: 1.62;
  }

  .install-feature-list li > span {
    width: 0.58rem;
    height: 0.58rem;
    margin-top: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 68%, var(--color-border));
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 3px 3px 0 rgba(67, 118, 72, 0.16);
