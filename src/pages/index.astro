    pointer-events: none;
    background:
      radial-gradient(circle at 78% 4%, rgba(255, 207, 73, 0.12), transparent 15rem),
      linear-gradient(180deg, rgba(255, 248, 232, 0.035), transparent 36%);
  }

  .terminal-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.76rem 0.95rem;
    border-bottom: 1px solid rgba(255, 248, 232, 0.1);
    background: rgba(23, 23, 20, 0.72);
  }

  .terminal-top span {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: #ff695f;
  }

  .terminal-top span:nth-child(2) {
    background: #ffcf49;
  }

  .terminal-top span:nth-child(3) {
    background: #63c174;
  }

  .terminal-top strong {
    margin-left: auto;
    color: rgba(255, 248, 232, 0.54);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .setup-story {
    position: relative;
    z-index: 1;
    padding: 1rem;
    background:
      linear-gradient(90deg, rgba(255, 248, 232, 0.035) 1px, transparent 1px),
      linear-gradient(rgba(255, 248, 232, 0.035) 1px, transparent 1px),
      #11120f;
    background-size: 24px 24px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .story-stage {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
    border: 1px solid rgba(255, 248, 232, 0.1);
    border-radius: 10px;
    background: rgba(10, 10, 8, 0.66);
  }

  .story-scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    opacity: 0;
    transform: translateY(0.65rem) scale(0.98);
    animation-duration: var(--story-loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease;
  }

  .scene-command { animation-name: scene-command; }
  .scene-provider { animation-name: scene-provider; }
  .scene-mcp { animation-name: scene-mcp; }
  .scene-boot { animation-name: scene-boot; }

  .story-command {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: min(100%, 25rem);
    min-height: 7.2rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(255, 248, 232, 0.16);
    border-radius: 10px;
    background: #090a08;
    box-shadow:
      0 14px 0 rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 248, 232, 0.08);
    color: #fff8e8;
    font-size: clamp(1.75rem, 4vw, 3rem);
  }

  .story-command span {
    color: #8bdba0;
    font-weight: 900;
  }

  .story-command strong {
    display: inline-block;
    width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-weight: 900;
    animation: command-type var(--story-loop) steps(10, end) infinite;
  }

  .story-command i {
    width: 0.62rem;
    height: 2.3rem;
    background: #ffcf49;
    animation: command-caret var(--story-loop) steps(1, end) infinite;
  }

  .story-caption {
    display: grid;
    gap: 0.26rem;
    margin-top: 1.35rem;
    text-align: center;
  }

  .story-caption strong,
  .story-question,
  .mcp-toggle strong,
  .dashboard-ready strong {
    color: #fff8e8;
    font-size: 0.95rem;
    font-weight: 900;
  }

  .story-caption span {
    color: rgba(255, 248, 232, 0.58);
  }

  .provider-card,
  .mcp-card,
  .boot-card {
    position: relative;
    width: min(100%, 25rem);
    padding: 1rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 10px;
    background: #171714;
    box-shadow: 0 8px 0 rgba(0, 0, 0, 0.24);
  }

  .story-question {
    margin-bottom: 0.8rem;
  }

  .provider-options {
    display: grid;
    gap: 0.42rem;
  }

  .provider-option,
  .api-key-row,
  .mcp-toggle,
  .ide-grid div,
  .service-list span,
  .dashboard-ready {
    border: 1px solid rgba(255, 248, 232, 0.1);
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.05);
  }

  .provider-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.68rem;
    color: rgba(255, 248, 232, 0.62);
    animation-duration: var(--story-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .provider-options strong {
    color: inherit;
    font-size: 0.8rem;
  }

  .provider-openai {
    animation-name: provider-openai-select;
  }

  .provider-openrouter {
    animation-name: provider-openrouter-select;
  }

  .provider-anthropic {
    animation-name: provider-anthropic-select;
  }

  .provider-gemini {
    color: rgba(255, 248, 232, 0.42);
  }

  .provider-option em {
    margin-left: auto;
    color: rgba(255, 248, 232, 0.58);
    font-style: normal;
    opacity: 0;
    animation: provider-selected-label var(--story-loop) steps(1, end) infinite;
  }

  .api-key-row {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.8rem;
    padding: 0.6rem 0.68rem;
    color: rgba(255, 248, 232, 0.54);
    opacity: 0.42;
    animation: api-key-row var(--story-loop) steps(1, end) infinite;
  }

  .api-key-row code {
    display: inline-flex;
    align-items: center;
    min-width: 8.6rem;
    color: #8bdba0;
    font: inherit;
  }

  .api-key-typed {
    display: inline-block;
    width: 0;
    overflow: hidden;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    animation: api-key-type var(--story-loop) steps(15, end) infinite;
  }

  .api-key-caret {
    width: 0.42rem;
    height: 0.9rem;
    margin-left: 0.08rem;
    background: #ffcf49;
    opacity: 0;
    animation: api-key-caret var(--story-loop) steps(1, end) infinite;
  }

  .selection-cursor {
    position: absolute;
    right: 0.7rem;
    top: 3.58rem;
    padding: 0.2rem 0.38rem;
    border: 2px solid #171714;
    border-radius: 4px;
    background: #ffcf49;
    color: #171714;
    font-size: 0.62rem;
    text-transform: uppercase;
    animation: selection-click var(--story-loop) infinite;
  }

  .mcp-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem;
  }

  .mcp-toggle span {
    position: relative;
    width: 2.6rem;
    height: 1.35rem;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.14);
    animation: mcp-switch-bg var(--story-loop) steps(1, end) infinite;
  }

  .mcp-toggle i {
    position: absolute;
    left: 0.18rem;
    top: 0.18rem;
    width: 0.98rem;
    height: 0.98rem;
    border-radius: 999px;
    background: #fff8e8;
    animation: mcp-switch-knob var(--story-loop) steps(1, end) infinite;
  }

  .ide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .ide-grid div {
    display: grid;
    gap: 0.38rem;
    justify-items: center;
    min-height: 5rem;
    padding: 0.72rem 0.45rem;
    color: rgba(255, 248, 232, 0.68);
    text-align: center;
  }

  .ide-grid img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .ide-grid span {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    background: #8bdba0;
    color: #171714;
    font-size: 0.7rem;
    font-weight: 900;
    opacity: 0;
    transform: scale(0.4);
    animation: ide-check var(--story-loop) steps(1, end) infinite;
  }

  .ide-grid div:nth-child(2) span { animation-delay: 0.15s; }
  .ide-grid div:nth-child(3) span { animation-delay: 0.3s; }

  .service-list {
    display: grid;
    gap: 0.5rem;
  }

  .service-list span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.58rem 0.68rem;
    color: rgba(255, 248, 232, 0.66);
  }

  .service-list i {
    width: 0.64rem;
    height: 0.64rem;
    border-radius: 999px;
    background: #8bdba0;
    box-shadow: 0 0 0 0 rgba(139, 219, 160, 0.5);
    animation: service-pulse 1.1s ease infinite;
  }

  .service-list span:nth-child(2) i { animation-delay: 0.1s; }
  .service-list span:nth-child(3) i { animation-delay: 0.2s; }
  .service-list span:nth-child(4) i { animation-delay: 0.3s; }
  .service-list span:nth-child(5) i { animation-delay: 0.4s; }

  .dashboard-ready {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin-top: 0.85rem;
    padding: 0.8rem;
    border-color: rgba(139, 219, 160, 0.32);
    background: rgba(139, 219, 160, 0.1);
  }

  .dashboard-ready > span {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: #8bdba0;
    color: #171714;
    font-weight: 900;
  }

  .dashboard-ready code {
    display: block;
    margin-top: 0.16rem;
    color: #ffcf49;
    font: inherit;
  }

  .story-rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
    margin-top: 0.78rem;
  }

  .story-rail span {
    min-width: 0;
    padding: 0.42rem 0.3rem;
    border: 1px solid rgba(255, 248, 232, 0.1);
    border-radius: 6px;
    color: rgba(255, 248, 232, 0.48);
    font-size: 0.66rem;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
    animation-duration: var(--story-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .story-rail span:nth-child(1) { animation-name: rail-command; }
  .story-rail span:nth-child(2) { animation-name: rail-provider; }
  .story-rail span:nth-child(3) { animation-name: rail-mcp; }
  .story-rail span:nth-child(4) { animation-name: rail-boot; }

  @keyframes scene-command {
    0%, 22% { opacity: 1; transform: translateY(0) scale(1); }
    26%, 100% { opacity: 0; transform: translateY(-0.5rem) scale(0.98); }
  }

  @keyframes scene-provider {
    0%, 22% { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
    26%, 50.5% { opacity: 1; transform: translateY(0) scale(1); }
    54.5%, 100% { opacity: 0; transform: translateY(-0.5rem) scale(0.98); }
  }

  @keyframes scene-mcp {
    0%, 50.5% { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
    54.5%, 72% { opacity: 1; transform: translateY(0) scale(1); }
    76%, 100% { opacity: 0; transform: translateY(-0.5rem) scale(0.98); }
  }

  @keyframes scene-boot {
    0%, 72% { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
    76%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes command-type {
    0%, 4% { width: 0; }
    14%, 100% { width: 10ch; }
  }

  @keyframes command-caret {
    0%, 4%, 15%, 17%, 19%, 21%, 100% { opacity: 0; }
    5%, 14%, 16%, 18%, 20% { opacity: 1; }
  }

  @keyframes provider-openai-select {
    0%, 27%, 33%, 100% { border-color: rgba(255, 248, 232, 0.1); background: rgba(255, 248, 232, 0.05); color: rgba(255, 248, 232, 0.62); box-shadow: none; }
    28%, 32% { border-color: rgba(255, 207, 73, 0.62); background: rgba(255, 207, 73, 0.13); color: #ffcf49; box-shadow: 0 0 0 3px rgba(255, 207, 73, 0.16); }
  }

  @keyframes provider-openrouter-select {
    0%, 32%, 39%, 100% { border-color: rgba(255, 248, 232, 0.1); background: rgba(255, 248, 232, 0.05); color: rgba(255, 248, 232, 0.62); box-shadow: none; }
    33%, 38% { border-color: rgba(255, 207, 73, 0.62); background: rgba(255, 207, 73, 0.13); color: #ffcf49; box-shadow: 0 0 0 3px rgba(255, 207, 73, 0.16); }
  }

  @keyframes provider-anthropic-select {
    0%, 38%, 100% { border-color: rgba(255, 248, 232, 0.1); background: rgba(255, 248, 232, 0.05); color: rgba(255, 248, 232, 0.62); box-shadow: none; }
    39%, 54% { border-color: rgba(255, 207, 73, 0.62); background: rgba(255, 207, 73, 0.13); color: #ffcf49; box-shadow: 0 0 0 3px rgba(255, 207, 73, 0.16); }
  }

  @keyframes provider-selected-label {
    0%, 38%, 100% { opacity: 0; }
    39%, 54% { opacity: 1; }
  }

  @keyframes selection-click {
    0%, 27%, 42%, 100% { opacity: 0; transform: translateY(-0.45rem); top: 3.58rem; }
    28%, 31% { opacity: 1; transform: translateY(0); top: 3.58rem; }
    33%, 36% { opacity: 1; transform: translateY(0); top: 5.58rem; }
    39%, 41% { opacity: 1; transform: translateY(0); top: 7.58rem; }
  }

  @keyframes api-key-row {
    0%, 39%, 100% { opacity: 0.42; }
    40%, 54% { opacity: 1; }
  }

  @keyframes api-key-type {
    0%, 41% { width: 0; }
    52.5%, 100% { width: 15ch; }
  }

  @keyframes api-key-caret {
    0%, 40%, 53.5%, 100% { opacity: 0; }
    41%, 53% { opacity: 1; }
  }

  @keyframes mcp-switch-bg {
    0%, 55% { background: rgba(255, 248, 232, 0.14); }
    56%, 100% { background: rgba(139, 219, 160, 0.34); }
  }

  @keyframes mcp-switch-knob {
    0%, 55% { transform: translateX(0); }
    56%, 100% { transform: translateX(1.22rem); }
  }

  @keyframes ide-check {
    0%, 57% { opacity: 0; transform: scale(0.4); }
    58%, 100% { opacity: 1; transform: scale(1); }
  }

  @keyframes service-pulse {
    0% { box-shadow: 0 0 0 0 rgba(139, 219, 160, 0.5); }
    70%, 100% { box-shadow: 0 0 0 0.55rem rgba(139, 219, 160, 0); }
  }

  @keyframes rail-command {
    0%, 23% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
    24%, 100% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
  }

  @keyframes rail-provider {
    0%, 23%, 52.5%, 100% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
    24%, 52% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
  }

  @keyframes rail-mcp {
    0%, 52%, 74%, 100% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
    52.5%, 73% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
  }

  @keyframes rail-boot {
    0%, 73% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
    74%, 100% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
  }

  .cloud-section {
    --cloud-accent: #437648;
    --cloud-accent-bright: #8bdba0;
    --cloud-warning: #a86413;
    background:
      radial-gradient(circle at 88% 16%, rgba(255, 207, 73, 0.12), transparent 22rem),
      radial-gradient(circle at 12% 80%, rgba(139, 219, 160, 0.08), transparent 24rem),
      #171714;
    color: #fff8e8;
  }

  .cloud-section .section-kicker,
  .cloud-section .form-eyebrow {
    color: #ffcf49;
  }

  .cloud-section h2 {
    color: #fff8e8;
  }

  .cloud-section .section-copy > p {
    color: rgba(255, 248, 232, 0.72);
  }

  .cloud-grid {
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    align-items: center;
  }

  .cloud-grid > .section-copy {
    order: -1;
  }

  .cloud-grid > .cloud-form {
    grid-column: 1 / -1;
  }

  .cloud-ci-card {
    --ci-loop: 15s;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 248, 232, 0.12);
    border-radius: 14px;
    background: #fffdf6;
    color: #171714;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.52);
  }

  .cloud-ci-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(38, 33, 21, 0.03), transparent 34%),
      linear-gradient(90deg, rgba(255, 248, 232, 0.58), rgba(255, 248, 232, 0));
  }

  .cloud-ci-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.76rem 0.95rem;
    border-bottom: 1px solid #ded4be;
    background: #f7f1e4;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .cloud-ci-topbar > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: var(--cloud-accent);
  }

  .cloud-ci-topbar i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
    animation: pixel-blink 1s steps(2, end) infinite;
  }

  .cloud-ci-stage {
    position: relative;
    z-index: 1;
    padding: 1rem;
    background: #fffdf6;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .ci-rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
    margin-bottom: 0.78rem;
  }

  .ci-progress-track {
    overflow: hidden;
    height: 0.42rem;
    margin-bottom: 0.78rem;
    border: 1px solid #ded4be;
    border-radius: 999px;
    background: #fffdf6;
  }

  .ci-progress-track span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #ffcf49, var(--cloud-accent-bright));
    transform: scaleX(0.06);
    transform-origin: left center;
    animation: ci-progress-fill var(--ci-loop) linear infinite;
  }

  .ci-rail span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    gap: 0.32rem;
    min-height: 2rem;
    padding: 0.42rem 0.3rem;
    border: 1px solid #ded4be;
    border-radius: 6px;
    color: var(--color-text-muted);
    font-size: 0.66rem;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
    background: rgba(255, 253, 246, 0.74);
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .ci-rail span:nth-child(1) { animation-name: ci-rail-github; }
  .ci-rail span:nth-child(2) { animation-name: ci-rail-vercel; }
  .ci-rail span:nth-child(3) { animation-name: ci-rail-kery; }
  .ci-rail span:nth-child(4) { animation-name: ci-rail-check; }

  .ci-svg {
    display: block;
    flex: 0 0 auto;
    width: 0.9rem;
    height: 0.9rem;
    color: var(--color-text-muted);
  }

  .ci-svg path {
    fill: currentColor;
  }

  .ci-pr-svg path,
  .ci-pr-svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ci-rail span .ci-svg {
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .ci-rail span:nth-child(1) .ci-svg { animation-name: ci-rail-github-icon; }
  .ci-rail span:nth-child(2) .ci-svg { animation-name: ci-rail-vercel-icon; }
  .ci-rail span:nth-child(3) .ci-svg { animation-name: ci-rail-kery-icon; }
  .ci-rail span:nth-child(4) .ci-svg { animation-name: ci-rail-check-icon; }

  .ci-pr-svg,
  .ci-comment-svg {
    color: var(--cloud-accent);
  }

  .ci-vercel-svg {
    color: #171714;
  }

  .ci-kery-logo {
    display: block;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    background: #171714;
    -webkit-mask: url('/kery.png') center / contain no-repeat;
    mask: url('/kery.png') center / contain no-repeat;
  }

  .ci-flow {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
    border: 1px solid #ded4be;
    border-radius: 10px;
    background: #fff8e8;
  }

  .ci-platform-card {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    gap: 0.62rem;
    width: min(100% - 2rem, 25rem);
    padding: 1rem;
    border: 1px solid #ded4be;
    border-radius: 10px;
    background: #fffdf6;
    box-shadow: 0 8px 0 rgba(38, 33, 21, 0.08);
    opacity: 0;
    transform: translate(-50%, -50%) translateY(0.65rem);
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease;
  }

  .ci-github-card { animation-name: ci-pr-active; }
  .ci-vercel-card { animation-name: ci-preview-active; }
  .ci-run-panel { animation-name: ci-run-active; }
  .ci-result { animation-name: ci-result-active; }

  .ci-platform-head,
  .ci-run-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .ci-platform-head,
  .ci-run-header {
    padding-bottom: 0.52rem;
    border-bottom: 1px solid #ded4be;
  }

  .ci-platform-head b,
  .ci-run-header strong {
    color: #171714;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  .ci-platform-head span,
  .ci-run-header span {
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .github-pr-ui,
  .vercel-preview-ui {
    display: grid;
    gap: 0.5rem;
  }

  .github-pr-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
  }

  .github-pr-main > .ci-svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .github-pr-main > div {
    display: grid;
    min-width: 0;
    gap: 0.08rem;
  }

  .github-pr-main strong,
  .vercel-status strong,
  .kery-run-focus strong {
    overflow: hidden;
    color: #171714;
    font: inherit;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .github-pr-main span,
  .github-pr-ui p,
  .vercel-status span,
  .vercel-deploy-meta span {
    color: var(--color-text-secondary);
    font-size: 0.7rem;
  }

  .github-pr-main em {
    color: var(--cloud-accent);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 900;
    text-transform: uppercase;
  }

  .github-change-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .github-change-row span {
    padding: 0.18rem 0.38rem;
    border: 1px solid #ded4be;
    border-radius: 4px;
    background: #fffdf6;
    color: var(--color-text-secondary);
    font-size: 0.64rem;
    font-weight: 800;
  }

  .vercel-status {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .vercel-status > div {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
  }

  .vercel-status-icon {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    border: 2px solid rgba(23, 23, 20, 0.22);
    border-top-color: #171714;
    border-radius: 999px;
    animation: vercel-deploy-spinner var(--ci-loop) linear infinite;
  }

  .vercel-status-icon::after {
    content: "";
    position: absolute;
    left: 0.32rem;
    top: 0.18rem;
    width: 0.24rem;
    height: 0.46rem;
    border-right: 2px solid var(--cloud-accent);
    border-bottom: 2px solid var(--cloud-accent);
    opacity: 0;
    transform: rotate(45deg) scale(0.82);
    transform-origin: center;
    animation: vercel-deploy-check var(--ci-loop) steps(1, end) infinite;
  }

  .vercel-status strong {
    position: relative;
    display: block;
    min-height: 1rem;
    min-width: 9.6rem;
  }

  .vercel-deploying,
  .vercel-deployed {
    position: absolute;
    inset: 0 auto auto 0;
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .vercel-deploying {
    animation-name: vercel-deploying-label;
  }

  .vercel-deployed {
    opacity: 0;
    animation-name: vercel-deployed-label;
  }

  .vercel-url-card {
    display: grid;
    gap: 0.18rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid #ded4be;
    border-radius: 7px;
    background: #fffdf6;
  }

  .vercel-url-card span {
    color: var(--color-text-muted);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .vercel-url-card code {
    overflow: hidden;
    color: var(--cloud-accent);
    font: inherit;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    animation: vercel-url-reveal var(--ci-loop) steps(1, end) infinite;
  }

  .vercel-deploy-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
  }

  .kery-run-focus {
    display: grid;
    gap: 0.22rem;
    padding: 0.56rem 0.6rem;
    border: 1px solid #ded4be;
    border-radius: 7px;
    background: #fffdf6;
  }

  .kery-run-focus > span {
    color: var(--color-text-muted);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .kery-run-focus strong {
    font-size: 0.76rem;
    white-space: normal;
  }

  .kery-run-focus code {
    color: var(--cloud-accent);
    font: inherit;
    font-weight: 900;
  }

  .ci-run-panel ol {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.38rem;
    margin: 0;
  }

  .ci-run-panel li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.46rem 0.5rem;
    border: 1px solid #ded4be;
    border-radius: 7px;
    background: #fffdf6;
    color: var(--color-text-secondary);
  }

  .ci-run-panel li span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ci-run-panel li i {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.16rem;
    height: 1.16rem;
    border: 1px solid rgba(67, 118, 72, 0.18);
    border-radius: 999px;
    background: rgba(67, 118, 72, 0.1);
    color: transparent;
    font-size: 0.76rem;
    font-style: normal;
    font-weight: 900;
    line-height: 1;
    animation: ci-flow-check var(--ci-loop) steps(1, end) infinite;
  }

  .ci-run-panel li i.ci-alert {
    animation-name: ci-flow-alert;
  }

  .ci-run-panel li b {
    margin-left: auto;
    color: var(--cloud-warning);
    font-size: 0.62rem;
    text-transform: uppercase;
    opacity: 0;
    animation: ci-issue-count var(--ci-loop) steps(1, end) infinite;
  }

  .ci-run-panel li:nth-child(2) i { animation-delay: 0.45s; }
  .ci-run-panel li:nth-child(3) i { animation-delay: 0.9s; }
  .ci-run-panel li:nth-child(3) b { animation-delay: 0.9s; }
  .ci-run-panel li:nth-child(4) i { animation-delay: 1.35s; }

  .github-timeline-ui {
    display: grid;
    gap: 0.55rem;
  }

  .github-timeline-updates {
    display: grid;
    gap: 0.4rem;
    padding-left: 0.53rem;
    border-left: 2px solid #ded4be;
  }

  .github-timeline-updates div {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.42rem;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
  }

  .github-timeline-updates i {
    position: absolute;
    left: -0.72rem;
    width: 0.38rem;
    height: 0.38rem;
    border: 2px solid #fffdf6;
    border-radius: 999px;
    background: var(--cloud-accent);
  }

  .github-timeline-updates strong {
    color: #171714;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .cloud-feature-list {
    display: grid;
    gap: 0.72rem;
    margin-top: 1.2rem;
  }

  .cloud-feature-list li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.68rem;
    align-items: start;
    color: rgba(255, 248, 232, 0.72);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.62;
  }

  .cloud-feature-list li > span {
    width: 0.58rem;
    height: 0.58rem;
    margin-top: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 68%, var(--color-border));
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 3px 3px 0 rgba(67, 118, 72, 0.16);
  }

  .cloud-form {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(22rem, 1fr);
    gap: 1rem;
    align-items: center;
    overflow: hidden;
    margin-top: 0.25rem;
    padding: 1rem;
    width: 100%;
    border: 1px solid rgba(255, 248, 232, 0.13);
    border-radius: 14px;
    border-color: rgba(255, 248, 232, 0.13);
    background: #12120f;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 248, 232, 0.08);
  }

  .cloud-form::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 84% 18%, rgba(255, 207, 73, 0.13), transparent 14rem),
      linear-gradient(180deg, rgba(255, 248, 232, 0.045), transparent 56%);
  }

  .cloud-form > * {
    position: relative;
    z-index: 1;
  }

  .cloud-form h3 {
    color: #fff8e8;
    font-size: clamp(1.45rem, 2.4vw, 2.15rem);
    line-height: 1.1;
  }

  .cloud-form p {
    color: rgba(255, 248, 232, 0.68);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .cloud-form-copy {
    display: grid;
    gap: 0.5rem;
  }

  .cloud-form-action {
    display: grid;
    gap: 0.55rem;
  }

  .cloud-form-action > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
  }

  .cloud-form .button {
    width: auto;
    min-height: 2.95rem;
    border: 2px solid #ffcf49;
    border-radius: 4px;
    background: #ffcf49;
    box-shadow: 0 3px 0 #171714;
    color: #171714;
    white-space: nowrap;
  }

  .cloud-form input {
    width: 100%;
    min-height: 2.95rem;
    border: 2px solid #171714;
    border-radius: 4px;
    background: #fffdf6;
    box-shadow: 0 3px 0 #171714;
    color: var(--color-ink);
    padding: 0 0.8rem;
    font: inherit;
  }

  .cloud-form p#waitlist-status {
    min-height: 1.1rem;
    font-size: 0.8rem;
  }

  .cloud-form p#waitlist-status.success {
    color: #8bdba0;
  }

  .cloud-form p#waitlist-status.error {
    color: #ff9388;
  }

  @keyframes ci-rail-github {
    0%, 23% { color: #171714; }
    24%, 100% { color: var(--color-text-muted); }
  }

  @keyframes ci-progress-fill {
    0% { transform: scaleX(0.08); }
    24% { transform: scaleX(0.3); }
    51% { transform: scaleX(0.58); }
    75% { transform: scaleX(0.84); }
    100% { transform: scaleX(1); }
  }

  @keyframes ci-rail-vercel {
    0%, 23%, 51%, 100% { color: var(--color-text-muted); }
    24%, 50% { color: #171714; }
  }

  @keyframes ci-rail-kery {
    0%, 50%, 75%, 100% { color: var(--color-text-muted); }
    51%, 74% { color: #171714; }
  }

  @keyframes ci-rail-check {
    0%, 74% { color: var(--color-text-muted); }
    75%, 100% { color: #171714; }
  }

  @keyframes ci-rail-github-icon {
    0%, 23% { color: var(--cloud-accent); }
    24%, 100% { color: var(--color-text-muted); }
  }

  @keyframes ci-rail-vercel-icon {
    0%, 23%, 51%, 100% { color: var(--color-text-muted); }
    24%, 50% { color: #171714; }
  }

  @keyframes ci-rail-kery-icon {
    0%, 50%, 75%, 100% { color: var(--color-text-muted); }
    51%, 74% { color: var(--cloud-accent); }
  }

  @keyframes ci-rail-check-icon {
    0%, 74% { color: var(--color-text-muted); }
    75%, 100% { color: var(--cloud-accent); }
  }

  @keyframes ci-pr-active {
    0%, 22% { opacity: 1; transform: translate(-50%, -50%); }
    26%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-0.5rem); }
  }

  @keyframes ci-preview-active {
    0%, 22% { opacity: 0; transform: translate(-50%, -50%) translateY(0.65rem); }
    26%, 50% { opacity: 1; transform: translate(-50%, -50%); }
    54%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-0.5rem); }
  }

  @keyframes ci-run-active {
    0%, 50% { opacity: 0; transform: translate(-50%, -50%) translateY(0.65rem); }
    54%, 73% { opacity: 1; transform: translate(-50%, -50%); }
    77%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-0.5rem); }
  }

  @keyframes ci-result-active {
    0%, 73% { opacity: 0; transform: translate(-50%, -50%) translateY(0.65rem); }
    77%, 100% { opacity: 1; transform: translate(-50%, -50%); }
  }

  @keyframes vercel-deploy-spinner {
    0%, 23% { opacity: 0; transform: rotate(0deg); border-color: rgba(23, 23, 20, 0.22); border-top-color: #171714; }
    24%, 38% { opacity: 1; transform: rotate(360deg); border-color: rgba(23, 23, 20, 0.22); border-top-color: #171714; }
    39%, 100% { opacity: 1; transform: rotate(360deg); border-color: var(--cloud-accent-bright); border-top-color: var(--cloud-accent-bright); }
  }

  @keyframes vercel-deploy-check {
    0%, 38% { opacity: 0; transform: rotate(45deg) scale(0.82); }
    39%, 100% { opacity: 1; transform: rotate(45deg) scale(1); }
  }

  @keyframes vercel-deploying-label {
    0%, 23%, 39%, 100% { opacity: 0; }
    24%, 38% { opacity: 1; }
  }

  @keyframes vercel-deployed-label {
    0%, 38% { opacity: 0; }
    39%, 100% { opacity: 1; }
  }

  @keyframes vercel-url-reveal {
    0%, 38% { opacity: 0; }
    39%, 100% { opacity: 1; }
  }

  @keyframes ci-flow-check {
    0%, 51% {
      border-color: rgba(67, 118, 72, 0.18);
      background: rgba(67, 118, 72, 0.1);
      color: transparent;
      transform: scale(0.92);
    }
    60%, 100% {
      border-color: var(--cloud-accent-bright);
      background: var(--cloud-accent);
      color: #fffdf6;
      transform: scale(1);
    }
  }

  @keyframes ci-flow-alert {
    0%, 51% {
      border-color: rgba(212, 128, 38, 0.18);
      background: rgba(212, 128, 38, 0.1);
      color: transparent;
      transform: scale(0.92);
    }
    60%, 100% {
      border-color: color-mix(in srgb, var(--cloud-warning) 76%, #171714);
      background: var(--cloud-warning);
      color: #171714;
      transform: scale(1);
    }
  }

  @keyframes ci-issue-count {
    0%, 58% { opacity: 0; transform: translateY(0.2rem); }
    60%, 100% { opacity: 1; transform: translateY(0); }
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .steps-grid article {
    min-height: 17rem;
  }

  .steps-grid article > span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .how-video {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .how-video-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: #171714;
    box-shadow: 0 20px 50px rgba(38, 33, 21, 0.14);
    aspect-ratio: 2004 / 1080;
  }

  .how-video video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.006);
    transform-origin: center;
  }

  .how-video-frame::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 34%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.56));
  }

  .how-video-overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(3.2rem, 7vw, 5rem);
    height: clamp(3.2rem, 7vw, 5rem);
    border: 1px solid rgba(255, 248, 232, 0.28);
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.92);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
    color: #171714;
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: opacity 160ms ease, transform 160ms ease, background 160ms ease;
  }

  .how-video-overlay:hover {
    background: #ffcf49;
    transform: translate(-50%, -50%) scale(1.04);
  }

  .how-video-overlay svg {
    width: 38%;
    height: 38%;
    margin-left: 0.18rem;
    fill: currentColor;
  }

  .how-video.is-playing .how-video-overlay {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.92);
  }

  .how-video-controls {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 0.55rem;
    align-items: center;
    min-height: 2.7rem;
    padding: 0.44rem;
    border: 1px solid rgba(255, 248, 232, 0.16);
    border-radius: 9px;
    background: rgba(18, 18, 15, 0.76);
    box-shadow: inset 0 1px 0 rgba(255, 248, 232, 0.08);
    backdrop-filter: blur(14px);
  }

  .how-video-button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(255, 248, 232, 0.16);
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.08);
    color: #fff8e8;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .how-video-button:hover {
    border-color: rgba(255, 207, 73, 0.48);
    background: #ffcf49;
    color: #171714;
  }

  .how-video-button svg {
    width: 1rem;
    height: 1rem;
  }

  .how-video-button svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .how-video-button .video-icon-play path,
  .how-video-button .video-icon-pause path {
    fill: currentColor;
    stroke: none;
  }

  .video-icon-pause {
    display: none;
  }

  .how-video.is-playing .video-icon-play {
    display: none;
  }

  .how-video.is-playing .video-icon-pause {
    display: block;
  }

  .how-video-seek {
    width: 100%;
    min-width: 0;
    height: 0.36rem;
    background: transparent;
    accent-color: #ffcf49;
    appearance: none;
    cursor: pointer;
  }

  .how-video-seek::-webkit-slider-runnable-track {
    height: 0.36rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #ffcf49 var(--video-progress, 0%), rgba(255, 248, 232, 0.22) var(--video-progress, 0%));
  }

  .how-video-seek::-webkit-slider-thumb {
    width: 0.9rem;
    height: 0.9rem;
    margin-top: -0.27rem;
    border: 2px solid #171714;
    border-radius: 999px;
    background: #ffcf49;
    appearance: none;
  }

  .how-video-seek::-moz-range-track {
    height: 0.36rem;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.22);
  }

  .how-video-seek::-moz-range-progress {
    height: 0.36rem;
    border-radius: 999px;
    background: #ffcf49;
  }

  .how-video-time {
    min-width: 3.8rem;
    color: rgba(255, 248, 232, 0.78);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    text-align: center;
  }

  .faq-section {
    background: var(--color-bg);
  }

  .faq-grid {
    align-items: start;
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-list details {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-list summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    color: var(--color-ink);
    cursor: pointer;
    font-weight: 800;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    content: "+";
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
  }

  .faq-list details[open] summary::after {
    content: "-";
  }

  .faq-list p {
    max-width: 44rem;
    padding: 0 2rem 1.15rem 0;
    color: var(--color-text-secondary);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .community-section {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255, 248, 232, 0.12);
    border-bottom: 1px solid rgba(255, 248, 232, 0.12);
    background:
      linear-gradient(135deg, rgba(255, 207, 73, 0.18), transparent 38%),
      linear-gradient(180deg, #171714 0%, #24231f 100%);
    color: #fff8e8;
  }

  .community-inner {
    display: flex;
