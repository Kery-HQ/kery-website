---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_DISCORD_URL, SITE_GITHUB_URL } from '../constants';

const painPoints = [
  ['AI increases release velocity', 'Small teams can now create more product surface than they can manually verify.'],
  ['QA becomes the bottleneck', 'Every AI-generated change still needs login setup, clicking, edge-case checks, and release judgment.'],
  ['Bugs need real evidence', 'A vague AI summary is not enough. Engineers need screenshots, logs, URLs, regions, and repro steps.'],
];

const steps = [
  ['1', 'Point Kery at your app', 'Add a URL, environment, credentials, and the flow you care about.'],
  ['2', 'It explores in a real browser', 'Kery crawls routes, plans steps, logs in, clicks through flows, and observes screenshots plus accessibility state.'],
  ['3', 'It returns triaged issues', 'Visual, functional, and UX bugs come back with severity, screenshots, bounding boxes, logs, and repro context.'],
];

const artifacts = [
  ['Screenshot', 'Highlighted region showing the broken UI state.'],
  ['Trace', 'Route, viewport, action sequence, and browser observations.'],
  ['Triage', 'Category, severity, confidence, and review status.'],
  ['Memory', 'Known paths, false positives, and product-specific notes reused later.'],
];

const capabilities = [
  ['Plain-English checks', 'Describe the outcome you expect. Kery turns intent into browser behavior.'],
  ['Authenticated flows', 'Form login, Clerk, Supabase, OAuth, API tokens, and TOTP-backed accounts.'],
  ['MCP from your IDE', 'Run scans, start tests, inspect bugs, and update triage from coding agents.'],
  ['CI and preview runs', 'Cloud connects GitHub and Vercel so preview deployments get checked before merge.'],
];

const agentTools = [
  ['Claude Code', '/icons/claude.svg'],
  ['Codex', '/icons/codex.svg'],
  ['Cursor', '/icons/cursor.svg'],
  ['Any MCP client', '/icons/mcp.svg'],
];

const installFeatures = [
  'Open-source engine you can inspect, run, and extend locally.',
  'Runs locally with Docker.',
  'Installs MCP into Cursor, Claude Code, and Codex CLI.',
  'Point Kery at your app running locally and start testing it.',
  'Supports the following providers.',
];

const supportedProviders = [
  ['OpenAI', '/icons/openai.svg'],
  ['Anthropic', '/icons/claude-color.svg'],
  ['Google Gemini', '/icons/gemini-color.svg'],
  ['OpenRouter', '/icons/openrouter.svg'],
];

const cloudFeatures = [
  ['Preview PR checks', 'Connect GitHub and Vercel so every preview deployment can get a Kery browser run before merge.'],
  ['Managed workers', 'Run isolated browser agents without operating Playwright infrastructure, Redis, storage, or model routing.'],
  ['Team triage', 'Share screenshots, run traces, issue status, severity, comments, and review decisions across the team.'],
  ['Scheduled coverage', 'Run recurring checks for critical flows and surface stale or untested areas before customers do.'],
];

const faqs = [
  ['What is Kery?', 'Kery is an AI browser testing engine. It crawls web apps, runs intent-driven tests in Playwright, and reports visual, functional, and UX bugs with reproducible evidence.'],
  ['Do I need to write test scripts?', 'No. You can start with a URL and plain-English intent. Useful flows can later be saved and rerun.'],
  ['Is this only for simple public sites?', 'No. Kery supports logged-in products through configured environments and credentials.'],
  ['Why have OSS and Cloud?', 'OSS gives developers the engine and local control. Cloud adds managed execution, team workflows, CI checks, storage, and tenancy.'],
];
---

<Layout
  title="Kery - AI QA agents for web apps"
  description="Kery runs AI agents through real browser flows and returns reproducible visual, functional, and UX bugs with screenshots, logs, and repro steps."
>
  <Navbar />
  <main class="site-main">
    <section class="hero-section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Browser QA for teams shipping with AI</span>
          <h1>AI builds fast. Kery tests at that speed.</h1>
          <p>
            Kery runs autonomous browser QA for teams shipping with AI: real flows, real evidence, reproducible bugs.
          </p>
          <div class="hero-actions">
            <a href="#install" class="button button-primary">Install locally</a>
            <a href="#cloud" class="button button-secondary">Join Cloud waitlist</a>
          </div>
        </div>

        <div class="agent-animation" aria-label="Animated Kery agent opening a cart and testing a checkout page">
          <div class="pixel-topbar">
            <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <strong>kery run / checkout</strong>
          </div>

          <div class="pixel-stage">
            <div class="checkout-screen">
              <div class="browser-bar">
                <span class="browser-url">
                  <span class="browser-url-home">yourapp.example.com</span>
                  <span class="browser-url-cart">yourapp.example.com/cart</span>
                </span>
                <span class="run-state browser-run-state"><i></i> live browser</span>
              </div>
              <div class="browser-viewport">
                <section class="storefront-page" aria-hidden="true">
                  <div class="storefront-copy">
                    <h2>Your Shopping App</h2>
                    <div class="storefront-actions">
                      <button type="button" class="browse-button">Browse products</button>
                      <button type="button" class="view-cart-button">View cart</button>
                      <span class="click-burst burst-cart" aria-hidden="true"></span>
                    </div>
                  </div>
                </section>

                <div class="checkout-page">
                  <section class="cart-panel">
                    <div class="pixel-label">Cart</div>
                    <div class="cart-row row-one">
                      <span class="item-sprite mango-sprite"></span>
                      <div>
                        <strong>Mango Hoodie</strong>
                        <small>$42.00</small>
                      </div>
                      <button type="button" class="remove-one">Remove</button>
                      <span class="click-burst burst-one" aria-hidden="true"></span>
                    </div>
                    <div class="cart-row row-two">
                      <span class="item-sprite leaf-sprite"></span>
                      <div>
                        <strong>Agent Sticker Pack</strong>
                        <small>$8.00</small>
                      </div>
                      <button type="button" class="remove-two">Remove</button>
                      <span class="click-burst burst-two" aria-hidden="true"></span>
                    </div>
                    <div class="cart-row row-three">
                      <span class="item-sprite box-sprite"></span>
                      <div>
                        <strong>Debug Tote</strong>
                        <small>$18.00</small>
                      </div>
                      <button type="button" class="remove-three">Remove</button>
                      <span class="click-burst burst-three" aria-hidden="true"></span>
                    </div>
                  </section>

                  <aside class="summary-panel">
                    <div class="pixel-label">Summary</div>
                    <div><span>Subtotal</span><strong>$68.00</strong></div>
                    <div><span>Shipping</span><strong>$0.00</strong></div>
                    <div class="total"><span>Total</span><strong>$68.00</strong></div>
                    <button type="button" class="checkout-button">Checkout</button>
                    <span class="click-burst burst-four" aria-hidden="true"></span>
                  </aside>
                </div>
              </div>
            </div>

            <div class="kery-cursor" aria-hidden="true">
              <span>Kery</span>
            </div>

            <div class="bug-popup popup-one" aria-hidden="true">
              <strong>BUG DETECTED</strong>
            </div>
            <div class="bug-popup popup-two" aria-hidden="true">
              <strong>BUG DETECTED</strong>
            </div>
            <div class="bug-popup popup-three" aria-hidden="true">
              <strong>BUG DETECTED</strong>
            </div>
            <div class="bug-popup popup-four" aria-hidden="true">
              <strong>CHECKOUT STUCK</strong>
            </div>
            <div class="bug-summary-banner" aria-hidden="true">
              <strong>4 bugs detected</strong>
              <span>evidence saved to triage</span>
            </div>
          </div>

          <div class="bug-ledger">
            <span>Collected bugs</span>
            <ol>
              <li>#001</li>
              <li>#002</li>
              <li>#003</li>
              <li>#004</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="agent-strip" aria-label="Coding agent integrations">
      <div class="container">
        <p>Works with the tools your team already uses to build</p>
        <div>
          {agentTools.map(([label, icon]) => (
            <span>
              <img src={icon} alt="" width="18" height="18" loading="lazy" />
              {label}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="section install-section" id="install">
      <div class="container install-grid">
        <div class="section-copy">
          <span class="section-kicker">Run Kery locally</span>
          <h2>One command starts the open-source browser testing stack.</h2>
          <ul class="install-feature-list">
            {installFeatures.map((feature) => (
              <li>
                <span aria-hidden="true"></span>
                {feature}
              </li>
            ))}
          </ul>
          <div class="provider-strip" aria-label="Supported LLM providers">
            {supportedProviders.map(([label, icon]) => (
              <span>
                <img src={icon} alt="" width="18" height="18" loading="lazy" />
                {label}
              </span>
            ))}
          </div>
          <div class="install-actions">
            <a href={SITE_GITHUB_URL} class="button button-secondary" target="_blank" rel="noopener noreferrer">View GitHub README</a>
            <a href="#demo" class="button button-ghost">See how it works</a>
          </div>
        </div>
        <div class="install-card" aria-label="Animated Kery local setup flow">
          <div class="terminal-top">
            <span></span><span></span><span></span>
            <strong>kery setup</strong>
          </div>
          <div class="setup-story">
            <div class="story-stage">
              <section class="story-scene scene-command" aria-hidden="true">
                <div class="story-command">
                  <span>$</span>
                  <strong>npx keryai</strong>
                  <i></i>
                </div>
              </section>

              <section class="story-scene scene-provider" aria-hidden="true">
                <div class="provider-card">
                  <div class="story-question">Which LLM provider?</div>
                  <div class="provider-options">
                    <span class="provider-option provider-openai"><img src="/icons/openai.svg" alt="" width="18" height="18" loading="lazy" /><strong>OpenAI</strong></span>
                    <span class="provider-option provider-openrouter"><img src="/icons/openrouter.svg" alt="" width="18" height="18" loading="lazy" /><strong>OpenRouter</strong></span>
                    <span class="provider-option provider-anthropic"><img src="/icons/claude-color.svg" alt="" width="18" height="18" loading="lazy" /><strong>Anthropic</strong><em>selected</em></span>
                    <span class="provider-option provider-gemini"><img src="/icons/gemini-color.svg" alt="" width="18" height="18" loading="lazy" /><strong>Google Gemini</strong></span>
                  </div>
                  <div class="api-key-row">
                    <span>ANTHROPIC_API_KEY</span>
                    <code><b class="api-key-typed">sk-ant-••••••••</b><i class="api-key-caret"></i></code>
                  </div>
                  <b class="selection-cursor">select</b>
                </div>
              </section>

              <section class="story-scene scene-mcp" aria-hidden="true">
                <div class="mcp-card">
                  <div class="mcp-toggle">
                    <strong>Install Kery MCP</strong>
                    <span><i></i></span>
                  </div>
                  <div class="ide-grid">
                    <div><img src="/icons/cursor.svg" alt="" width="18" height="18" loading="lazy" />Cursor <span>✓</span></div>
                    <div><img src="/icons/claude.svg" alt="" width="18" height="18" loading="lazy" />Claude Code <span>✓</span></div>
                    <div><img src="/icons/codex.svg" alt="" width="18" height="18" loading="lazy" />Codex CLI <span>✓</span></div>
                  </div>
                </div>
              </section>

              <section class="story-scene scene-boot" aria-hidden="true">
                <div class="boot-card">
                  <div class="service-list">
                    <span>api <i></i></span>
                    <span>dashboard <i></i></span>
                    <span>worker <i></i></span>
                    <span>postgres <i></i></span>
                    <span>redis <i></i></span>
                  </div>
                  <div class="dashboard-ready">
                    <span>✓</span>
                    <div>
                      <strong>Dashboard ready</strong>
                      <code>http://localhost:11111</code>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <div class="story-rail" aria-hidden="true">
              <span>Command</span>
              <span>Provider</span>
              <span>MCP</span>
              <span>Dashboard</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section cloud-section" id="cloud">
      <div class="container cloud-grid">
        <div class="section-copy">
          <span class="section-kicker">Kery Cloud</span>
          <h2>Managed QA for teams that want every PR tested.</h2>
          <p>
            Cloud is the hosted control plane around Kery: isolated browser workers, team triage, durable artifacts, scheduled coverage, and CI integrations that test preview deployments before code merges.
          </p>
          <div class="cloud-feature-grid">
            {cloudFeatures.map(([title, copy]) => (
              <article>
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))}
          </div>
        </div>
        <form class="cloud-form" id="waitlist-form" novalidate>
          <span class="form-eyebrow">Early access</span>
          <h3>Join the Cloud waitlist</h3>
          <p>Get updates when hosted runs, PR checks, scheduled coverage, and team review are ready.</p>
          <label for="waitlist-email">Work email</label>
          <div>
            <input id="waitlist-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
            <button class="button button-primary" id="waitlist-button" type="submit">Join waitlist</button>
          </div>
          <p id="waitlist-status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="section problem-section">
      <div class="container two-col">
        <div class="section-copy">
          <span class="section-kicker">Why this matters</span>
          <h2>AI changed how fast teams build. It did not remove the need to test.</h2>
          <p>When Claude Code, Codex, Cursor, and other agents help create more changes, QA has to become part of the same agentic workflow. Kery handles the browser work that teams do not have time to repeat by hand.</p>
        </div>
        <div class="pain-grid">
          {painPoints.map(([title, copy]) => (
            <article>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section how-section" id="product">
      <div class="container section-heading center">
        <span class="section-kicker">How Kery works</span>
        <h2>Give it a product flow. Get back a reproducible bug report.</h2>
      </div>
      <div class="container steps-grid">
        {steps.map(([number, title, copy]) => (
          <article>
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section demo-section" id="demo">
      <div class="container demo-grid">
        <div class="demo-media">
          <video src="/kery-demo.mp4" poster="/kery-demo-thumb.jpg" muted loop playsinline controls preload="metadata"></video>
        </div>
        <div class="section-copy">
          <span class="section-kicker">The output</span>
          <h2>Evidence your engineers can act on.</h2>
          <p>Kery does not stop at "something looks wrong." It preserves the browser state and the reasoning needed for a developer or coding agent to reproduce the issue.</p>
          <div class="artifact-list">
            {artifacts.map(([title, copy]) => (
              <div>
                <strong>{title}</strong>
                <span>{copy}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section capability-section">
      <div class="container section-heading">
        <span class="section-kicker">Why teams use it</span>
        <h2>A QA loop built for product teams and coding agents.</h2>
      </div>
      <div class="container capability-grid">
        {capabilities.map(([title, copy]) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-grid">
        <div class="section-copy">
          <span class="section-kicker">FAQ</span>
          <h2>What teams usually ask first.</h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="container final-cta-inner">
        <div>
          <span class="section-kicker">Get started</span>
          <h2>Put an AI tester inside your release loop.</h2>
        </div>
        <div class="final-actions">
          <a href="#install" class="button button-primary">Install locally</a>
          <a href={SITE_GITHUB_URL} class="button button-secondary" target="_blank" rel="noopener noreferrer">Star on GitHub</a>
          <a href={SITE_DISCORD_URL} class="button button-ghost" target="_blank" rel="noopener noreferrer">Join Discord</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .site-main {
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 8%, rgba(255, 207, 73, 0.18), transparent 24rem),
      linear-gradient(180deg, #fffdf6 0%, var(--color-bg) 34rem);
  }

  .hero-section {
    padding: clamp(8rem, 13vw, 11rem) 0 clamp(4.5rem, 8vw, 7rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(520px, 1.12fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
  }

  .hero-copy {
    max-width: 43rem;
  }

  .eyebrow,
  .section-kicker,
  .form-eyebrow {
    display: inline-flex;
    width: fit-content;
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .eyebrow {
    padding: 0.42rem 0.68rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(255, 253, 246, 0.82);
  }

  .hero-copy h1 {
    max-width: 10ch;
    margin: 1.15rem 0 1.15rem;
    color: var(--color-ink);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 850;
    letter-spacing: -0.052em;
    line-height: 0.88;
  }

  .hero-copy p,
  .section-copy p,
  .section-heading p,
  .cloud-form p {
    color: var(--color-text-secondary);
    font-size: clamp(1.02rem, 1.25vw, 1.16rem);
    line-height: 1.72;
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.65rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.72rem 1rem;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 760;
    line-height: 1;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fffdf6;
  }

  .button-primary:hover {
    background: #000;
  }

  .button-secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-ink);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
  }

  .button-ghost {
    background: transparent;
    color: var(--color-text-secondary);
  }

  .button-ghost:hover {
    background: var(--color-bg-alt);
    color: var(--color-ink);
  }

  .agent-animation {
    --loop: 29s;
    overflow: hidden;
    border: 1px solid rgba(38, 33, 21, 0.2);
    border-radius: 16px;
    background: #171714;
    box-shadow:
      0 26px 70px rgba(38, 33, 21, 0.16),
      0 0 0 8px rgba(255, 253, 246, 0.62);
    image-rendering: pixelated;
  }

  .pixel-topbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.82rem 0.95rem;
    border-bottom: 1px solid rgba(255, 248, 232, 0.1);
    color: rgba(255, 248, 232, 0.62);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .window-dots {
    display: flex;
    gap: 0.35rem;
  }

  .window-dots span {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: #ff695f;
  }

  .window-dots span:nth-child(2) {
    background: #ffcf49;
  }

  .window-dots span:nth-child(3) {
    background: #63c174;
  }

  .run-state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: #8bdba0;
  }

  .run-state i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
    animation: pixel-blink 1s steps(2, end) infinite;
  }

  .pixel-stage {
    position: relative;
    min-height: 31.5rem;
    overflow: hidden;
    padding: 1rem;
    background:
      linear-gradient(90deg, rgba(255, 248, 232, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(255, 248, 232, 0.04) 1px, transparent 1px),
      radial-gradient(circle at 82% 10%, rgba(255, 207, 73, 0.13), transparent 16rem),
      #222018;
    background-size: 18px 18px, 18px 18px, auto, auto;
  }

  .checkout-screen {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 3px solid #171714;
    border-radius: 10px;
    background: #fff8e8;
    box-shadow: 0 8px 0 rgba(0, 0, 0, 0.26);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 3px solid #171714;
    background: #f1ead9;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .browser-url,
  .browser-run-state {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-run-state {
    flex: 0 0 auto;
    margin-left: 0;
    color: #4f9d64;
  }

  .browser-url {
    position: relative;
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0.9rem;
  }

  .browser-url-home,
  .browser-url-cart {
    animation-duration: var(--loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .browser-url-home {
    animation-name: browser-url-home;
  }

  .browser-url-cart {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    animation-name: browser-url-cart;
  }

  .browser-viewport {
    position: relative;
  }

  .storefront-page {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    padding: 0.9rem;
    background: #fff8e8;
    opacity: 1;
    animation: storefront-page var(--loop) linear infinite;
  }

