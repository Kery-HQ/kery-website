  .ci-rail span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    gap: 0.32rem;
    min-height: 2rem;
    padding: 0.42rem 0.3rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 6px;
    color: rgba(255, 248, 232, 0.5);
    font-size: 0.66rem;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
    background: rgba(255, 248, 232, 0.04);
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .ci-rail span:nth-child(1) { animation-name: ci-rail-github; }
  .ci-rail span:nth-child(2) { animation-name: ci-rail-vercel; }
  .ci-rail span:nth-child(3) { animation-name: ci-rail-kery; }
  .ci-rail span:nth-child(4) { animation-name: ci-rail-check; }

  .ci-svg {
    display: block;
    flex: 0 0 auto;
    width: 0.9rem;
    height: 0.9rem;
    color: rgba(255, 248, 232, 0.5);
  }

  .ci-svg path {
    fill: currentColor;
  }

  .ci-pr-svg path,
  .ci-pr-svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ci-rail span .ci-svg {
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .ci-rail span:nth-child(1) .ci-svg { animation-name: ci-rail-github-icon; }
  .ci-rail span:nth-child(2) .ci-svg { animation-name: ci-rail-vercel-icon; }
  .ci-rail span:nth-child(3) .ci-svg { animation-name: ci-rail-kery-icon; }
  .ci-rail span:nth-child(4) .ci-svg { animation-name: ci-rail-check-icon; }

  .ci-pr-svg,
  .ci-comment-svg {
    color: var(--cloud-accent);
  }

  .ci-vercel-svg {
    color: #fff8e8;
  }

  .ci-kery-logo {
    display: block;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    background: #fff8e8;
    -webkit-mask: url('/kery.png') center / contain no-repeat;
    mask: url('/kery.png') center / contain no-repeat;
  }

  .ci-flow {
    position: relative;
    min-height: 26rem;
    overflow: hidden;
    border: 1px solid rgba(255, 248, 232, 0.12);
    border-radius: 10px;
    background: #12120f;
  }

  .ci-platform-card {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    gap: 0.62rem;
    width: min(100% - 2rem, 27rem);
    padding: 1.15rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 10px;
    background: #1d1b16;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.32);
    opacity: 0;
    transform: translate(-50%, -50%) translateY(0.65rem);
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease;
  }

  .ci-github-card { animation-name: ci-pr-active; }
  .ci-vercel-card { animation-name: ci-preview-active; }
  .ci-run-panel { animation-name: ci-run-active; }
  .ci-result { animation-name: ci-result-active; }

  .ci-platform-head,
  .ci-run-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .ci-platform-head,
  .ci-run-header {
    padding-bottom: 0.52rem;
    border-bottom: 1px solid rgba(255, 248, 232, 0.12);
  }

  .ci-platform-head b,
  .ci-run-header strong {
    color: #fff8e8;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  .ci-platform-head span,
  .ci-run-header span {
    color: rgba(255, 248, 232, 0.55);
    font-size: 0.68rem;
    font-weight: 800;
  }

