---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import DemoVideo from '../components/DemoVideo.astro';
import GetRunning from '../components/GetRunning.astro';
import Problems from '../components/Problems.astro';
import Agents from '../components/Agents.astro';
import BugTypes from '../components/BugTypes.astro';
import FeatureDeepDives from '../components/FeatureDeepDives.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import DiscordSection from '../components/DiscordSection.astro';
import HostedWaitlist from '../components/HostedWaitlist.astro';
import Footer from '../components/Footer.astro';
import { COMING_SOON } from '../constants';
---

<Layout
  title="Kery - Ship fast. Break nothing."
  description="Open-source testing engine for real browser runs, bug detection, and self-healing Playwright replay. Apache 2.0, self-hosted, bring your own LLM."
>
  <Navbar />
  <main>
    <Hero />
    {!COMING_SOON && (
      <>
        <DemoVideo />
        <GetRunning />
        <HostedWaitlist />
        <Problems />
        <Agents />
        <BugTypes />
        <FeatureDeepDives />
        <FAQ />
        <DiscordSection />
        <CTA />
      </>
    )}
  </main>
  {!COMING_SOON && <Footer />}
</Layout>
