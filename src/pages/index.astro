  .kery-cursor::before,
  .kery-cursor::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 1.55rem;
    height: 1.55rem;
    clip-path: polygon(0 0, 0 100%, 35% 74%, 53% 100%, 76% 88%, 58% 62%, 100% 62%);
    transform: scaleX(0.95);
    transform-origin: left top;
