---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/sections/SiteHeader';
import SiteFooter from '@/components/sections/SiteFooter';
import Hero from '@/components/sections/Hero';
import Levers from '@/components/sections/Levers';
import Process from '@/components/sections/Process';
import Booking from '@/components/sections/Booking';
import SavingsCalculator from '@/components/SavingsCalculator';
import { CONTACT_EMAIL, SITE_NAME, SITE_ORIGIN, seo } from '@/config/site';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_ORIGIN,
    email: CONTACT_EMAIL,
    description: seo.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_ORIGIN,
  },
];
---

<Layout structuredData={structuredData}>
  <SiteHeader />
  <main>
    <Hero />
    <section id="savings" class="relative z-10 mx-auto -mt-28 max-w-5xl scroll-mt-4 px-4 sm:-mt-36">
      <SavingsCalculator client:load />
    </section>
    <Levers />
    <Process />
    <Booking />
  </main>
  <SiteFooter />
</Layout>
