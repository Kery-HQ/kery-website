  .vercel-preview-ui {
    display: grid;
    gap: 0.5rem;
  }

  .github-pr-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
  }

  .github-pr-main > .ci-svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .github-pr-main > div {
    display: grid;
    min-width: 0;
    gap: 0.08rem;
  }

  .github-pr-main strong,
  .vercel-status strong,
  .kery-run-focus strong {
    overflow: hidden;
    color: #fff8e8;
    font: inherit;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .github-pr-main span,
  .github-pr-ui p,
  .vercel-status span,
  .vercel-deploy-meta span {
    color: rgba(255, 248, 232, 0.62);
    font-size: 0.7rem;
  }

  .github-pr-main em {
    color: var(--cloud-accent-bright);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 900;
    text-transform: uppercase;
  }

  .github-change-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .github-change-row span {
    padding: 0.18rem 0.38rem;
    border: 1px solid rgba(255, 248, 232, 0.16);
    border-radius: 4px;
    background: rgba(255, 248, 232, 0.05);
    color: rgba(255, 248, 232, 0.66);
    font-size: 0.64rem;
    font-weight: 800;
  }

  .vercel-status {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .vercel-status > div {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
  }

  .vercel-status-icon {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    border: 2px solid rgba(255, 248, 232, 0.22);
    border-top-color: #fff8e8;
    border-radius: 999px;
    animation: vercel-deploy-spinner var(--ci-loop) linear infinite;
  }

  .vercel-status-icon::after {
    content: "";
    position: absolute;
    left: 0.32rem;
    top: 0.18rem;
    width: 0.24rem;
    height: 0.46rem;
    border-right: 2px solid var(--cloud-accent-bright);
    border-bottom: 2px solid var(--cloud-accent-bright);
    opacity: 0;
    transform: rotate(45deg) scale(0.82);
    transform-origin: center;
    animation: vercel-deploy-check var(--ci-loop) steps(1, end) infinite;
  }

  .vercel-status strong {
    position: relative;
    display: block;
    min-height: 1rem;
    min-width: 9.6rem;
  }

  .vercel-deploying,
  .vercel-deployed {
    position: absolute;
    inset: 0 auto auto 0;
    animation-duration: var(--ci-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .vercel-deploying {
    animation-name: vercel-deploying-label;
  }

  .vercel-deployed {
    opacity: 0;
    animation-name: vercel-deployed-label;
  }

  .vercel-url-card {
    display: grid;
    gap: 0.18rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.04);
  }

  .vercel-url-card span {
    color: rgba(255, 248, 232, 0.5);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .vercel-url-card code {
    overflow: hidden;
    color: var(--cloud-accent-bright);
    font: inherit;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    animation: vercel-url-reveal var(--ci-loop) steps(1, end) infinite;
  }

  .vercel-deploy-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
  }

  .kery-run-focus {
    display: grid;
    gap: 0.22rem;
    padding: 0.56rem 0.6rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.04);
  }

  .kery-run-focus > span {
    color: rgba(255, 248, 232, 0.5);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .kery-run-focus strong {
    font-size: 0.76rem;
    white-space: normal;
  }

  .kery-run-focus code {
    color: var(--cloud-accent-bright);
    font: inherit;
    font-weight: 900;
  }

  .ci-run-panel ol {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.38rem;
    margin: 0;
  }

  .ci-run-panel li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.46rem 0.5rem;
    border: 1px solid rgba(255, 248, 232, 0.12);
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.04);
    color: rgba(255, 248, 232, 0.72);
  }

  .ci-run-panel li span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ci-run-panel li i {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.16rem;
    height: 1.16rem;
    border: 1px solid rgba(67, 118, 72, 0.18);
    border-radius: 999px;
    background: rgba(67, 118, 72, 0.1);
    color: transparent;
    font-size: 0.76rem;
    font-style: normal;
    font-weight: 900;
    line-height: 1;
    animation: ci-flow-check var(--ci-loop) steps(1, end) infinite;
  }

  .ci-run-panel li i.ci-alert {
    animation-name: ci-flow-alert;
  }

  .ci-run-panel li i.ci-skip {
    animation-name: ci-flow-skip;
  }

  .ci-run-panel li b {
    margin-left: auto;
    color: #ffcf49;
    font-size: 0.62rem;
    text-transform: uppercase;
    opacity: 0;
    animation: ci-issue-count var(--ci-loop) steps(1, end) infinite;
  }

  .ci-run-panel li:nth-child(2) i { animation-delay: 0.45s; }
  .ci-run-panel li:nth-child(3) i { animation-delay: 0.9s; }
  .ci-run-panel li:nth-child(3) b { animation-delay: 0.9s; }
  .ci-run-panel li:nth-child(4) i { animation-delay: 1.35s; }
  .ci-run-panel li:nth-child(4) b { animation-delay: 1.35s; }

  .ci-run-panel li b.ci-skip-label {
    color: rgba(255, 248, 232, 0.45);
  }

  .ci-video-chip {
    border-color: rgba(139, 219, 160, 0.45) !important;
    background: rgba(139, 219, 160, 0.1) !important;
    color: var(--cloud-accent-bright) !important;
    font-weight: 900 !important;
  }

  .github-timeline-ui {
    display: grid;
    gap: 0.55rem;
  }

  .github-timeline-updates {
    display: grid;
    gap: 0.4rem;
    padding-left: 0.53rem;
    border-left: 2px solid rgba(255, 248, 232, 0.16);
  }

  .github-timeline-updates div {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.42rem;
    color: rgba(255, 248, 232, 0.62);
    font-size: 0.7rem;
  }

  .github-timeline-updates i {
    position: absolute;
    left: -0.72rem;
    width: 0.38rem;
    height: 0.38rem;
    border: 2px solid #1d1b16;
    border-radius: 999px;
    background: var(--cloud-accent-bright);
  }

  .github-timeline-updates strong {
    color: #fff8e8;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .cloud-feature-list {
    display: grid;
    gap: 0.72rem;
    margin-top: 1.2rem;
  }

  .cloud-feature-list li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.68rem;
    align-items: start;
    color: rgba(255, 248, 232, 0.72);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.62;
  }

  .cloud-feature-list li > span {
    width: 0.58rem;
    height: 0.58rem;
    margin-top: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 68%, var(--color-border));
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 3px 3px 0 rgba(67, 118, 72, 0.16);
  }

  .cloud-connect {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    overflow: hidden;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    width: 100%;
    border: 1px solid rgba(255, 248, 232, 0.13);
    border-radius: 14px;
    background: #12120f;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 248, 232, 0.08);
  }

  .cloud-connect::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 84% 18%, rgba(255, 207, 73, 0.13), transparent 14rem),
      linear-gradient(180deg, rgba(255, 248, 232, 0.045), transparent 56%);
  }

  .cloud-connect > * {
    position: relative;
    z-index: 1;
  }

  .cloud-connect h3 {
    color: #fff8e8;
    font-size: clamp(1.45rem, 2.4vw, 2.15rem);
    line-height: 1.1;
  }

  .cloud-connect p {
    color: rgba(255, 248, 232, 0.68);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .cloud-connect-copy {
    display: grid;
    gap: 0.5rem;
  }

  .cloud-connect-action {
    display: grid;
  }

  .cloud-connect .button {
    width: auto;
    min-height: 2.95rem;
    border: 2px solid #ffcf49;
    border-radius: 4px;
    background: #ffcf49;
    box-shadow: 0 3px 0 #171714;
    color: #171714;
    white-space: nowrap;
  }

  .cloud-connect .button:hover {
    background: #ffd970;
    border-color: #ffd970;
  }

  @keyframes ci-rail-github {
    0%, 23% { color: #fff8e8; }
    24%, 100% { color: rgba(255, 248, 232, 0.5); }
  }

  @keyframes ci-progress-fill {
    0% { transform: scaleX(0.08); }
    24% { transform: scaleX(0.3); }
    51% { transform: scaleX(0.58); }
    75% { transform: scaleX(0.84); }
    100% { transform: scaleX(1); }
  }

  @keyframes ci-rail-vercel {
    0%, 23%, 51%, 100% { color: rgba(255, 248, 232, 0.5); }
    24%, 50% { color: #fff8e8; }
  }

  @keyframes ci-rail-kery {
    0%, 50%, 75%, 100% { color: rgba(255, 248, 232, 0.5); }
    51%, 74% { color: #fff8e8; }
  }

  @keyframes ci-rail-check {
    0%, 74% { color: rgba(255, 248, 232, 0.5); }
    75%, 100% { color: #fff8e8; }
  }

  @keyframes ci-rail-github-icon {
    0%, 23% { color: var(--cloud-accent); }
    24%, 100% { color: rgba(255, 248, 232, 0.5); }
  }

  @keyframes ci-rail-vercel-icon {
    0%, 23%, 51%, 100% { color: rgba(255, 248, 232, 0.5); }
    24%, 50% { color: #fff8e8; }
  }

  @keyframes ci-rail-kery-icon {
    0%, 50%, 75%, 100% { color: rgba(255, 248, 232, 0.5); }
    51%, 74% { color: var(--cloud-accent); }
  }

  @keyframes ci-rail-check-icon {
    0%, 74% { color: rgba(255, 248, 232, 0.5); }
    75%, 100% { color: var(--cloud-accent); }
  }

  @keyframes ci-pr-active {
    0%, 22% { opacity: 1; transform: translate(-50%, -50%); }
    26%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-0.5rem); }
  }

  @keyframes ci-preview-active {
    0%, 22% { opacity: 0; transform: translate(-50%, -50%) translateY(0.65rem); }
    26%, 50% { opacity: 1; transform: translate(-50%, -50%); }
    54%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-0.5rem); }
  }

  @keyframes ci-run-active {
    0%, 50% { opacity: 0; transform: translate(-50%, -50%) translateY(0.65rem); }
    54%, 73% { opacity: 1; transform: translate(-50%, -50%); }
    77%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-0.5rem); }
  }

  @keyframes ci-result-active {
    0%, 73% { opacity: 0; transform: translate(-50%, -50%) translateY(0.65rem); }
    77%, 100% { opacity: 1; transform: translate(-50%, -50%); }
  }

  @keyframes vercel-deploy-spinner {
    0%, 23% { opacity: 0; transform: rotate(0deg); border-color: rgba(255, 248, 232, 0.22); border-top-color: #fff8e8; }
    24%, 38% { opacity: 1; transform: rotate(360deg); border-color: rgba(255, 248, 232, 0.22); border-top-color: #fff8e8; }
    39%, 100% { opacity: 1; transform: rotate(360deg); border-color: var(--cloud-accent-bright); border-top-color: var(--cloud-accent-bright); }
  }

  @keyframes vercel-deploy-check {
    0%, 38% { opacity: 0; transform: rotate(45deg) scale(0.82); }
    39%, 100% { opacity: 1; transform: rotate(45deg) scale(1); }
  }

  @keyframes vercel-deploying-label {
    0%, 23%, 39%, 100% { opacity: 0; }
    24%, 38% { opacity: 1; }
  }

  @keyframes vercel-deployed-label {
    0%, 38% { opacity: 0; }
    39%, 100% { opacity: 1; }
  }

  @keyframes vercel-url-reveal {
    0%, 38% { opacity: 0; }
    39%, 100% { opacity: 1; }
  }

  @keyframes ci-flow-check {
    0%, 51% {
      border-color: rgba(67, 118, 72, 0.18);
      background: rgba(67, 118, 72, 0.1);
      color: transparent;
      transform: scale(0.92);
    }
    60%, 100% {
      border-color: var(--cloud-accent-bright);
      background: var(--cloud-accent);
      color: #fffdf6;
      transform: scale(1);
    }
  }

  @keyframes ci-flow-alert {
    0%, 51% {
      border-color: rgba(212, 128, 38, 0.18);
      background: rgba(212, 128, 38, 0.1);
      color: transparent;
      transform: scale(0.92);
    }
    60%, 100% {
      border-color: color-mix(in srgb, var(--cloud-warning) 76%, #ffcf49);
      background: var(--cloud-warning);
      color: #fff8e8;
      transform: scale(1);
    }
  }

  @keyframes ci-flow-skip {
    0%, 51% {
      border-color: rgba(255, 248, 232, 0.14);
      background: rgba(255, 248, 232, 0.04);
      color: transparent;
      transform: scale(0.92);
    }
    60%, 100% {
      border-color: rgba(255, 248, 232, 0.22);
      background: rgba(255, 248, 232, 0.08);
      color: rgba(255, 248, 232, 0.55);
      transform: scale(1);
    }
  }

  @keyframes ci-issue-count {
    0%, 58% { opacity: 0; transform: translateY(0.2rem); }
    60%, 100% { opacity: 1; transform: translateY(0); }
  }

  .faq-section {
    background: var(--color-bg);
  }

  .faq-grid {
    align-items: start;
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-list details {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-list summary {
