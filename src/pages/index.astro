<script is:inline>
  (() => {
    const demo = document.querySelector('[data-agent-demo]');
    if (!(demo instanceof HTMLElement)) return;

    let resetTimer = 0;
    let enterTimer = 0;
    let prepareTimer = 0;
    let runTimer = 0;

    const getLoopDuration = () => {
      const rawValue = getComputedStyle(demo).getPropertyValue('--loop').trim();
      const value = Number.parseFloat(rawValue);
      if (!Number.isFinite(value)) return 29000;
      return rawValue.endsWith('ms') ? value : value * 1000;
    };

    const clearTimers = () => {
      window.clearTimeout(resetTimer);
      window.clearTimeout(enterTimer);
      window.clearTimeout(prepareTimer);
      window.clearTimeout(runTimer);
    };

    const runDemo = () => {
      clearTimers();
      demo.classList.remove('is-idle');
      demo.classList.add('is-entering');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      enterTimer = window.setTimeout(() => {
        demo.classList.remove('is-entering');
        demo.classList.add('is-preparing');

        prepareTimer = window.setTimeout(() => {
          demo.classList.remove('is-preparing');
          demo.classList.remove('is-running');
          void demo.offsetWidth;
          demo.classList.add('is-running');
          resetTimer = window.setTimeout(resetDemo, reducedMotion ? 2800 : getLoopDuration() + 150);
        }, reducedMotion ? 1800 : 3000);
      }, reducedMotion ? 450 : 520);
    };

    const scheduleRun = () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      runTimer = window.setTimeout(runDemo, reducedMotion ? 1200 : 3600);
    };

    const resetDemo = () => {
      clearTimers();
      demo.classList.remove('is-running');
      demo.classList.remove('is-entering');
      demo.classList.remove('is-preparing');
      demo.classList.add('is-idle');
      scheduleRun();
    };

    scheduleRun();
  })();

  (() => {
    const form = document.getElementById('waitlist-form');
    const input = document.getElementById('waitlist-email');
    const button = document.getElementById('waitlist-button');
    const status = document.getElementById('waitlist-status');

    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement) || !(status instanceof HTMLParagraphElement)) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();
      status.className = '';

      if (!email || !input.validity.valid) {
        status.textContent = 'Enter a valid email address.';
        status.classList.add('error');
        return;
      }

      button.disabled = true;
      button.textContent = 'Joining...';
      status.textContent = '';

      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.error) throw new Error(data.error || 'Could not join waitlist.');
        status.textContent = data.alreadyJoined ? 'You are already on the list.' : 'You are on the list. We will reach out soon.';
        status.classList.add('success');
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Could not join waitlist.';
        status.classList.add('error');
      } finally {
        button.disabled = false;
        button.textContent = 'Join waitlist';
      }
    });
  })();

  (() => {
    const player = document.querySelector('[data-kery-player]');
    if (!(player instanceof HTMLElement)) return;

    const video = player.querySelector('video');
    const playOverlay = player.querySelector('[data-video-play]');
    const toggle = player.querySelector('[data-video-toggle]');
    const fullscreen = player.querySelector('[data-video-fullscreen]');
    const seek = player.querySelector('[data-video-seek]');
    const time = player.querySelector('[data-video-time]');

    if (
      !(video instanceof HTMLVideoElement) ||
      !(playOverlay instanceof HTMLButtonElement) ||
      !(toggle instanceof HTMLButtonElement) ||
      !(fullscreen instanceof HTMLButtonElement) ||
      !(seek instanceof HTMLInputElement) ||
      !(time instanceof HTMLElement)
    ) return;

    const formatTime = (seconds) => {
      if (!Number.isFinite(seconds)) return '0:00';
      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = Math.floor(seconds % 60).toString().padStart(2, '0');
      return `${minutes}:${remainingSeconds}`;
    };

    const syncPlaying = () => {
      const playing = !video.paused && !video.ended;
      player.classList.toggle('is-playing', playing);
      toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
    };

    const syncProgress = () => {
      const progress = video.duration ? (video.currentTime / video.duration) * 100 : 0;
      seek.value = String(progress);
      seek.style.setProperty('--video-progress', `${progress}%`);
      time.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
    };

    const togglePlayback = async () => {
      if (video.paused || video.ended) {
        await video.play().catch(() => {});
      } else {
        video.pause();
      }
      syncPlaying();
    };

    playOverlay.addEventListener('click', togglePlayback);
    toggle.addEventListener('click', togglePlayback);

    video.addEventListener('play', syncPlaying);
    video.addEventListener('pause', syncPlaying);
    video.addEventListener('ended', syncPlaying);
    video.addEventListener('loadedmetadata', syncProgress);
    video.addEventListener('timeupdate', syncProgress);

    seek.addEventListener('input', () => {
      const next = Number(seek.value);
      if (Number.isFinite(video.duration)) {
        video.currentTime = (next / 100) * video.duration;
      }
      seek.style.setProperty('--video-progress', `${next}%`);
    });

    fullscreen.addEventListener('click', async () => {
      if (!document.fullscreenElement) {
        await player.requestFullscreen?.();
      } else {
        await document.exitFullscreen?.();
      }
    });

    syncPlaying();
    syncProgress();
  })();
</script>
