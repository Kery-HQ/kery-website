  .agent-strip {
    border-block: 1px solid var(--color-border);
    background: rgba(255, 253, 246, 0.78);
  }

  .agent-strip .container {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    overflow-x: auto;
    padding-block: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .agent-strip p {
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    font-weight: 800;
  }

