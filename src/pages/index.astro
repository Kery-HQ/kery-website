---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrCheckDemo from '../components/PrCheckDemo.astro';
import NlRunDemo from '../components/NlRunDemo.astro';
import { SITE_DISCORD_URL, SITE_GITHUB_URL, SITE_CLOUD_URL } from '../constants';

const painPoints = [
  ['Reality', 'The bugs that matter hide in real flows', 'Login, checkout, forms, permissions, empty states, and mobile layouts are where releases usually break. Kery walks those paths in a real browser.'],
];

const steps = [
  ['1', 'Describe the flow in plain English', 'Type what to check the way you would explain it to a teammate.'],
  ['2', 'Kery plans the checks', 'Your sentence becomes a concrete list of verifications.'],
  ['3', 'It runs them in a real browser', 'Opens your app, walks the flow, and records everything.'],
  ['4', 'Every check gets a verdict', 'Pass or fail, with the recording to show why.'],
];

const installFeatures = [
  'Open-source engine you can inspect, run, and extend locally.',
  'Runs locally with Docker.',
  'Installs MCP into Cursor, Claude Code, and Codex CLI.',
  'Point Kery at your app running locally and start testing it.',
  'Supports the following providers.',
];

const supportedProviders = [
  ['OpenAI', '/icons/openai.svg'],
  ['Anthropic', '/icons/claude-color.svg'],
  ['Google Gemini', '/icons/gemini-color.svg'],
  ['OpenRouter', '/icons/openrouter.svg'],
];

const cloudFeatures = [
  'Runs automatically on every pull request.',
  'End-to-end GitHub integration — results land on the PR.',
  'Vercel preview deployment support.',
  'PR-aware checks that understand code changes and intent.',
  'Organization and team management with shared projects.',
];

const faqs = [
  ['What is Kery?', 'Kery checks that your pull requests do what they say. It reads the diff, works out what the change claims to do, runs those flows in a real browser, and posts each check back to the PR with a verdict and video of what actually happened.'],
  ['Do I need to write test scripts?', 'No. Kery works out what to check from the pull request itself. You can also point it at a flow in plain English, and useful flows can be saved and rerun.'],
  ['Does it work behind authentication?', 'Yes. Kery supports logged-in products through configured environments and credentials, including form login, Clerk, and Supabase Auth. It is not limited to simple public sites.'],
  ['Which LLM providers are supported?', 'Kery supports OpenAI, Anthropic, Google Gemini, and OpenRouter. Bring your own provider keys when running locally.'],
  ['Can I run Kery in CI?', 'Yes. Kery Cloud runs on your pull requests today — connect the GitHub App and every PR gets checked against its preview deployment. The open-source stack can also run in your own pipeline.'],
  ['What can I do with MCP?', 'Use Kery from MCP-compatible clients like Cursor, Claude Code, and Codex CLI to run browser checks on your app, inspect route coverage, and pull results.'],
  ['Where does my data live?', 'In the open-source setup, run artifacts live in your own environment. Kery only sends prompts and required context to the LLM provider you configure.'],
  ['Is Kery open-source?', 'Yes. The local engine is open-source, built for self-hosting, inspection, and extension. Kery Cloud adds hosted execution and team workflows.'],
];
---

<Layout
  title="Kery — see it work, before you merge"
  description="Claude Code builds it. Kery checks it works. Every pull request gets run in a real browser, with video of what actually happened — no tests to write."
>
  <Navbar />
  <main class="site-main">
    <section class="hero-section">
      <div class="container hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Video proof on every pull request</span>
          <h1>See it work, <em>before you merge.</em></h1>
          <p class="hero-rotator" aria-label="Claude Code builds it; Kery checks it works.">
            <span aria-hidden="true">
              <span class="rotator-slot">
                <span class="rotator-item"><img src="/icons/claude.svg" alt="" width="20" height="20" loading="eager" />Claude Code builds</span>
                <span class="rotator-item"><img src="/icons/codex.svg" alt="" width="20" height="20" loading="eager" />Codex builds</span>
                <span class="rotator-item"><img src="/icons/cursor.svg" alt="" width="20" height="20" loading="eager" />Cursor builds</span>
                <span class="rotator-item">You build</span>
              </span>
              it; <span class="rotator-kery"><img src="/kery.png" alt="" width="20" height="20" loading="eager" />Kery</span> checks it works.
            </span>
          </p>
          <p class="hero-secondary">
            No tests to write. Kery reads the diff and works out what the change was supposed to do.
          </p>
          <div class="hero-actions">
            <a href={SITE_CLOUD_URL} class="button button-primary">Connect your repo</a>
            <a href="#install" class="button button-secondary">Or run it locally</a>
          </div>
        </div>
      </div>
    </section>

    <PrCheckDemo />

    <section class="section how-section" id="product">
      <div class="container how-grid">
        <NlRunDemo />

        <div class="section-copy">
          <span class="section-kicker">How Kery works</span>
          <h2>Turn plain English into <em>repeatable browser tests.</em></h2>
          <div class="steps-list">
            {steps.map(([number, title, copy]) => (
              <article>
                <span>{number}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section install-section" id="install">
      <div class="container install-grid">
        <div class="section-copy">
          <span class="section-kicker">Run Kery locally</span>
          <h2>One command starts the <em>open-source browser testing stack.</em></h2>
          <ul class="install-feature-list">
            {installFeatures.map((feature) => (
              <li>
                <span aria-hidden="true"></span>
                {feature}
              </li>
            ))}
          </ul>
          <div class="provider-strip" aria-label="Supported LLM providers">
            {supportedProviders.map(([label, icon]) => (
              <span>
                <img src={icon} alt="" width="18" height="18" loading="lazy" />
                {label}
              </span>
            ))}
          </div>
          <div class="install-actions">
            <a href={SITE_GITHUB_URL} class="button button-secondary" target="_blank" rel="noopener noreferrer">View GitHub README</a>
            <a href="#demo" class="button button-ghost">See how it works</a>
          </div>
        </div>
        <div class="install-card" aria-label="Animated Kery local setup flow">
          <div class="terminal-top">
            <span></span><span></span><span></span>
            <strong>kery setup</strong>
          </div>
          <div class="setup-story">
            <div class="story-stage">
              <section class="story-scene scene-command" aria-hidden="true">
                <div class="story-command">
                  <span>$</span>
                  <strong>npx keryai</strong>
                  <i></i>
                </div>
              </section>

              <section class="story-scene scene-provider" aria-hidden="true">
                <div class="provider-card">
                  <div class="story-question">Which LLM provider?</div>
                  <div class="provider-options">
                    <span class="provider-option provider-openai"><img src="/icons/openai.svg" alt="" width="18" height="18" loading="lazy" /><strong>OpenAI</strong></span>
                    <span class="provider-option provider-openrouter"><img src="/icons/openrouter.svg" alt="" width="18" height="18" loading="lazy" /><strong>OpenRouter</strong></span>
                    <span class="provider-option provider-anthropic"><img src="/icons/claude-color.svg" alt="" width="18" height="18" loading="lazy" /><strong>Anthropic</strong><em>selected</em></span>
                    <span class="provider-option provider-gemini"><img src="/icons/gemini-color.svg" alt="" width="18" height="18" loading="lazy" /><strong>Google Gemini</strong></span>
                  </div>
                  <div class="api-key-row">
                    <span>ANTHROPIC_API_KEY</span>
                    <code><b class="api-key-typed">sk-ant-••••••••</b><i class="api-key-caret"></i></code>
                  </div>
                  <b class="selection-cursor">select</b>
                </div>
              </section>

              <section class="story-scene scene-mcp" aria-hidden="true">
                <div class="mcp-card">
                  <div class="mcp-toggle">
                    <strong>Install Kery MCP</strong>
                    <span><i></i></span>
                  </div>
                  <div class="ide-grid">
                    <div><img src="/icons/cursor.svg" alt="" width="18" height="18" loading="lazy" />Cursor <span>✓</span></div>
                    <div><img src="/icons/claude.svg" alt="" width="18" height="18" loading="lazy" />Claude Code <span>✓</span></div>
                    <div><img src="/icons/codex.svg" alt="" width="18" height="18" loading="lazy" />Codex CLI <span>✓</span></div>
                  </div>
                </div>
              </section>

              <section class="story-scene scene-boot" aria-hidden="true">
                <div class="boot-card">
                  <div class="service-list">
                    <span>api <i></i></span>
                    <span>dashboard <i></i></span>
                    <span>worker <i></i></span>
                    <span>postgres <i></i></span>
                    <span>redis <i></i></span>
                  </div>
                  <div class="dashboard-ready">
                    <span>✓</span>
                    <div>
                      <strong>Dashboard ready</strong>
                      <code>http://localhost:11111</code>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <div class="story-rail" aria-hidden="true">
              <span>Command</span>
              <span>Provider</span>
              <span>MCP</span>
              <span>Dashboard</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section cloud-section" id="cloud">
      <div class="container cloud-grid">
        <div class="section-copy">
          <span class="section-kicker">Kery Cloud</span>
          <h2>Every pull request gets <em>a real browser pass.</em></h2>
          <p>
            Kery Cloud watches your pull requests, runs each change in a real browser on its preview deployment, and posts the results back to the PR before you merge.
          </p>
          <ul class="cloud-feature-list">
            {cloudFeatures.map((feature) => (
              <li>
                <span aria-hidden="true"></span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
        <div class="cloud-connect">
          <div class="cloud-connect-copy">
            <span class="form-eyebrow">Self-serve</span>
            <h3>Connect a repo, get your next PR checked</h3>
            <p>Kery Cloud runs on your pull requests today. GitHub App, one-command connect, no API keys.</p>
          </div>
          <div class="cloud-connect-action">
            <a href={SITE_CLOUD_URL} class="button cloud-connect-button">Connect your repo</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section problem-section" hidden>
      <div class="container two-col">
        <div class="section-copy">
          <span class="section-kicker">Why this matters</span>
          <h2>AI made shipping cheap. Checking is still expensive.</h2>
          <p>
            Claude Code, Codex, Cursor, and other agents can create more product changes than a team can manually click through. The risk is not that teams stop building. The risk is that they merge faster than they can verify real user flows.
          </p>
        </div>
        <div class="pain-grid">
          {painPoints.map(([label, title, copy]) => (
            <article>
              <span>{label}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-grid">
        <div class="section-copy">
          <span class="section-kicker">FAQ</span>
          <h2>What teams usually ask first.</h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section community-section" id="community">
      <div class="container community-inner">
        <span class="section-kicker">Community</span>
        <h2>Join the <em>Kery community.</em></h2>
        <p>
          Ask setup questions, share MCP workflows, compare real browser runs, and follow what lands next.
        </p>
        <div class="community-actions">
          <a href={SITE_DISCORD_URL} class="button community-discord-button" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.3 4.4a19.8 19.8 0 0 0-4.9-1.5.1.1 0 0 0-.1 0c-.2.4-.4.9-.6 1.3a18.3 18.3 0 0 0-5.5 0 12.6 12.6 0 0 0-.6-1.3.1.1 0 0 0-.1 0 19.7 19.7 0 0 0-4.9 1.5.1.1 0 0 0 0 0C.5 9.1-.3 13.6.1 18.1c0 0 0 .1.1.1a19.9 19.9 0 0 0 6 3 .1.1 0 0 0 .1 0c.5-.6.9-1.3 1.2-2a.1.1 0 0 0 0-.1 13.1 13.1 0 0 1-1.9-.9.1.1 0 0 1 0-.1l.4-.3h.1c3.9 1.8 8.2 1.8 12.1 0h.1l.4.3a.1.1 0 0 1 0 .1 12.3 12.3 0 0 1-1.9.9.1.1 0 0 0 0 .1c.4.7.8 1.4 1.2 2a.1.1 0 0 0 .1 0 19.8 19.8 0 0 0 6-3 .1.1 0 0 0 0-.1c.5-5.2-.8-9.7-3.5-13.7a.1.1 0 0 0-.1 0ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4 0-1.3 1-2.4 2.2-2.4s2.2 1.1 2.2 2.4c0 1.3-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4 0-1.3 1-2.4 2.2-2.4s2.2 1.1 2.2 2.4c0 1.3-.9 2.4-2.2 2.4Z"></path>
            </svg>
            Join Discord
          </a>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="container final-cta-inner">
        <div>
          <span class="section-kicker">Get started</span>
          <h2>Put proof in <em>every pull request.</em></h2>
        </div>
        <div class="final-actions">
          <a href={SITE_CLOUD_URL} class="button button-primary">Connect your repo</a>
          <a href={SITE_GITHUB_URL} class="button button-secondary" target="_blank" rel="noopener noreferrer">Star on GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const slot = document.querySelector('.rotator-slot');
  if (slot instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(slot.querySelectorAll('.rotator-item'));
    if (items.length > 1) {
      slot.classList.add('js-run');
      let index = 0;
      const fit = () => {
        slot.style.width = `${items[index].offsetWidth}px`;
      };
      items[index].classList.add('is-active');
      fit();
      window.addEventListener('load', fit);
      window.setInterval(() => {
        const prev = items[index];
        prev.classList.remove('is-active');
        prev.classList.add('is-leaving');
        window.setTimeout(() => prev.classList.remove('is-leaving'), 380);
        index = (index + 1) % items.length;
        items[index].classList.add('is-active');
        fit();
      }, 1800);
    }
  }
</script>

<style>
  .site-main {
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 8%, rgba(255, 207, 73, 0.18), transparent 24rem),
      linear-gradient(180deg, #fffdf6 0%, var(--color-bg) 34rem);
  }

  .hero-section {
    padding: clamp(10.5rem, 17vw, 14.5rem) 0 clamp(6.75rem, 12vw, 10.5rem);
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    max-width: 54rem;
  }

  .eyebrow,
  .section-kicker,
  .form-eyebrow {
    display: inline-flex;
    width: fit-content;
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .eyebrow {
    padding: 0.42rem 0.68rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(255, 253, 246, 0.82);
  }

  .hero-copy h1 {
    max-width: min(17ch, 100%);
    margin: 1.7rem 0 1.75rem;
    color: var(--color-ink);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 850;
    letter-spacing: -0.052em;
    line-height: 0.88;
  }

  h1 em, h2 em {
    font-style: normal;
    color: var(--color-leaf);
  }

  .hero-copy p,
  .section-copy p,
  .section-heading p,
  .cloud-connect p {
    color: var(--color-text-secondary);
    font-size: clamp(1.02rem, 1.25vw, 1.16rem);
    line-height: 1.72;
  }

  .hero-copy p.hero-rotator {
    margin-top: 0.6rem;
    color: var(--color-ink);
    font-size: clamp(1.18rem, 1.6vw, 1.42rem);
    font-weight: 760;
    line-height: 1.55;
  }

  .rotator-kery {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    vertical-align: bottom;
  }

  .rotator-kery img {
    width: 1.25em;
    height: 1.25em;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .rotator-slot {
    position: relative;
    display: inline-grid;
    overflow: hidden;
    vertical-align: bottom;
    transition: width 0.35s ease;
  }

  .rotator-item {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    justify-self: start;
    color: inherit;
    font-weight: inherit;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.55em);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .rotator-item img {
    width: 1.25em;
    height: 1.25em;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .rotator-slot:not(.js-run) .rotator-item:first-child,
  .rotator-item.is-active {
    opacity: 1;
    transform: none;
  }

  .rotator-item.is-leaving {
    opacity: 0;
    transform: translateY(-0.55em);
  }

  .hero-secondary {
    margin-top: 1.3rem;
    max-width: 33rem;
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.65rem;
  }

  .hero-actions {
    justify-content: center;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.72rem 1rem;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 760;
    line-height: 1;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fffdf6;
  }

  .button-primary:hover {
    background: #000;
  }

  .button-secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-ink);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
  }

  .button-ghost {
    background: transparent;
    color: var(--color-text-secondary);
  }

  .button-ghost:hover {
    background: var(--color-bg-alt);
    color: var(--color-ink);
  }

  .window-dots {
    display: flex;
    gap: 0.35rem;
  }

  .window-dots span {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: #ff695f;
  }

  .window-dots span:nth-child(2) {
    background: #ffcf49;
  }

  .window-dots span:nth-child(3) {
    background: #63c174;
  }

  .pain-grid article,
  .cloud-feature-grid article,
  .install-card,
  .cloud-connect {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
  }

  @keyframes pixel-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.25; }
  }

  .section {
    padding: clamp(4.75rem, 8vw, 7rem) 0;
  }

  .two-col,
  .install-grid,
  .cloud-grid,
  .faq-grid,
  .final-cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .section-copy,
  .section-heading {
    max-width: 48rem;
  }

  .section-heading {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-heading.center {
    margin-inline: auto;
    text-align: center;
  }

  .section-copy h2,
  .section-heading h2,
  .final-cta h2 {
    margin: 0.65rem 0 0.85rem;
    color: var(--color-ink);
    font-size: clamp(2.35rem, 4.8vw, 4.35rem);
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .problem-section {
    background:
      linear-gradient(180deg, rgba(255, 253, 246, 0.64), rgba(247, 241, 228, 0.72)),
      var(--color-bg);
  }

  .problem-section .two-col {
    align-items: center;
  }

  .pain-grid {
    display: grid;
    gap: 0.75rem;
  }

  .pain-grid article {
    padding: 1rem;
    background: rgba(255, 253, 246, 0.78);
  }

  .pain-grid article {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: 0.68rem;
    min-height: 10.25rem;
    border-radius: 8px;
    background: #fffdf6;
    box-shadow: 0 5px 0 rgba(38, 33, 21, 0.07);
  }

  .pain-grid article::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), #ffcf49);
  }

  .pain-grid article > span {
    width: fit-content;
    padding: 0.18rem 0.42rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent-muted);
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .pain-grid h3,
  .cloud-feature-grid h3 {
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .pain-grid h3 {
    max-width: 18rem;
    font-size: 1.12rem;
    font-weight: 850;
  }

  .pain-grid p,
  .cloud-feature-grid p {
    margin-top: 0.45rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .pain-grid p {
    margin-top: 0;
  }

  .install-section,
  .cloud-section {
    border-block: 1px solid var(--color-border);
    background: #fffdf6;
  }

  .how-section {
    border-block: 1px solid var(--color-border);
