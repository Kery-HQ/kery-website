  .cloud-feature-grid h3 {
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .pain-grid p,
  .steps-grid p,
  .capability-grid p,
  .cloud-feature-grid p {
    margin-top: 0.45rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .how-section,
  .install-section,
  .cloud-section {
    border-block: 1px solid var(--color-border);
    background: #fffdf6;
  }

  .install-section {
    background:
      linear-gradient(90deg, rgba(38, 33, 21, 0.035) 1px, transparent 1px),
      linear-gradient(rgba(38, 33, 21, 0.035) 1px, transparent 1px),
      #fffdf6;
    background-size: 34px 34px;
  }

  .install-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.45rem;
  }

  .install-feature-list {
    display: grid;
    gap: 0.72rem;
    margin-top: 1.2rem;
  }

  .install-feature-list li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.68rem;
    align-items: start;
    color: var(--color-text-secondary);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.62;
  }

  .install-feature-list li > span {
    width: 0.58rem;
    height: 0.58rem;
    margin-top: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 68%, var(--color-border));
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 3px 3px 0 rgba(67, 118, 72, 0.16);
  }

  .install-grid > .install-card {
    order: -1;
  }

  .provider-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .provider-strip span {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2.1rem;
    padding: 0 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: rgba(255, 253, 246, 0.78);
    color: var(--color-ink);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .provider-strip img,
  .provider-options img {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .install-card {
    --story-loop: 14s;
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #12120f;
    color: #fff8e8;
    box-shadow:
      0 20px 50px rgba(38, 33, 21, 0.16),
      inset 0 1px 0 rgba(255, 248, 232, 0.08);
  }

  .install-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 78% 4%, rgba(255, 207, 73, 0.12), transparent 15rem),
      linear-gradient(180deg, rgba(255, 248, 232, 0.035), transparent 36%);
  }

  .terminal-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.76rem 0.95rem;
    border-bottom: 1px solid rgba(255, 248, 232, 0.1);
    background: rgba(23, 23, 20, 0.72);
  }

  .terminal-top span {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: #ff695f;
  }

  .terminal-top span:nth-child(2) {
    background: #ffcf49;
  }

  .terminal-top span:nth-child(3) {
    background: #63c174;
  }

  .terminal-top strong {
    margin-left: auto;
    color: rgba(255, 248, 232, 0.54);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .setup-story {
    position: relative;
    z-index: 1;
    padding: 1rem;
    background:
      linear-gradient(90deg, rgba(255, 248, 232, 0.035) 1px, transparent 1px),
      linear-gradient(rgba(255, 248, 232, 0.035) 1px, transparent 1px),
      #11120f;
    background-size: 24px 24px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .story-stage {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
    border: 1px solid rgba(255, 248, 232, 0.1);
    border-radius: 10px;
    background: rgba(10, 10, 8, 0.66);
  }

  .story-scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    opacity: 0;
    transform: translateY(0.65rem) scale(0.98);
    animation-duration: var(--story-loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease;
  }

  .scene-command { animation-name: scene-command; }
  .scene-provider { animation-name: scene-provider; }
  .scene-mcp { animation-name: scene-mcp; }
  .scene-boot { animation-name: scene-boot; }

  .story-command {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: min(100%, 25rem);
    min-height: 7.2rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(255, 248, 232, 0.16);
    border-radius: 10px;
    background: #090a08;
    box-shadow:
      0 14px 0 rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 248, 232, 0.08);
    color: #fff8e8;
    font-size: clamp(1.75rem, 4vw, 3rem);
  }

  .story-command span {
    color: #8bdba0;
    font-weight: 900;
  }

  .story-command strong {
    display: inline-block;
    width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-weight: 900;
    animation: command-type var(--story-loop) steps(10, end) infinite;
  }

  .story-command i {
    width: 0.62rem;
    height: 2.3rem;
    background: #ffcf49;
    animation: command-caret var(--story-loop) steps(1, end) infinite;
  }

  .story-caption {
    display: grid;
    gap: 0.26rem;
    margin-top: 1.35rem;
    text-align: center;
  }

  .story-caption strong,
  .story-question,
  .mcp-toggle strong,
  .dashboard-ready strong {
    color: #fff8e8;
    font-size: 0.95rem;
    font-weight: 900;
  }

  .story-caption span {
    color: rgba(255, 248, 232, 0.58);
  }

  .provider-card,
  .mcp-card,
  .boot-card {
    position: relative;
    width: min(100%, 25rem);
    padding: 1rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 10px;
    background: #171714;
    box-shadow: 0 8px 0 rgba(0, 0, 0, 0.24);
  }

  .story-question {
    margin-bottom: 0.8rem;
  }

  .provider-options {
    display: grid;
    gap: 0.42rem;
  }

  .provider-option,
  .api-key-row,
  .mcp-toggle,
  .ide-grid div,
  .service-list span,
  .dashboard-ready {
    border: 1px solid rgba(255, 248, 232, 0.1);
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.05);
  }

  .provider-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.68rem;
    color: rgba(255, 248, 232, 0.62);
    animation-duration: var(--story-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .provider-options strong {
    color: inherit;
    font-size: 0.8rem;
  }

  .provider-openai {
    animation-name: provider-openai-select;
  }

  .provider-openrouter {
    animation-name: provider-openrouter-select;
  }

  .provider-anthropic {
    animation-name: provider-anthropic-select;
  }

  .provider-gemini {
    color: rgba(255, 248, 232, 0.42);
  }

  .provider-option em {
    margin-left: auto;
    color: rgba(255, 248, 232, 0.58);
    font-style: normal;
    opacity: 0;
    animation: provider-selected-label var(--story-loop) steps(1, end) infinite;
  }

  .api-key-row {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.8rem;
    padding: 0.6rem 0.68rem;
    color: rgba(255, 248, 232, 0.54);
    opacity: 0.42;
    animation: api-key-row var(--story-loop) steps(1, end) infinite;
  }

  .api-key-row code {
    display: inline-flex;
    align-items: center;
    min-width: 8.6rem;
    color: #8bdba0;
    font: inherit;
  }

  .api-key-typed {
    display: inline-block;
    width: 0;
    overflow: hidden;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    animation: api-key-type var(--story-loop) steps(15, end) infinite;
  }

  .api-key-caret {
    width: 0.42rem;
    height: 0.9rem;
    margin-left: 0.08rem;
    background: #ffcf49;
    opacity: 0;
    animation: api-key-caret var(--story-loop) steps(1, end) infinite;
  }

  .selection-cursor {
    position: absolute;
    right: 0.7rem;
    top: 3.58rem;
    padding: 0.2rem 0.38rem;
    border: 2px solid #171714;
    border-radius: 4px;
    background: #ffcf49;
    color: #171714;
    font-size: 0.62rem;
    text-transform: uppercase;
    animation: selection-click var(--story-loop) infinite;
  }

  .mcp-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem;
  }

  .mcp-toggle span {
    position: relative;
    width: 2.6rem;
    height: 1.35rem;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.14);
    animation: mcp-switch-bg var(--story-loop) steps(1, end) infinite;
  }

  .mcp-toggle i {
    position: absolute;
    left: 0.18rem;
    top: 0.18rem;
    width: 0.98rem;
    height: 0.98rem;
    border-radius: 999px;
    background: #fff8e8;
    animation: mcp-switch-knob var(--story-loop) steps(1, end) infinite;
  }

  .ide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .ide-grid div {
    display: grid;
    gap: 0.38rem;
    justify-items: center;
    min-height: 5rem;
    padding: 0.72rem 0.45rem;
    color: rgba(255, 248, 232, 0.68);
    text-align: center;
  }

  .ide-grid img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .ide-grid span {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    background: #8bdba0;
    color: #171714;
    font-size: 0.7rem;
    font-weight: 900;
    opacity: 0;
    transform: scale(0.4);
    animation: ide-check var(--story-loop) steps(1, end) infinite;
  }

  .ide-grid div:nth-child(2) span { animation-delay: 0.15s; }
  .ide-grid div:nth-child(3) span { animation-delay: 0.3s; }

  .service-list {
    display: grid;
    gap: 0.5rem;
  }

  .service-list span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.58rem 0.68rem;
    color: rgba(255, 248, 232, 0.66);
  }

  .service-list i {
    width: 0.64rem;
    height: 0.64rem;
    border-radius: 999px;
    background: #8bdba0;
    box-shadow: 0 0 0 0 rgba(139, 219, 160, 0.5);
    animation: service-pulse 1.1s ease infinite;
  }

  .service-list span:nth-child(2) i { animation-delay: 0.1s; }
  .service-list span:nth-child(3) i { animation-delay: 0.2s; }
  .service-list span:nth-child(4) i { animation-delay: 0.3s; }
  .service-list span:nth-child(5) i { animation-delay: 0.4s; }

  .dashboard-ready {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin-top: 0.85rem;
    padding: 0.8rem;
    border-color: rgba(139, 219, 160, 0.32);
    background: rgba(139, 219, 160, 0.1);
  }

  .dashboard-ready > span {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: #8bdba0;
    color: #171714;
    font-weight: 900;
  }

  .dashboard-ready code {
    display: block;
    margin-top: 0.16rem;
    color: #ffcf49;
    font: inherit;
  }

  .story-rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
    margin-top: 0.78rem;
  }

  .story-rail span {
    min-width: 0;
    padding: 0.42rem 0.3rem;
    border: 1px solid rgba(255, 248, 232, 0.1);
    border-radius: 6px;
    color: rgba(255, 248, 232, 0.48);
    font-size: 0.66rem;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
    animation-duration: var(--story-loop);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .story-rail span:nth-child(1) { animation-name: rail-command; }
  .story-rail span:nth-child(2) { animation-name: rail-provider; }
  .story-rail span:nth-child(3) { animation-name: rail-mcp; }
  .story-rail span:nth-child(4) { animation-name: rail-boot; }

  @keyframes scene-command {
    0%, 22% { opacity: 1; transform: translateY(0) scale(1); }
    26%, 100% { opacity: 0; transform: translateY(-0.5rem) scale(0.98); }
  }

  @keyframes scene-provider {
    0%, 22% { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
    26%, 50.5% { opacity: 1; transform: translateY(0) scale(1); }
    54.5%, 100% { opacity: 0; transform: translateY(-0.5rem) scale(0.98); }
  }

  @keyframes scene-mcp {
    0%, 50.5% { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
    54.5%, 72% { opacity: 1; transform: translateY(0) scale(1); }
    76%, 100% { opacity: 0; transform: translateY(-0.5rem) scale(0.98); }
  }

  @keyframes scene-boot {
    0%, 72% { opacity: 0; transform: translateY(0.65rem) scale(0.98); }
    76%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes command-type {
    0%, 4% { width: 0; }
    14%, 100% { width: 10ch; }
  }

  @keyframes command-caret {
    0%, 4%, 15%, 17%, 19%, 21%, 100% { opacity: 0; }
    5%, 14%, 16%, 18%, 20% { opacity: 1; }
  }

  @keyframes provider-openai-select {
    0%, 27%, 33%, 100% { border-color: rgba(255, 248, 232, 0.1); background: rgba(255, 248, 232, 0.05); color: rgba(255, 248, 232, 0.62); box-shadow: none; }
    28%, 32% { border-color: rgba(255, 207, 73, 0.62); background: rgba(255, 207, 73, 0.13); color: #ffcf49; box-shadow: 0 0 0 3px rgba(255, 207, 73, 0.16); }
  }

  @keyframes provider-openrouter-select {
    0%, 32%, 39%, 100% { border-color: rgba(255, 248, 232, 0.1); background: rgba(255, 248, 232, 0.05); color: rgba(255, 248, 232, 0.62); box-shadow: none; }
    33%, 38% { border-color: rgba(255, 207, 73, 0.62); background: rgba(255, 207, 73, 0.13); color: #ffcf49; box-shadow: 0 0 0 3px rgba(255, 207, 73, 0.16); }
  }

  @keyframes provider-anthropic-select {
    0%, 38%, 100% { border-color: rgba(255, 248, 232, 0.1); background: rgba(255, 248, 232, 0.05); color: rgba(255, 248, 232, 0.62); box-shadow: none; }
    39%, 54% { border-color: rgba(255, 207, 73, 0.62); background: rgba(255, 207, 73, 0.13); color: #ffcf49; box-shadow: 0 0 0 3px rgba(255, 207, 73, 0.16); }
  }

  @keyframes provider-selected-label {
    0%, 38%, 100% { opacity: 0; }
    39%, 54% { opacity: 1; }
  }

  @keyframes selection-click {
    0%, 27%, 42%, 100% { opacity: 0; transform: translateY(-0.45rem); top: 3.58rem; }
    28%, 31% { opacity: 1; transform: translateY(0); top: 3.58rem; }
    33%, 36% { opacity: 1; transform: translateY(0); top: 5.58rem; }
    39%, 41% { opacity: 1; transform: translateY(0); top: 7.58rem; }
  }

  @keyframes api-key-row {
    0%, 39%, 100% { opacity: 0.42; }
    40%, 54% { opacity: 1; }
  }

  @keyframes api-key-type {
    0%, 41% { width: 0; }
    52.5%, 100% { width: 15ch; }
  }

  @keyframes api-key-caret {
    0%, 40%, 53.5%, 100% { opacity: 0; }
    41%, 53% { opacity: 1; }
  }

  @keyframes mcp-switch-bg {
    0%, 55% { background: rgba(255, 248, 232, 0.14); }
    56%, 100% { background: rgba(139, 219, 160, 0.34); }
  }

  @keyframes mcp-switch-knob {
    0%, 55% { transform: translateX(0); }
    56%, 100% { transform: translateX(1.22rem); }
  }

  @keyframes ide-check {
    0%, 57% { opacity: 0; transform: scale(0.4); }
    58%, 100% { opacity: 1; transform: scale(1); }
  }

  @keyframes service-pulse {
    0% { box-shadow: 0 0 0 0 rgba(139, 219, 160, 0.5); }
    70%, 100% { box-shadow: 0 0 0 0.55rem rgba(139, 219, 160, 0); }
  }

  @keyframes rail-command {
    0%, 23% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
    24%, 100% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
  }

  @keyframes rail-provider {
    0%, 23%, 52.5%, 100% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
    24%, 52% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
  }

  @keyframes rail-mcp {
    0%, 52%, 74%, 100% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
    52.5%, 73% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
  }

  @keyframes rail-boot {
    0%, 73% { background: transparent; color: rgba(255, 248, 232, 0.48); border-color: rgba(255, 248, 232, 0.1); }
    74%, 100% { background: rgba(255, 207, 73, 0.12); color: #ffcf49; border-color: rgba(255, 207, 73, 0.38); }
  }

  .cloud-section {
    background:
      radial-gradient(circle at 88% 16%, rgba(255, 207, 73, 0.18), transparent 22rem),
      #171714;
    color: #fff8e8;
  }

  .cloud-section .section-kicker,
  .form-eyebrow {
    color: #ffcf49;
  }

  .cloud-section h2 {
    color: #fff8e8;
  }

  .cloud-section .section-copy > p {
    color: rgba(255, 248, 232, 0.72);
  }

  .cloud-grid {
    grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.72fr);
    align-items: start;
  }

  .cloud-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .cloud-feature-grid article {
    background: rgba(255, 248, 232, 0.06);
    border-color: rgba(255, 248, 232, 0.13);
    padding: 0.9rem;
  }

  .cloud-feature-grid h3 {
    color: #fff8e8;
  }

  .cloud-feature-grid p {
    color: rgba(255, 248, 232, 0.68);
  }

  .cloud-form {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    background: rgba(255, 248, 232, 0.06);
    border-color: rgba(255, 248, 232, 0.13);
  }

  .cloud-form h3 {
    color: #fff8e8;
    font-size: 1.35rem;
    line-height: 1.1;
  }

  .cloud-form p {
    color: rgba(255, 248, 232, 0.68);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .cloud-form label {
    margin-top: 0.3rem;
    color: rgba(255, 248, 232, 0.72);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .cloud-form > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
  }

  .cloud-form input {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid rgba(255, 248, 232, 0.18);
    border-radius: 8px;
    background: rgba(255, 248, 232, 0.94);
    color: var(--color-ink);
    padding: 0 0.8rem;
    font: inherit;
  }

  .cloud-form p#waitlist-status {
    min-height: 1.1rem;
    font-size: 0.8rem;
  }

  .cloud-form p#waitlist-status.success {
    color: #8bdba0;
  }

  .cloud-form p#waitlist-status.error {
    color: #ff9388;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .steps-grid article {
    min-height: 17rem;
  }

  .steps-grid article > span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .demo-section {
    background: var(--color-bg);
  }

  .demo-media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: #171714;
    box-shadow: 0 20px 50px rgba(38, 33, 21, 0.14);
  }

  .demo-media video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .artifact-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
