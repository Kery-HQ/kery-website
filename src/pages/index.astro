---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Quickstart from '../components/Quickstart.astro';
import McpShowcase from '../components/McpShowcase.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import FeatureDeepDives from '../components/FeatureDeepDives.astro';
import WhatIs from '../components/WhatIs.astro';
import Problems from '../components/Problems.astro';
import WhySpecial from '../components/WhySpecial.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Kery — AI browser testing with MCP"
  description="Open-source AI agents crawl and test your web app in a real browser. MCP for Claude, Cursor, Codex, and more. Self-host today; hosted Kery coming soon."
>
  <Navbar />
  <main>
    <Hero />
    <Quickstart />
    <McpShowcase />
    <HowItWorks />
    <FeaturesGrid />
    <FeatureDeepDives />
    <WhatIs />
    <Problems />
    <WhySpecial />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
