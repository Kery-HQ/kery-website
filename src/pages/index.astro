---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/sections/SiteHeader';
import SiteFooter from '@/components/sections/SiteFooter';
import Hero from '@/components/sections/Hero';
import Leaks from '@/components/sections/Leaks';
import Changes from '@/components/sections/Changes';
import Proof from '@/components/sections/Proof';
import HowItRuns from '@/components/sections/HowItRuns';
import Booking from '@/components/sections/Booking';
import SavingsCalculator from '@/components/SavingsCalculator';
import { CONTACT_EMAIL, SITE_NAME, SITE_ORIGIN, calculator, seo } from '@/config/site';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_ORIGIN,
    email: CONTACT_EMAIL,
    description: seo.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_ORIGIN,
  },
];
---

<Layout structuredData={structuredData}>
  <SiteHeader />
  <main>
    <Hero />
    <Leaks />
    <Changes />
    <Proof />
    <HowItRuns />
    <section id="savings" class="scroll-mt-16 border-t">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
        <h2 class="text-4xl sm:text-5xl">{calculator.heading}</h2>
        <p class="mt-4 text-lg text-muted-foreground">{calculator.intro}</p>
        <div class="mt-10">
          <SavingsCalculator client:load />
        </div>
      </div>
    </section>
    <Booking />
  </main>
  <SiteFooter />
</Layout>
