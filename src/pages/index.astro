  .cloud-ci-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 82% 12%, rgba(255, 207, 73, 0.08), transparent 16rem),
      linear-gradient(180deg, rgba(255, 248, 232, 0.03), transparent 34%);
  }

  .cloud-ci-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.76rem 0.95rem;
    border-bottom: 1px solid rgba(255, 248, 232, 0.1);
    background: #12120f;
    color: rgba(255, 248, 232, 0.6);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .cloud-ci-topbar > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: var(--cloud-accent-bright);
  }

  .cloud-ci-topbar i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
    animation: pixel-blink 1s steps(2, end) infinite;
  }

  .cloud-ci-stage {
    position: relative;
    z-index: 1;
    padding: 1.15rem;
    background: #171714;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .ci-rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
    margin-bottom: 0.78rem;
  }

  .ci-progress-track {
    overflow: hidden;
    height: 0.42rem;
    margin-bottom: 0.78rem;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.05);
  }

  .ci-progress-track span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #ffcf49, var(--cloud-accent-bright));
    transform: scaleX(0.06);
    transform-origin: left center;
    animation: ci-progress-fill var(--ci-loop) linear infinite;
