---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { SITE_LOGO_URL } from '../../constants';
import type { BlogPost } from '../../lib/sanity';
import { formatPostDate, getAllPosts, getPostBySlug, portableTextToHtml } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const fullPosts = await Promise.all(
    posts.map((post) => (post.slug?.current ? getPostBySlug(post.slug.current) : null))
  );

  return fullPosts
    .filter((post): post is BlogPost => Boolean(post?.slug?.current))
    .map((post) => ({
      params: { slug: post.slug.current },
      props: { post },
    }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const title = `${post.title} - Kery Blog`;
const description = post.excerpt || 'A note from Kery on browser QA, agentic testing, and AI-speed product teams.';
const postUrl = new URL(`/blog/${post.slug.current}/`, Astro.site).toString();
const postImage = post.mainImage?.asset?.url;
const postHtml = portableTextToHtml(post.body);
const authorName = post.author?.name || 'Kery';
const fallbackImage = new URL('/og.png', Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  url: postUrl,
  mainEntityOfPage: postUrl,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  image: [postImage || fallbackImage],
  author: {
    '@type': 'Person',
    name: authorName,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kery',
    logo: {
      '@type': 'ImageObject',
      url: new URL(SITE_LOGO_URL, Astro.site).toString(),
    },
  },
};
---

<Layout
  title={title}
  description={description}
  ogImage={postImage || '/og.png'}
  structuredData={structuredData}
>
  <Navbar />
  <main class="post-page">
    <article class="post-article">
      <header class="post-header container">
        <a href="/blog/" class="back-link">Blog</a>
        <div class="post-meta">
          <span>{formatPostDate(post.publishedAt)}</span>
          {authorName && <span>{authorName}</span>}
        </div>
        <h1>{post.title}</h1>
        {post.excerpt && <p>{post.excerpt}</p>}
      </header>

      {postImage && (
        <div class="container">
          <img
            class="post-hero-image"
            src={postImage}
            alt={post.mainImage?.alt || ''}
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      <div class="container">
        {postHtml ? (
          <div class="post-content" set:html={postHtml} />
        ) : (
          <p class="post-empty">This post does not have body content yet.</p>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .post-page {
    padding-top: 5.5rem;
  }

  .post-article {
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .post-header {
    max-width: 840px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.4rem;
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .post-meta span + span::before {
    content: '/';
    margin-right: 0.6rem;
    color: var(--color-border);
  }

  .post-header h1 {
    max-width: 820px;
    margin-bottom: 1.1rem;
    font-size: clamp(2.7rem, 7vw, 5.7rem);
  }

  .post-header p {
    max-width: 720px;
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
  }

  .post-hero-image {
    width: 100%;
    max-height: 560px;
    margin: clamp(2rem, 5vw, 4rem) auto 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    object-fit: cover;
    background: var(--color-bg-alt);
  }

  .post-content,
  .post-empty {
    max-width: 760px;
    margin: clamp(2rem, 5vw, 4rem) auto 0;
  }

  .post-content :global(*) {
    overflow-wrap: anywhere;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin: 2.2rem 0 0.8rem;
  }

  .post-content :global(h2) {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .post-content :global(h3) {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .post-content :global(p),
  .post-content :global(li),
  .post-content :global(blockquote) {
    font-size: 1.08rem;
    line-height: 1.82;
  }

  .post-content :global(p) {
    margin: 1rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.1rem 0 1.4rem 1.4rem;
    color: var(--color-text-secondary);
  }

  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(li) {
    margin: 0.45rem 0;
    padding-left: 0.2rem;
  }

  .post-content :global(a) {
    color: var(--color-accent-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(code) {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    padding: 0.12rem 0.34rem;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .post-content :global(blockquote) {
    margin: 1.6rem 0;
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 4px solid var(--color-accent);
    color: var(--color-text);
  }

  .post-content :global(figure) {
    margin: 2rem 0;
  }

  .post-content :global(figure img) {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .post-content :global(figcaption) {
    margin-top: 0.55rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .post-empty {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  @media (max-width: 560px) {
    .post-page {
      padding-top: 4.75rem;
    }

    .post-article {
      padding-top: 3rem;
    }

    .post-meta {
      gap: 0.45rem;
    }
  }
</style>
