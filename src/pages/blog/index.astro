---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { SITE_GITHUB_URL } from '../../constants';
---

<Layout
  title="Blog — Kery"
  description="Updates and deep dives from the Kery team. The blog is coming soon — follow the repository for release notes in the meantime."
>
  <Navbar />
  <main class="soon-page">
    <div class="container soon-inner">
      <span class="section-badge">Blog</span>
      <h1>Coming soon</h1>
      <p class="soon-lead">
        We are preparing articles on agentic testing, MCP workflows, and operating Kery in production.
        Until then, release notes and development live on GitHub.
      </p>
      <a href={SITE_GITHUB_URL} class="btn btn-primary">View GitHub</a>
      <p class="soon-foot">
        <a href="/">← Back to home</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .soon-page {
    padding-top: 6rem;
    padding-bottom: var(--space-2xl);
    min-height: 70vh;
  }

  .soon-inner {
    max-width: 560px;
    text-align: center;
    margin: 0 auto;
  }

  .soon-inner h1 {
    margin: 0.75rem 0 var(--space-md);
  }

  .soon-lead {
    margin-bottom: var(--space-lg);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .soon-foot {
    margin-top: var(--space-xl);
    font-size: 0.9rem;
  }

  .soon-foot a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .soon-foot a:hover {
    color: var(--color-text);
  }
</style>
