---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { formatPostDate, getAllPosts, getPostUrl } from '../../lib/sanity';

const posts = await getAllPosts();
const featuredPost = posts[0];
const otherPosts = posts.slice(1);
const blogUrl = new URL('/blog/', Astro.site).toString();
const description = 'Notes from the Kery team on agentic testing, browser automation, MCP workflows, and product quality.';
---

<Layout
  title="Blog - Kery"
  description={description}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Kery Blog',
    url: blogUrl,
    description,
  }}
>
  <Navbar />
  <main class="blog-page">
    <section class="blog-hero">
      <div class="container blog-hero-inner">
        <span class="section-badge">Blog</span>
        <h1>Notes on browser QA for AI-speed teams.</h1>
        <p>
          Practical writing on agentic testing, MCP workflows, browser automation, and keeping product quality visible as teams ship faster.
        </p>
      </div>
    </section>

    {featuredPost ? (
      <section class="blog-featured">
        <div class="container">
          <a href={getPostUrl(featuredPost)} class="featured-post">
            {featuredPost.mainImage?.asset?.url && (
              <img
                src={featuredPost.mainImage.asset.url}
                alt={featuredPost.mainImage.alt || ''}
                loading="eager"
                decoding="async"
              />
            )}
            <div class="featured-copy">
              <span>{formatPostDate(featuredPost.publishedAt)}</span>
              <h2>{featuredPost.title}</h2>
              {featuredPost.excerpt && <p>{featuredPost.excerpt}</p>}
              <strong>Read note</strong>
            </div>
          </a>
        </div>
      </section>
    ) : (
      <section class="blog-empty">
        <div class="container empty-inner">
          <h2>No published notes yet.</h2>
          <p>When the first Sanity post is published, it will appear here automatically.</p>
        </div>
      </section>
    )}

    {otherPosts.length > 0 && (
      <section class="blog-list-section">
        <div class="container blog-list">
          {otherPosts.map((post) => (
            <article class="post-card">
              <a href={getPostUrl(post)}>
                {post.mainImage?.asset?.url && (
                  <img
                    src={post.mainImage.asset.url}
                    alt={post.mainImage.alt || ''}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div>
                  <span>{formatPostDate(post.publishedAt)}</span>
                  <h2>{post.title}</h2>
                  {post.excerpt && <p>{post.excerpt}</p>}
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<style>
  .blog-page {
    padding-top: 5.5rem;
    min-height: 70vh;
  }

  .blog-hero {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(2rem, 5vw, 4rem);
  }

  .blog-hero-inner {
    max-width: 760px;
  }

  .blog-hero h1 {
    max-width: 720px;
    margin-bottom: 1.15rem;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
  }

  .blog-hero p {
    max-width: 640px;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
  }

  .blog-featured,
  .blog-list-section,
  .blog-empty {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .featured-post {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: stretch;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .featured-post:hover,
  .post-card a:hover {
    transform: translateY(-2px);
    border-color: rgba(156, 100, 19, 0.45);
    box-shadow: 0 18px 45px rgba(38, 33, 21, 0.08);
  }

  .featured-post img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    background: var(--color-bg-alt);
  }

  .featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .featured-copy span,
  .post-card span {
    margin-bottom: 0.8rem;
    color: var(--color-accent-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-copy h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .featured-copy p {
    margin-bottom: 1.35rem;
    font-size: 1.05rem;
  }

  .featured-copy strong {
    color: var(--color-ink);
    font-size: 0.95rem;
  }

  .blog-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-bg-alt);
  }

  .post-card div {
    padding: 1.25rem;
  }

  .post-card h2 {
    margin-bottom: 0.65rem;
    font-size: 1.35rem;
  }

  .post-card p {
    font-size: 0.96rem;
  }

  .empty-inner {
    max-width: 620px;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .empty-inner h2 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  @media (max-width: 840px) {
    .featured-post,
    .blog-list {
      grid-template-columns: 1fr;
    }

    .featured-post img {
      min-height: 260px;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 560px) {
    .blog-page {
      padding-top: 4.75rem;
    }

    .blog-hero {
      padding-top: 3rem;
    }

    .featured-copy,
    .empty-inner {
      padding: 1.25rem;
    }
  }
</style>
