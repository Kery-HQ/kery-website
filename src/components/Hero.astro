---
import { COMING_SOON, SITE_GITHUB_URL } from '../constants';

const heroImage = '/mango-trees.jpg';
---

<section class="hero">
  <!-- Top: art only; bottom edge fades to white (same technique as paperclip.ing) -->
<div class="hero-art">
    <div class="hero-art-fade">
      <img
        src={heroImage}
        alt=""
        class="hero-photo"
        width="1408"
        height="768"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>

  <!-- Copy overlaps bottom of art slightly; gradient hands off to solid white for body + CTAs -->
  <div class="hero-copy">
    <div class="container hero-copy-inner">
      <h1 class="hero-headline">
        Browser tests<br />
        with proof.
      </h1>
      <p class="hero-subtitle">
        Agentic checks for real product flows.
      </p>
      {COMING_SOON ? (
        <div class="hero-countdown" aria-live="polite">
          <div class="hero-cd-row">
            <div class="hero-cd-cell">
              <span id="hero-cd-d" class="hero-cd-num">00</span>
              <span class="hero-cd-unit">d</span>
            </div>
            <span class="hero-cd-sep" aria-hidden="true">:</span>
            <div class="hero-cd-cell">
              <span id="hero-cd-h" class="hero-cd-num">00</span>
              <span class="hero-cd-unit">h</span>
            </div>
            <span class="hero-cd-sep" aria-hidden="true">:</span>
            <div class="hero-cd-cell">
              <span id="hero-cd-m" class="hero-cd-num">00</span>
              <span class="hero-cd-unit">m</span>
            </div>
            <span class="hero-cd-sep" aria-hidden="true">:</span>
            <div class="hero-cd-cell">
              <span id="hero-cd-s" class="hero-cd-num">00</span>
              <span class="hero-cd-unit">s</span>
            </div>
          </div>
        </div>
      ) : (
        <div class="hero-actions">
          <a href="#quickstart" class="hero-btn hero-btn-primary">Install Kery</a>
        </div>
      )}
      {!COMING_SOON && (
        <p class="hero-trust">
          Bring your own model provider. <a href={SITE_GITHUB_URL} class="hero-trust-link" target="_blank" rel="noopener noreferrer">Open-source on GitHub</a>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    text-align: center;
    background: var(--color-bg);
  }

  .hero-art {
    background: var(--color-bg);
  }

  /* Mask = soft vertical fade into the white page (no hard crop line) */
  .hero-art-fade {
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
    max-height: clamp(260px, 58vh, 640px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 65%, rgba(0, 0, 0, 0.7) 80%, rgba(0, 0, 0, 0.3) 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 65%, rgba(0, 0, 0, 0.7) 80%, rgba(0, 0, 0, 0.3) 90%, transparent 100%);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

.hero-photo {
    width: 100%;
    height: clamp(260px, 58vh, 640px);
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    margin-top: clamp(-6rem, -14vw, -11rem);
    padding: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 0%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 35%, transparent) 18%,
      color-mix(in srgb, var(--color-bg) 82%, transparent) 38%,
      var(--color-bg) 55%,
      var(--color-bg) 100%
    );
  }

  .hero-copy-inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: 4.68rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--color-text);
    margin-bottom: clamp(1rem, 2.5vw, 1.35rem);
    text-shadow:
      0 1px 0 color-mix(in srgb, var(--color-bg) 95%, transparent),
      0 0 19.2px color-mix(in srgb, var(--color-bg) 85%, transparent),
      0 2px 12px color-mix(in srgb, var(--color-bg) 60%, transparent);
  }

  .hero-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-shadow:
      0 0 0.4px var(--color-text-secondary),
      0 0 0.4px var(--color-text-secondary);
    margin-top: 0.25rem;
    margin-bottom: 1.75rem;
    max-width: 34rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-trust {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-top: 1.25rem;
    opacity: 0.7;
  }

  .hero-trust-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.15s;
  }

  .hero-trust-link:hover {
    opacity: 1;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-countdown {
    display: flex;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  .hero-cd-row {
    display: inline-flex;
    align-items: stretch;
    gap: 0.35rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  }

  .hero-cd-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    padding: 0.35rem 0.45rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-bg-alt) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .hero-cd-num {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.1;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .hero-cd-unit {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  .hero-cd-sep {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-accent-muted);
    opacity: 0.85;
    padding: 0 0.05rem;
  }

  /* Paperclip-style CTAs: dark primary, light bordered secondary */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.65rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .hero-btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
    border: 1px solid var(--color-text);
  }

  .hero-btn-primary:hover {
    background: var(--color-text-secondary);
    border-color: var(--color-text-secondary);
    transform: translateY(-1px);
  }

  .hero-btn-ghost {
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    font-size: 0.85rem;
    cursor: default;
  }

  @media (max-width: 640px) {
    .hero-photo {
      object-position: center 36%;
    }

    .hero-headline {
      font-size: clamp(2.52rem, 10.8vw, 4.68rem);
    }

    .hero-cd-row {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.5rem;
      padding: 0.55rem 0.65rem;
    }

    .hero-cd-sep {
      display: none;
    }

    .hero-cd-cell {
      min-width: 2.85rem;
      flex: 1 1 40%;
      max-width: 46%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-btn-primary:hover {
      transform: none;
    }

    .hero-photo {
      object-position: center center;
    }
  }
</style>

{COMING_SOON && (
  <script is:inline>
    (() => {
      const d = document.getElementById('hero-cd-d');
      const h = document.getElementById('hero-cd-h');
      const m = document.getElementById('hero-cd-m');
      const s = document.getElementById('hero-cd-s');
      if (!d || !h || !m || !s) return;
      const target = new Date('2026-05-03T00:00:00');

      const tick = () => {
        const diff = Math.max(0, target.getTime() - Date.now());
        const total = Math.floor(diff / 1000);
        const days = Math.floor(total / 86400);
        const hours = Math.floor((total % 86400) / 3600);
        const mins = Math.floor((total % 3600) / 60);
        const secs = total % 60;
        d.textContent = String(days).padStart(2, '0');
        h.textContent = String(hours).padStart(2, '0');
        m.textContent = String(mins).padStart(2, '0');
        s.textContent = String(secs).padStart(2, '0');
      };

      tick();
      setInterval(tick, 1000);
    })();
  </script>
)}
