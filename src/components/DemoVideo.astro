---
---

<section class="demo-section" id="demo">
  <div class="container">
    <div class="demo-frame reveal">
      <video id="demo-video" src="/kery-demo.mp4" playsinline preload="metadata"></video>
      <div class="demo-overlay" id="demo-overlay">
        <img class="demo-thumb" src="/kery-demo-thumb.jpg" alt="" aria-hidden="true" />
        <button class="demo-play" id="demo-play" aria-label="Play demo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v14l11-7-11-7z"/>
          </svg>
        </button>
      </div>
      <div class="demo-controls" id="demo-controls">
        <button class="ctrl-btn" id="ctrl-play" aria-label="Play/pause">
          <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v14l11-7-11-7z"/></svg>
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        </button>
        <div class="progress-wrap" id="progress-wrap">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <span class="ctrl-time" id="ctrl-time">0:00</span>
        <button class="ctrl-btn" id="ctrl-mute" aria-label="Mute">
          <svg class="icon-vol" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
          <svg class="icon-mute" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 18L19 19.27 20.27 18 5.27 3 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
        </button>
        <button class="ctrl-btn" id="ctrl-fs" aria-label="Fullscreen">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById('demo-video') as HTMLVideoElement;
  const overlay = document.getElementById('demo-overlay')!;
  const controls = document.getElementById('demo-controls')!;
  const playBtn = document.getElementById('demo-play')!;
  const ctrlPlay = document.getElementById('ctrl-play')!;
  const progressWrap = document.getElementById('progress-wrap')!;
  const progressBar = document.getElementById('progress-bar')!;
  const timeEl = document.getElementById('ctrl-time')!;
  const muteBtn = document.getElementById('ctrl-mute')!;
  const fsBtn = document.getElementById('ctrl-fs')!;

  function fmt(s: number) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60).toString().padStart(2, '0');
    return `${m}:${sec}`;
  }

  function setPlaying(playing: boolean) {
    (ctrlPlay.querySelector('.icon-play') as HTMLElement).style.display = playing ? 'none' : '';
    (ctrlPlay.querySelector('.icon-pause') as HTMLElement).style.display = playing ? '' : 'none';
  }

  playBtn.addEventListener('click', () => {
    overlay.classList.add('hidden');
    controls.classList.add('visible');
    video.play();
    setPlaying(true);
  });

  ctrlPlay.addEventListener('click', () => {
    if (video.paused) { video.play(); setPlaying(true); }
    else { video.pause(); setPlaying(false); }
  });

  video.addEventListener('ended', () => {
    setPlaying(false);
    overlay.classList.remove('hidden');
    controls.classList.remove('visible');
  });

  video.addEventListener('timeupdate', () => {
    const pct = video.duration ? (video.currentTime / video.duration) * 100 : 0;
    progressBar.style.width = pct + '%';
    timeEl.textContent = fmt(video.currentTime);
  });

  progressWrap.addEventListener('click', (e) => {
    const rect = progressWrap.getBoundingClientRect();
    video.currentTime = ((e.clientX - rect.left) / rect.width) * video.duration;
  });

  muteBtn.addEventListener('click', () => {
    video.muted = !video.muted;
    (muteBtn.querySelector('.icon-vol') as HTMLElement).style.display = video.muted ? 'none' : '';
    (muteBtn.querySelector('.icon-mute') as HTMLElement).style.display = video.muted ? '' : 'none';
  });

  fsBtn.addEventListener('click', () => {
    const frame = document.querySelector('.demo-frame') as HTMLElement;
    if (!document.fullscreenElement) frame.requestFullscreen();
    else document.exitFullscreen();
  });
</script>

<style>
  .demo-section {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    background: var(--color-bg);
  }

  .demo-frame {
    max-width: 860px;
    margin: 0 auto;
    aspect-ratio: 1760 / 1080;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0d0f0e;
    border: 1px solid #2a302c;
    position: relative;
  }

  .demo-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* overlay */
  .demo-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0f0e;
    transition: opacity 0.2s;
  }

  .demo-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .demo-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .demo-play {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: background 0.15s, transform 0.15s, color 0.15s;
  }

  .demo-play:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    transform: scale(1.08);
  }

  /* controls bar */
  .demo-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .demo-controls.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .demo-frame:hover .demo-controls.visible {
    opacity: 1;
  }

  .ctrl-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.75);
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: color 0.12s;
    flex-shrink: 0;
  }

  .ctrl-btn:hover { color: #fff; }

  .progress-wrap {
    flex: 1;
    height: 3px;
    background: rgba(255,255,255,0.15);
    border-radius: 2px;
    cursor: pointer;
    position: relative;
  }

  .progress-bar {
    height: 100%;
    width: 0%;
    background: rgba(255,255,255,0.75);
    border-radius: 2px;
    transition: width 0.1s linear;
  }

  .ctrl-time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(255,255,255,0.5);
    flex-shrink: 0;
  }
</style>
