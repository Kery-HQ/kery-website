<section class="demo-section" id="demo">
  <div class="container">
    <div class="demo-frame reveal">
      <iframe
        src="https://www.youtube.com/embed/XlHBvW5y2cI?rel=0&modestbranding=1"
        title="Kery demo"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .demo-section {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    background: var(--color-bg);
  }

  .demo-frame {
    max-width: 860px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0d0f0e;
    border: 1px solid #2a302c;
    position: relative;
  }

  .demo-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
