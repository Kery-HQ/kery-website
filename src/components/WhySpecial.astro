---
const nots = [
  {
    title: 'Not a magic black box.',
    desc: 'AI handles exploration, reasoning, and selector healing. Deterministic Playwright handles replay. You can read every line.',
  },
  {
    title: 'Not a SaaS.',
    desc: 'Self-hosted, Apache 2.0. Your data never leaves your infrastructure.',
  },
  {
    title: 'Not a no-code recorder.',
    desc: 'The output is clean, readable Playwright. Engineers can commit it, review it, and extend it.',
  },
  {
    title: 'Not pass/fail only.',
    desc: 'Every bug includes a screenshot, a bounding box, the step that triggered it, and a severity level.',
  },
];
---

<hr class="section-divider" />
<section class="diff-section section">
  <div class="container">
    <div class="reveal">
      <span class="section-badge">Scope</span>
      <h2>What Kery is not.</h2>
    </div>
    <div class="diff-grid reveal">
      {nots.map((n) => (
        <div class="diff-card">
          <h3>{n.title}</h3>
          <p>{n.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .special-section h2 {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .special-subtitle {
    margin-bottom: var(--space-xl);
  }

  .special-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .special-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .special-card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .special-card p {
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .diff-section h2 {
    margin-top: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .diff-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .diff-card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .diff-card p {
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .special-grid,
    .diff-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .special-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
