---
const bugTypes = [
  {
    color: '#ef4444',
    tag: 'Functional',
    desc: 'Buttons with no effect, forms that silently fail, broken state transitions, missing network calls.',
  },
  {
    color: '#a855f7',
    tag: 'Visual',
    desc: 'Element overlap, layout shifts, broken responsive design, z-index stacking, missing images.',
  },
  {
    color: '#f97316',
    tag: 'UX',
    desc: 'Dead click zones, missing loading states, empty states not handled, broken pagination.',
  },
  {
    color: '#06b6d4',
    tag: 'Accessibility',
    desc: 'No focus ring, missing aria labels, keyboard traps, interactive elements unreachable.',
  },
  {
    color: '#3b82f6',
    tag: 'HTTP Errors',
    desc: '4xx / 5xx responses, CORS failures, auth token expiry, API timeouts surfaced silently.',
  },
  {
    color: '#f59e0b',
    tag: 'Performance',
    desc: 'Slow time-to-interactive, render-blocking requests, memory growth, excessive re-renders.',
  },
  {
    color: '#22c55e',
    tag: 'Data',
    desc: 'Wrong values rendered, stale cache shown, missing fields, type errors surfacing in the UI.',
  },
  {
    color: '#71717a',
    tag: 'Console',
    desc: 'Uncaught exceptions, unhandled promise rejections, React warnings, silent errors logged.',
  },
];
---

<hr class="section-divider" />
<section class="bugtypes-section section">
  <div class="container">

    <div class="bt-layout reveal">
      <div class="bt-left">
        <span class="section-badge">Bug Detection</span>
        <h2>Not pass/fail.<br />Actual bugs.</h2>
        <p class="bt-lead">Screenshot, bounding box, step number, severity. Every finding is actionable.</p>
        <p class="bt-count">8 bug categories · 3 severity levels</p>
      </div>

      <div class="bt-right">
        {bugTypes.map((b) => (
          <div class="bt-item">
            <span class="bt-dot" style={`background:${b.color}`}></span>
            <div>
              <span class="bt-tag" style={`color:${b.color}`}>{b.tag}</span>
              <p class="bt-desc">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .bt-layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .bt-left {
    position: sticky;
    top: 6rem;
  }

  .bt-left h2 {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .bt-lead {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .bt-count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .bt-right {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .bt-item {
    display: flex;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: flex-start;
  }

  .bt-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .bt-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  .bt-tag {
    display: block;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    margin-bottom: 0.2rem;
  }

  .bt-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .bt-layout {
      grid-template-columns: 1fr;
    }

    .bt-left {
      position: static;
    }
  }
</style>
