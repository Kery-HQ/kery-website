---
const googleAnalyticsId =
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID || import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const postHogKey =
  import.meta.env.PUBLIC_POSTHOG_KEY || import.meta.env.PUBLIC_POSTHOG_PROJECT_API_KEY;
const postHogHost = (import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com').replace(/\/$/, '');
const enableVercelAnalytics =
  import.meta.env.PROD && import.meta.env.PUBLIC_VERCEL_ANALYTICS_DISABLED !== 'true';

const googleAnalyticsSnippet = googleAnalyticsId
  ? `
window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(googleAnalyticsId)});
`
  : '';

const postHogSnippet = postHogKey
  ? `
(function () {
  var key = ${JSON.stringify(postHogKey)};
  var host = ${JSON.stringify(postHogHost)};
  if (!key || window.__keryPostHogLoaded) return;

  window.__keryPostHogLoaded = true;

  var script = document.createElement('script');
  script.async = true;
  script.src = host + '/static/array.js';
  script.onload = function () {
    if (!window.posthog || typeof window.posthog.init !== 'function') return;
    window.posthog.init(key, {
      api_host: host,
      capture_pageview: true,
      capture_pageleave: true,
      person_profiles: 'identified_only'
    });
  };
  document.head.appendChild(script);
})();
`
  : '';
---

{googleAnalyticsId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
    <script is:inline set:html={googleAnalyticsSnippet} />
  </>
)}

{enableVercelAnalytics && (
  <script
    defer
    src="/_vercel/insights/script.js"
    data-sdkn="@vercel/analytics/astro"
    data-sdkv="1.6.1"
  />
)}

{postHogKey && <script is:inline set:html={postHogSnippet} />}
