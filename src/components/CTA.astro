---
import { SITE_GITHUB_URL } from '../constants';
---

<section class="cta-section" id="get-started">
  <div class="cta-bg"></div>
  <div class="container cta-inner reveal">
    <span class="section-badge cta-badge">Get started</span>
    <h2>Ship fast.<br />Break nothing.</h2>
    <div class="terminal cta-terminal">
      <div class="terminal-bar">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
      </div>
      <div class="terminal-body">
        <span class="terminal-prompt">$</span>
        <span class="terminal-cmd">npx keryai</span>
      </div>
    </div>
    <p class="cta-desc">
      Bring your own LLM · <a href={SITE_GITHUB_URL} class="cta-gh-link" target="_blank" rel="noopener noreferrer">Open-source · Apache 2.0</a>
    </p>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: var(--space-3xl) 0 var(--space-xl);
    text-align: center;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-accent-soft) 100%);
    z-index: 0;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
  }

  .cta-badge {
    background: var(--color-bg);
  }

  .cta-section h2 {
    margin-bottom: var(--space-lg);
  }

  .cta-terminal {
    max-width: 560px;
    margin: 0 auto var(--space-lg);
  }

  .terminal {
    background: #1a1a1a;
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
  }

  .terminal-bar {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    background: #222;
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #444;
  }

  .terminal-body {
    padding: 16px 20px 20px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #e0e0e0;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .terminal-prompt {
    color: #888;
  }

  .terminal-cmd {
    color: #f0f0f0;
    word-break: break-all;
  }

  .cta-desc {
    max-width: 520px;
    margin: 0 auto 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .cta-gh-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.15s;
  }

  .cta-gh-link:hover {
    opacity: 1;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .docs-link {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .docs-link:hover {
    color: var(--color-text);
  }
</style>
