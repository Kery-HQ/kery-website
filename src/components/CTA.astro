---
import { SITE_GITHUB_URL } from '../constants';
---

<section class="cta-section" id="get-started">
  <div class="cta-bg"></div>
  <div class="container cta-inner reveal">
    <span class="section-badge cta-badge">Get started</span>
    <h2>Clone, configure, compose.</h2>
    <div class="terminal cta-terminal">
      <div class="terminal-bar">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
      </div>
      <div class="terminal-body">
        <span class="terminal-prompt">$</span>
        <span class="terminal-cmd">git clone &lt;repo&gt; &amp;&amp; cd kery &amp;&amp; cp .env.example .env</span>
      </div>
    </div>
    <p class="cta-desc">
      Follow the README for LLM keys, database migrations, and optional local development without Docker.
      Star the repo to watch for releases and the hosted Kery waitlist.
    </p>
    <div class="cta-actions">
      <a href={SITE_GITHUB_URL} class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
        Open GitHub
      </a>
      <a href="/docs" class="docs-link">Documentation — coming soon &rarr;</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: var(--space-3xl) 0;
    text-align: center;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-accent-soft) 100%);
    z-index: 0;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
  }

  .cta-badge {
    background: var(--color-bg);
  }

  .cta-section h2 {
    margin-bottom: var(--space-lg);
  }

  .cta-terminal {
    max-width: 560px;
    margin: 0 auto var(--space-lg);
  }

  .terminal {
    background: #1a1a1a;
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
  }

  .terminal-bar {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    background: #222;
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #444;
  }

  .terminal-body {
    padding: 16px 20px 20px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #e0e0e0;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .terminal-prompt {
    color: #888;
  }

  .terminal-cmd {
    color: #f0f0f0;
    word-break: break-all;
  }

  .cta-desc {
    max-width: 520px;
    margin: 0 auto var(--space-lg);
    font-size: 0.9rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .docs-link {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .docs-link:hover {
    color: var(--color-text);
  }
</style>
