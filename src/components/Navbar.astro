---
import { SITE_LOGO_URL, SITE_DISCORD_URL, SITE_GITHUB_URL, SITE_CLOUD_URL } from '../constants';
---

<nav class="navbar" aria-label="Primary navigation">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="Kery home">
      <img
        src={SITE_LOGO_URL}
        alt=""
        width="36"
        height="36"
        class="navbar-logo-img"
        decoding="async"
      />
      <span class="navbar-logo-text">Kery</span>
    </a>

    <div class="navbar-links">
      <a href="/#product" class="nav-link">Product</a>
      <a href="/#demo" class="nav-link">Demo</a>
      <a href="/#cloud" class="nav-link">Cloud</a>
      <a href="/blog" class="nav-link">Blog</a>
    </div>

    <div class="navbar-actions">
      <a href="/#install" class="nav-link nav-install">Install</a>
      <a href={SITE_GITHUB_URL} class="icon-link nav-github" target="_blank" rel="noopener noreferrer" aria-label="Open Kery on GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.15c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.98 10.98 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.08 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.79.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <a href={SITE_DISCORD_URL} class="icon-link nav-discord" target="_blank" rel="noopener noreferrer" aria-label="Join the Kery Discord">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
      </a>
      <a href={SITE_CLOUD_URL} class="nav-link nav-start-free">Start free</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(38, 33, 21, 0.1);
    background: rgba(255, 253, 246, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .navbar-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    width: min(1180px, calc(100vw - 2rem));
    min-height: 4.25rem;
    margin: 0 auto;
  }

  .navbar-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: var(--color-ink);
    font-weight: 850;
    letter-spacing: -0.01em;
  }

  .navbar-logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    image-rendering: auto;
  }

  .navbar-logo-text {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 850;
    line-height: 1;
  }

  .navbar-links,
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .navbar-links {
    justify-content: center;
  }

  .navbar-actions {
    justify-content: flex-end;
  }

  .nav-link,
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.3rem;
    padding: 0 0.72rem;
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    font-weight: 700;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .icon-link:hover {
    background: var(--color-bg-alt);
    color: var(--color-ink);
  }

  .nav-install {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .nav-github {
    width: 2.3rem;
    padding: 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .nav-github:hover {
    background: var(--color-bg-alt);
    color: var(--color-ink);
  }

  .nav-start-free {
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: #fffdf6;
  }

  .nav-start-free:hover {
    background: #000;
    color: #fffdf6;
  }

  .nav-discord {
    width: 2.3rem;
    padding: 0;
    background: #5865f2;
    color: #fff;
  }

  .nav-discord:hover {
    background: #4752c4;
    color: #fff;
  }

  @media (max-width: 840px) {
    .navbar-inner {
      grid-template-columns: auto 1fr;
      min-height: 3.8rem;
    }

    .navbar-links {
      display: none;
    }

    .navbar-actions {
      min-width: 0;
    }
  }

  @media (max-width: 520px) {
    .navbar-inner {
      width: min(100vw - 1rem, 1180px);
      gap: 0.4rem;
      grid-template-columns: minmax(max-content, auto) auto;
      justify-content: space-between;
    }

    .nav-install {
      display: none;
    }

    .navbar-logo-text {
      display: inline-flex !important;
    }
  }
</style>
