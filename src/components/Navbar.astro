---
import { SITE_LOGO_URL, SITE_DISCORD_URL } from '../constants';
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <img
        src={SITE_LOGO_URL}
        alt=""
        width="26"
        height="26"
        class="navbar-logo-img"
        decoding="async"
      />
    </a>
    <div class="navbar-links">
      <a href="#demo" class="nav-link">Demo</a>
      <a href="#quickstart" class="nav-link">How it works</a>
      <a href="#get-started" class="nav-link">Get started</a>
      <a href={SITE_DISCORD_URL} class="nav-link nav-discord" target="_blank" rel="noopener noreferrer" aria-label="Join Discord">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
      </a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: auto;
    max-width: calc(100vw - 2rem);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.45rem 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 999px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
    font-size: 0.875rem;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.5rem 0.25rem 0;
    font-family: inherit;
    font-weight: 600;
    color: #111;
    font-size: 0.95rem;
    margin-right: 0.5rem;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
    padding-right: 0.85rem;
    flex-shrink: 0;
  }

  .navbar-logo-img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    color: #555;
    font-family: "Instrument Serif", serif;
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #111;
  }

  .nav-discord {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #5865F2;
  }

  .nav-discord:hover {
    background: rgba(88, 101, 242, 0.08);
    color: #5865F2;
  }

  @media (max-width: 480px) {
    .nav-link:nth-child(2) {
      display: none;
    }

    .navbar-logo {
      padding-right: 0.5rem;
      margin-right: 0.25rem;
    }

    .nav-link {
      padding: 0.35rem 0.75rem;
      font-size: 0.875rem;
    }

    .navbar-inner {
      padding-left: 0.6rem;
      gap: 0.15rem;
    }
  }
</style>
