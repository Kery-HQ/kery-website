---
import { COMING_SOON, SITE_GITHUB_URL, SITE_LOGO_URL } from '../constants';
---

<nav class="navbar">
  <div class:list={['navbar-inner', { 'navbar-inner--with-actions': !COMING_SOON }]}>
    <a href="/" class="navbar-logo">
      <img
        src={SITE_LOGO_URL}
        alt=""
        width="28"
        height="28"
        class="navbar-logo-img"
        decoding="async"
      />
      <span class="navbar-logo-text">Kery</span>
    </a>
    {!COMING_SOON && (
      <>
        <div class="navbar-links">
          <a href="/docs" class="nav-link">Get Started</a>
        </div>
        <a href={SITE_GITHUB_URL} class="star-btn">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
          <span class="star-text">Star</span>
          <span class="star-count" aria-label="GitHub stars (placeholder)">-</span>
        </a>
      </>
    )}
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: auto;
    max-width: calc(100vw - 2rem);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.4rem 0.4rem 0.75rem;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12.8px);
    -webkit-backdrop-filter: blur(12.8px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    gap: 0;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
    margin-right: 0;
  }

  .navbar-inner--with-actions .navbar-logo {
    margin-right: 1.25rem;
  }

  .navbar-logo-img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex-shrink: 0;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .navbar-logo-text {
    line-height: 1;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    transition: all 0.2s;
    font-weight: 450;
  }

  .nav-link:hover {
    background: var(--color-bg-alt);
    color: var(--color-text);
  }

  .star-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: 0.8rem;
    transition: background 0.2s;
    margin-left: 0.35rem;
    flex-shrink: 0;
  }

  .star-btn:hover {
    background: var(--color-accent-hover);
  }

  .star-count {
    padding-left: 0.4rem;
    border-left: 1px solid rgba(255,255,255,0.2);
  }

  /* Mobile: hide all text links, icon-only star button */
  @media (max-width: 540px) {
    .navbar-inner {
      padding: 0.4rem 0.4rem 0.4rem 0.65rem;
      gap: 0;
    }

    .navbar-logo {
      margin-right: 0.4rem;
    }

    .navbar-links {
      display: none;
    }

    .star-btn {
      margin-left: 0.35rem;
      padding: 0.45rem 0.7rem;
    }

    .star-text {
      display: none;
    }

    .star-count {
      display: none;
    }
  }

  /* Small phone: drop logo text too */
  @media (max-width: 360px) {
    .navbar-logo-text {
      display: none;
    }

    .navbar-logo {
      margin-right: 0.15rem;
    }
  }
</style>
