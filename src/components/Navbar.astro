---
import { SITE_GITHUB_URL, SITE_LOGO_URL } from '../constants';
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <img
        src={SITE_LOGO_URL}
        alt=""
        width="28"
        height="28"
        class="navbar-logo-img"
        decoding="async"
      />
      <span class="navbar-logo-text">Kery</span>
    </a>
    <div class="navbar-links">
      <a href="/blog" class="nav-link">Blog</a>
      <a href="/docs" class="nav-link">Docs</a>
      <a href={SITE_GITHUB_URL} class="nav-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
    </div>
    <a href={SITE_GITHUB_URL} class="star-btn">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
      Star
      <span class="star-count" aria-label="GitHub stars (placeholder)">—</span>
    </a>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: auto;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.4rem 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12.8px);
    -webkit-backdrop-filter: blur(12.8px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    gap: 0;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
    margin-right: 1.25rem;
  }

  .navbar-logo-img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex-shrink: 0;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .navbar-logo-text {
    line-height: 1;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    transition: all 0.2s;
    font-weight: 450;
  }

  .nav-link:hover {
    background: var(--color-bg-alt);
    color: var(--color-text);
  }

  .nav-link:last-child {
    margin-left: 0.75rem;
  }

  .star-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: 0.8rem;
    transition: background 0.2s;
    margin-left: 0.35rem;
    flex-shrink: 0;
  }

  .star-btn:hover {
    background: var(--color-accent-hover);
  }

  .star-count {
    padding-left: 0.4rem;
    border-left: 1px solid rgba(255,255,255,0.2);
  }

  @media (max-width: 640px) {
    .navbar-inner {
      min-width: auto;
      padding: 0.45rem 0.5rem 0.45rem 0.65rem;
    }
    .navbar-logo {
      margin-right: 0.5rem;
    }
    .navbar-links .nav-link:not(:last-child) {
      display: none;
    }
    .star-btn {
      margin-left: 0.5rem;
    }
  }
</style>
