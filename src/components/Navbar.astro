---
import { SITE_LOGO_URL, SITE_DISCORD_URL, SITE_GITHUB_URL } from '../constants';
---

<nav class="navbar" aria-label="Primary navigation">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="Kery home">
      <img
        src={SITE_LOGO_URL}
        alt=""
        width="30"
        height="30"
        class="navbar-logo-img"
        decoding="async"
      />
      <span>Kery</span>
    </a>

    <div class="navbar-links">
      <a href="/#product" class="nav-link">Product</a>
      <a href="/#demo" class="nav-link">Demo</a>
      <a href="/#cloud" class="nav-link">Cloud</a>
      <a href="/blog" class="nav-link">Blog</a>
    </div>

    <div class="navbar-actions">
      <a href="/#install" class="nav-link nav-install">Install</a>
      <a href={SITE_GITHUB_URL} class="icon-link nav-github" target="_blank" rel="noopener noreferrer" aria-label="Star Kery on GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.25 2.96 6 6.62.96-4.79 4.67 1.13 6.59L12 17.36l-5.92 3.11 1.13-6.59-4.79-4.67 6.62-.96L12 2.25z"/></svg>
        <span>Star</span>
      </a>
      <a href={SITE_DISCORD_URL} class="icon-link nav-discord" target="_blank" rel="noopener noreferrer" aria-label="Join the Kery Discord">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
      </a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(38, 33, 21, 0.1);
    background: rgba(255, 253, 246, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .navbar-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    width: min(1180px, calc(100vw - 2rem));
    min-height: 4.25rem;
    margin: 0 auto;
  }

  .navbar-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: var(--color-ink);
    font-weight: 850;
    letter-spacing: -0.01em;
  }

  .navbar-logo-img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .navbar-links,
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .navbar-links {
    justify-content: center;
  }

  .navbar-actions {
    justify-content: flex-end;
  }

  .nav-link,
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.3rem;
    padding: 0 0.72rem;
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    font-weight: 700;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .icon-link:hover {
    background: var(--color-bg-alt);
    color: var(--color-ink);
  }

  .nav-install {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .nav-github {
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: #fffdf6;
  }

  .nav-github:hover {
    background: #000;
    color: #fffdf6;
  }

  .nav-discord {
    width: 2.3rem;
    padding: 0;
    background: #5865f2;
    color: #fff;
  }

  .nav-discord:hover {
    background: #4752c4;
    color: #fff;
  }

  @media (max-width: 840px) {
    .navbar-inner {
      grid-template-columns: auto 1fr;
      min-height: 3.8rem;
    }

    .navbar-links {
      display: none;
    }

    .navbar-actions {
      min-width: 0;
    }
  }

  @media (max-width: 520px) {
    .navbar-inner {
      width: min(100vw - 1rem, 1180px);
      gap: 0.4rem;
    }

    .navbar-logo span,
    .nav-install,
    .nav-github span {
      display: none;
    }

    .nav-github {
      width: 2.3rem;
      padding: 0;
    }
  }
</style>
