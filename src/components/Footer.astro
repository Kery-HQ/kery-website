---
import { SITE_LOGO_URL, SITE_DISCORD_URL, SITE_GITHUB_URL, SITE_TAGLINE } from '../constants';
---

<footer class="kery-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img
        src={SITE_LOGO_URL}
        alt=""
        width="36"
        height="36"
        class="footer-logo-img"
        loading="lazy"
        decoding="async"
      />
      <div>
        <strong>Kery</strong>
        <span>{SITE_TAGLINE}</span>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/#product">Product</a>
      <a href="/#cloud">Cloud</a>
      <a href="/blog">Blog</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE_DISCORD_URL} target="_blank" rel="noopener noreferrer">Discord</a>
    </nav>
  </div>
  <div class="container footer-copyright">
    © {new Date().getFullYear()} Kery. All rights reserved.
  </div>
</footer>

<style>
  .kery-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .footer-copyright {
    padding: 0 0 1.25rem;
    font-size: 0.8rem;
    color: var(--color-text-muted, #8a8a8a);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    min-width: 0;
  }

  .footer-logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .footer-brand strong,
  .footer-brand span {
    display: block;
  }

  .footer-brand strong {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 850;
  }

  .footer-brand span {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .footer-links a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 760px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      justify-content: flex-start;
    }
  }
</style>
