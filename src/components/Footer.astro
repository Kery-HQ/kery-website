---
import { SITE_GITHUB_URL, SITE_LOGO_URL } from '../constants';

const columns = [
  {
    title: 'Product',
    links: [
      { text: 'Get started', href: '#get-started' },
      { text: 'MCP & agents', href: '#mcp' },
      { text: 'Quickstart', href: '#quickstart' },
    ],
  },
  {
    title: 'Platform',
    links: [
      { text: 'Self-host (OSS)', href: SITE_GITHUB_URL },
      { text: 'Hosted Kery', href: '#get-started' },
      { text: 'Dashboard', href: SITE_GITHUB_URL },
    ],
  },
  {
    title: 'Developers',
    links: [
      { text: 'Documentation', href: '/docs' },
      { text: 'Blog', href: '/blog' },
      { text: 'GitHub', href: SITE_GITHUB_URL },
    ],
  },
  {
    title: 'Legal',
    links: [
      { text: 'Privacy', href: '/privacy' },
      { text: 'Terms', href: '/terms' },
      { text: 'License (Apache 2.0)', href: `${SITE_GITHUB_URL}/blob/main/LICENSE` },
    ],
  },
];
---

<footer class="kery-footer">
  <div class="footer-inner">
    <div class="container footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <img
            src={SITE_LOGO_URL}
            alt=""
            width="32"
            height="32"
            class="footer-logo-img"
            loading="lazy"
            decoding="async"
          />
          <span class="footer-logo-text">Kery</span>
        </div>
        <p class="footer-tagline">AI browser testing<br />with MCP for your editor.</p>
      </div>
      {columns.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.text}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="container footer-bottom">
      <span>&copy; {new Date().getFullYear()} Kery. Open source under Apache 2.0.</span>
      <div class="footer-legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .kery-footer {
    margin-top: 0;
  }

  .footer-inner {
    background: #141816;
    color: #ffffff;
    padding: 4rem 0 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 2rem;
    padding-bottom: 3rem;
  }

  .footer-brand {
    padding-right: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    color: #ffffff;
    margin-bottom: 0.6rem;
  }

  .footer-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .footer-logo-text {
    line-height: 1;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4) !important;
    line-height: 1.5;
  }

  .footer-col h4 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    margin-bottom: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-accent-muted);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.25);
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.25);
    transition: color 0.2s;
  }

  .footer-legal a:hover {
    color: var(--color-accent-muted);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
