---
import { SITE_LOGO_URL } from '../constants';
---

<footer class="kery-footer">
  <div class="footer-inner">
    <div class="container footer-content">
      <div class="footer-brand">
        <img
          src={SITE_LOGO_URL}
          alt="Kery"
          width="64"
          height="64"
          class="footer-logo-img"
          loading="lazy"
          decoding="async"
        />
        <span class="footer-wordmark">Kery</span>
      </div>
      <p class="footer-tagline">AI agents that test your web app and find bugs.</p>
      <span class="footer-copy">&copy; {new Date().getFullYear()} Kery.</span>
    </div>
  </div>
</footer>

<style is:global>
  .kery-footer {
    margin-top: 0;
  }

  .footer-inner {
    background: #141816;
    padding: 4rem 0 3rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    opacity: 0.9;
  }

  .footer-wordmark {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 2.75rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #e8855a;
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.5;
    max-width: 340px;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.2);
    margin-top: 0.5rem;
  }
</style>
