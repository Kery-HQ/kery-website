---
const faqs = [
  {
    q: 'Do I need test scripts to start?',
    a: 'No. The Navigator agent drives a Playwright browser using the accessibility tree and screenshots. It maps the app, plans a path, and reports what happened.',
  },
  {
    q: 'What happens when the DOM changes?',
    a: 'Kery retries element lookup by intent instead of relying only on a stale selector. Useful flows keep running through routine UI changes.',
  },
  {
    q: 'Which LLM providers are supported?',
    a: 'OpenRouter (recommended), OpenAI, Anthropic, and Google Gemini. Navigator, Review, Auxiliary, and Stagehand roles are each configurable independently so you can optimize cost and quality per task.',
  },
  {
    q: 'Does it work behind authentication?',
    a: 'Yes. Kery supports form-based login, Clerk, Supabase, Auth0, and Firebase Auth out of the box. Set credentials once in the dashboard and every run authenticates automatically.',
  },
  {
    q: 'Can I run Kery in CI?',
    a: 'Yes. Use the TypeScript client SDK or trigger runs via the REST API from any pipeline. Results come back as structured JSON you can parse, diff, or fail a build on.',
  },
  {
    q: 'What can I do with MCP?',
    a: 'Scan your app, run tests, pull bug reports, and browse route coverage directly from Claude, Cursor, or any MCP-compatible editor. Over 20 tools available including kery_scan, kery_get_bugs, kery_list_routes, and more.',
  },
  {
    q: 'Does Kery get smarter over time?',
    a: 'Yes. The memory curator agent learns successful navigation paths and records known false positives after each run. Confidence scores decay over time so memory stays fresh, not compounding.',
  },
  {
    q: 'Where does my data live?',
    a: 'Kery is fully self-hosted. Screenshots, run history, and bug reports live in your own PostgreSQL instance. Nothing leaves your environment except the prompts sent to your LLM provider.',
  },
  {
    q: 'Is Kery open-source?',
    a: 'Yes. Kery is designed for self-hosted use, with Apache 2.0 licensing and bring-your-own model providers.',
  },
];
import HangingMango from './HangingMango.astro';
---

<hr class="section-divider" />
<section class="faq-section section">
  <HangingMango left="18%" wire={58} delay={0.6} />
  <div class="container">
    <div class="reveal">
      <span class="section-badge">FAQ</span>
      <h2>What teams ask first.</h2>
    </div>
    <div class="faq-list reveal">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-question">{faq.q}</summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    position: relative;
    overflow: hidden;
  }

  .faq-section h2 {
    margin-top: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-question {
    padding: 1.1rem 0;
    cursor: pointer;
    font-weight: 500;
    font-size: 1rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding-bottom: 1.1rem;
  }

  .faq-answer p {
    font-size: 0.95rem;
    line-height: 1.65;
  }
</style>
