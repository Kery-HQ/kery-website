---
const features = [
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>`,
    label: 'CI/CD',
    detail: 'GitHub & Vercel',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>`,
    label: 'Integrations',
    detail: 'Linear, Slack & more',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    label: 'MCP Access',
    detail: 'Any agent, anywhere',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    label: 'Scheduled runs',
    detail: 'Cron-based monitoring',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
    label: 'Regression detection',
    detail: 'Catch breaks on every deploy',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    label: 'Team workspace',
    detail: 'Shared runs & reports',
  },
];
---

<section class="waitlist-section section" id="cloud">
  <div class="container">
    <div class="waitlist-inner">
      <div class="waitlist-header reveal">
        <span class="section-badge">Kery Cloud</span>
        <h2>Kery Cloud</h2>
        <p class="waitlist-sub">Managed browser workers, shared review, scheduled checks, and CI gates for teams that do not want to run the test stack.</p>
      </div>

      <div class="features-grid reveal">
        {features.map(f => (
          <div class="feature-chip">
            <span class="feature-icon" set:html={f.icon} />
            <span class="feature-text">
              <span class="feature-label">{f.label}</span>
              <span class="feature-detail">{f.detail}</span>
            </span>
          </div>
        ))}
      </div>

      <div class="waitlist-form-wrap reveal">
        <form class="waitlist-form" id="waitlist-form" novalidate>
          <input
            type="email"
            name="email"
            id="waitlist-email"
            class="waitlist-input"
            placeholder="your@email.com"
            autocomplete="email"
            required
          />
          <button type="submit" class="waitlist-submit" id="waitlist-btn">
            <span class="btn-label">Request access</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
        </form>
        <p class="waitlist-status" id="waitlist-status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const emailInput = document.getElementById('waitlist-email') as HTMLInputElement;
  const btn = document.getElementById('waitlist-btn') as HTMLButtonElement;
  const status = document.getElementById('waitlist-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email) return;

    btn.dataset.loading = 'true';
    btn.disabled = true;
    status.textContent = '';
    status.className = 'waitlist-status';

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();

      if (res.ok) {
        if (data.alreadyJoined) {
          setStatus("You're already on the list. We'll be in touch.", 'info');
        } else {
          setStatus("You're on the list. Check your inbox for a confirmation.", 'success');
          form.reset();
        }
      } else {
        setStatus(data.error ?? 'Something went wrong. Please try again.', 'error');
      }
    } catch {
      setStatus('Network error. Please try again.', 'error');
    } finally {
      btn.dataset.loading = '';
      btn.disabled = false;
    }
  });

  function setStatus(msg: string, type: 'success' | 'error' | 'info') {
    status.textContent = msg;
    status.className = `waitlist-status waitlist-status--${type}`;
  }
</script>

<style>
  .waitlist-section {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .waitlist-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .waitlist-header {
    text-align: center;
  }

  .waitlist-header h2 {
    margin-top: 0.5rem;
  }

  .waitlist-sub {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Feature chips */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }

  .feature-chip {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .feature-icon {
    flex-shrink: 0;
    color: var(--color-accent);
    display: flex;
    align-items: center;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .feature-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feature-detail {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Form */
  .waitlist-form-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .waitlist-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    max-width: 440px;
  }

  .waitlist-input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    transition: border-color 0.15s;
    outline: none;
  }

  .waitlist-input::placeholder {
    color: var(--color-text-muted);
  }

  .waitlist-input:focus {
    border-color: var(--color-accent);
  }

  .waitlist-submit {
    flex-shrink: 0;
    position: relative;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.15s, transform 0.1s;
    cursor: pointer;
    border: none;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .waitlist-submit:hover:not(:disabled) {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .waitlist-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Spinner */
  .btn-spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.65s linear infinite;
  }

  [data-loading='true'] .btn-label { display: none; }
  [data-loading='true'] .btn-spinner { display: block; }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Status messages */
  .waitlist-status {
    font-size: 0.82rem;
    min-height: 1.2em;
    text-align: center;
    color: transparent;
  }

  .waitlist-status--success { color: #6ecf8e; }
  .waitlist-status--error   { color: #f08080; }
  .waitlist-status--info    { color: var(--color-text-muted); }

  @media (max-width: 560px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .waitlist-form {
      flex-direction: column;
    }

    .waitlist-submit {
      width: 100%;
    }
  }

  @media (max-width: 340px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
