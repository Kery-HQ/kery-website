---
const problems = [
  {
    pain: 'You shipped. You have no idea if it works.',
    fix:  'One sentence. Kery opens a real browser, maps your flows, files a report.',
  },
  {
    pain: 'Writing Playwright takes longer than building the feature.',
    fix:  '~$0.02 first run. Deterministic replay after. Zero selectors written by hand.',
  },
  {
    pain: 'Selectors break on every deploy. Auth walls block the runner.',
    fix:  'Broken selectors heal mid-run. Clerk, Supabase, OAuth, TOTP - all native.',
  },
  {
    pain: 'Your users are finding the bugs.',
    fix:  '8 bug categories, 3 severity levels, screenshot + bounding box per finding.',
  },
];
---

<hr class="section-divider" />
<section class="problems-section section">
  <div class="container">
    <div class="reveal">
      <span class="section-badge">The problem</span>
      <h2>Sound familiar?</h2>
    </div>

    <div class="problem-list reveal">
      {problems.map((p, i) => (
        <div class="problem-item">
          <div class="problem-head">
            <span class="p-num">0{i + 1}</span>
          </div>

          <div class="problem-col problem-col-pain">
            <span class="problem-kicker">What breaks</span>
            <p class="p-pain">{p.pain}</p>
          </div>

          <div class="problem-col problem-col-fix">
            <span class="problem-kicker">What Kery changes</span>
            <p class="p-fix">{p.fix}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .problems-section h2 {
    margin-top: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  /* ── list ────────────────────────────────────────── */
  .problem-list {
    display: grid;
    gap: 0.9rem;
  }

  .problem-item {
    display: grid;
    grid-template-columns: 2.75rem 1fr 1fr;
    gap: 0 1rem;
    align-items: start;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .problem-head {
    padding: 1.15rem 0 0 1rem;
  }

  .p-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    padding-top: 0.25rem;
    letter-spacing: 0.04em;
  }

  .problem-col {
    padding: 1.1rem 1rem 1.15rem;
  }

  .problem-col-pain {
    border-right: 1px solid var(--color-border);
  }

  .problem-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.55rem;
  }

  .p-pain {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    font-weight: 450;
    margin: 0;
  }

  .p-fix {
    font-size: 0.92rem;
    line-height: 1.58;
    color: var(--color-text);
    margin: 0;
  }

  .problem-col-fix .problem-kicker {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .problem-item {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .problem-head {
      padding: 0.85rem 1rem 0;
    }

    .problem-col {
      padding: 0.75rem 1rem 1rem;
    }

    .problem-col-pain {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
