---
import { SITE_GITHUB_URL } from '../constants';
---

<section class="getrunning-section section" id="quickstart">
  <div class="container">
    <div class="getrunning-header reveal">
      <span class="section-badge">Get running</span>
      <h2>Up in three commands.<br />Connected in one config.</h2>
    </div>

    <div class="gr-stack reveal">

      <!-- Step 1: self-host -->
      <div class="gr-step">
        <div class="gr-step-label">
          <span class="gr-step-num">01</span>
          <span class="gr-step-title">Self-host</span>
        </div>
        <div class="gr-terminal">
          <div class="gr-terminal-bar">
            <span class="gr-dot"></span>
            <span class="gr-dot"></span>
            <span class="gr-dot"></span>
            <span class="gr-terminal-title">bash</span>
          </div>
          <div class="gr-terminal-body">
            <div class="gr-line">
              <span class="gr-prompt">$</span>
              <span class="gr-cmd">git clone https://github.com/kery-dev/kery <span class="gr-op">&amp;&amp;</span> cd kery</span>
            </div>
            <div class="gr-line">
              <span class="gr-prompt">$</span>
              <span class="gr-cmd">docker compose up</span>
            </div>
            <div class="gr-line">
              <span class="gr-comment"># Open localhost:3000</span>
            </div>
          </div>
        </div>
        <div class="gr-step-footer">
          <p class="gr-note">Apache 2.0 · runs on your infrastructure · your Postgres, your data</p>
          <a href={SITE_GITHUB_URL} class="btn btn-primary gr-cta">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            View on GitHub
          </a>
        </div>
      </div>

      <div class="gr-divider"></div>

      <!-- Step 2: MCP config -->
      <div class="gr-step">
        <div class="gr-step-label">
          <span class="gr-step-num">02</span>
          <span class="gr-step-title">Connect your editor via MCP</span>
        </div>
        <div class="gr-terminal">
          <div class="gr-terminal-bar">
            <span class="gr-dot"></span>
            <span class="gr-dot"></span>
            <span class="gr-dot"></span>
            <span class="gr-terminal-title">mcp.json</span>
          </div>
          <div class="gr-terminal-body gr-json-body">
<pre class="gr-pre"><span class="gr-brace">{</span>
  <span class="gr-key">"mcpServers"</span><span class="gr-colon">:</span> <span class="gr-brace">{</span>
    <span class="gr-key">"kery"</span><span class="gr-colon">:</span> <span class="gr-brace">{</span>
      <span class="gr-key">"command"</span><span class="gr-colon">:</span> <span class="gr-str">"npx"</span><span class="gr-punct">,</span>
      <span class="gr-key">"args"</span><span class="gr-colon">:</span> <span class="gr-str">["kery-mcp"]</span><span class="gr-punct">,</span>
      <span class="gr-key">"env"</span><span class="gr-colon">:</span> <span class="gr-brace">{</span>
        <span class="gr-key">"KERY_API_URL"</span><span class="gr-colon">:</span> <span class="gr-str">"http://localhost:19833"</span>
      <span class="gr-brace">}</span>
    <span class="gr-brace">}</span>
  <span class="gr-brace">}</span>
<span class="gr-brace">}</span></pre>
          </div>
        </div>
        <div class="gr-step-footer">
          <p class="gr-note">Works with any MCP-compatible editor or agent</p>
          <div class="ide-icons-row">
            <!-- Claude -->
            <div class="ide-icon-item">
              <div class="ide-icon-wrap ide-claude">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                  <line x1="12" y1="4" x2="12" y2="20"/>
                  <line x1="4" y1="12" x2="20" y2="12"/>
                  <line x1="6.34" y1="6.34" x2="17.66" y2="17.66"/>
                  <line x1="17.66" y1="6.34" x2="6.34" y2="17.66"/>
                </svg>
              </div>
              <span class="ide-icon-label">Claude</span>
            </div>
            <!-- Cursor -->
            <div class="ide-icon-item">
              <div class="ide-icon-wrap ide-cursor">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.5 3.5l14.5 8.5-8 2-2 8z"/>
                </svg>
              </div>
              <span class="ide-icon-label">Cursor</span>
            </div>
            <!-- GitHub Copilot -->
            <div class="ide-icon-item">
              <div class="ide-icon-wrap ide-github">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
              </div>
              <span class="ide-icon-label">Copilot</span>
            </div>
            <!-- Codex -->
            <div class="ide-icon-item">
              <div class="ide-icon-wrap ide-openai">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              </div>
              <span class="ide-icon-label">Codex</span>
            </div>
            <!-- ChatGPT -->
            <div class="ide-icon-item">
              <div class="ide-icon-wrap ide-chatgpt">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </div>
              <span class="ide-icon-label">ChatGPT</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .getrunning-section {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .getrunning-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .getrunning-header h2 {
    margin-top: 0.5rem;
  }

  .gr-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 680px;
    margin: 0 auto;
  }

  .gr-step {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gr-step-label {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .gr-step-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.06em;
  }

  .gr-step-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .gr-step-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .gr-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-xl) 0;
  }

  .gr-terminal {
    background: #141816;
    border: 1px solid #2a302c;
    border-radius: var(--radius);
    overflow: clip;
  }

  .gr-terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 16px;
    background: #1c211e;
    border-bottom: 1px solid #2a302c;
  }

  .gr-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #444;
    flex-shrink: 0;
  }

  .gr-terminal-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #6b756f;
    letter-spacing: 0.04em;
  }

  .gr-terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: #e2e8e4;
  }

  .gr-json-body {
    padding: 1.25rem 1.5rem;
  }

  .gr-pre {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.75;
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .gr-line {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
  }

  .gr-prompt {
    color: #6b756f;
    flex-shrink: 0;
    user-select: none;
  }

  .gr-cmd {
    color: #e2e8e4;
    min-width: 0;
    word-break: break-word;
  }

  .gr-op {
    color: #9bc4a8;
  }

  .gr-comment {
    color: #4a5550;
  }

  .gr-key   { color: #e8b09a; }
  .gr-str   { color: #9bc4a8; }
  .gr-colon { color: #6b756f; }
  .gr-brace { color: #c5ccc7; }
  .gr-punct { color: #6b756f; }

  .gr-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .gr-cta {
    flex-shrink: 0;
  }

  /* IDE icon row */
  .ide-icons-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .ide-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .ide-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-secondary);
    transition: border-color 0.2s, color 0.2s;
  }

  .ide-icon-item:hover .ide-icon-wrap {
    border-color: var(--color-accent-muted);
    color: var(--color-text);
  }

  .ide-claude  { --icon-accent: #d97706; }
  .ide-cursor  { --icon-accent: #6366f1; }
  .ide-github  { --icon-accent: var(--color-text); }
  .ide-openai  { --icon-accent: #10b981; }
  .ide-chatgpt { --icon-accent: #10b981; }

  .ide-icon-item:hover .ide-claude  { color: #d97706; border-color: #d9770640; }
  .ide-icon-item:hover .ide-cursor  { color: #6366f1; border-color: #6366f140; }
  .ide-icon-item:hover .ide-github  { color: var(--color-text); }
  .ide-icon-item:hover .ide-openai  { color: #10b981; border-color: #10b98140; }
  .ide-icon-item:hover .ide-chatgpt { color: #10b981; border-color: #10b98140; }

  .ide-icon-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .gr-step-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
