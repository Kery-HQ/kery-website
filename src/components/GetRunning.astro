---
import { SITE_GITHUB_URL } from '../constants';
---

<section class="getrunning-section section" id="quickstart">
  <div class="container">
    <div class="getrunning-header reveal">
      <span class="section-badge">Get running</span>
      <h2>One command to start.</h2>
    </div>

    <div class="gr-stack reveal">
      <div class="gr-step">
        <div class="gr-terminal">
          <div class="gr-terminal-bar">
            <span class="gr-dot"></span>
            <span class="gr-dot"></span>
            <span class="gr-dot"></span>
            <span class="gr-terminal-title">bash</span>
          </div>
          <div class="gr-terminal-body">
            <div class="gr-line">
              <span class="gr-prompt">$</span>
              <span class="gr-cmd">npx keryai</span>
            </div>
            <div class="gr-line">
              <span class="gr-comment"># Installs and opens the Kery dashboard in your browser</span>
            </div>
          </div>
        </div>

        <div class="gr-mcp-row">
          <p class="gr-mcp-note">MCP server installed automatically. Use Kery directly from your editor or agent:</p>
          <div class="ide-icons-row">
            <div class="ide-icon-item">
              <div class="ide-icon-wrap">
                <img src="/icons/claude.svg" width="44" height="44" alt="Claude Code" loading="lazy" />
              </div>
              <span class="ide-icon-label">Claude</span>
            </div>
            <div class="ide-icon-item">
              <div class="ide-icon-wrap">
                <img src="/icons/cursor.webp" width="44" height="44" alt="Cursor" loading="lazy" />
              </div>
              <span class="ide-icon-label">Cursor</span>
            </div>
            <div class="ide-icon-item">
              <div class="ide-icon-wrap">
                <img src="/icons/copilot.webp" width="44" height="44" alt="GitHub Copilot" loading="lazy" />
              </div>
              <span class="ide-icon-label">Copilot</span>
            </div>
            <div class="ide-icon-item">
              <div class="ide-icon-wrap">
                <img src="/icons/codex.svg" width="44" height="44" alt="Codex" loading="lazy" />
              </div>
              <span class="ide-icon-label">Codex</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .getrunning-section {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .getrunning-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .getrunning-header h2 {
    margin-top: 0.5rem;
  }

  .gr-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 680px;
    margin: 0 auto;
  }

  .gr-step {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gr-step-label {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .gr-step-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.06em;
  }

  .gr-step-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .gr-step-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .gr-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-xl) 0;
  }

  .gr-terminal {
    background: #141816;
    border: 1px solid #2a302c;
    border-radius: var(--radius);
    overflow: clip;
  }

  .gr-terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 16px;
    background: #1c211e;
    border-bottom: 1px solid #2a302c;
  }

  .gr-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #444;
    flex-shrink: 0;
  }

  .gr-terminal-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #6b756f;
    letter-spacing: 0.04em;
  }

  .gr-terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: #e2e8e4;
  }

  .gr-json-body {
    padding: 1.25rem 1.5rem;
  }

  .gr-pre {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.75;
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .gr-line {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
  }

  .gr-prompt {
    color: #6b756f;
    flex-shrink: 0;
    user-select: none;
  }

  .gr-cmd {
    color: #e2e8e4;
    min-width: 0;
    word-break: break-word;
  }

  .gr-op {
    color: #9bc4a8;
  }

  .gr-comment {
    color: #4a5550;
  }

  .gr-key   { color: #e8b09a; }
  .gr-str   { color: #9bc4a8; }
  .gr-colon { color: #6b756f; }
  .gr-brace { color: #c5ccc7; }
  .gr-punct { color: #6b756f; }

  .gr-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .gr-mcp-row {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gr-mcp-note {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .gr-cta {
    flex-shrink: 0;
  }

  /* IDE icon row */
  .ide-icons-row {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .ide-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }

  .ide-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: opacity 0.2s, transform 0.15s;
  }

  .ide-icon-wrap img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }


  .ide-icon-item:hover .ide-icon-wrap {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .ide-icon-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .gr-step-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
