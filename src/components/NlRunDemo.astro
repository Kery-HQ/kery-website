---
/**
 * How-Kery-works widget: a manual natural-language run.
 * "Test my sign-up form" typed in plain English → Kery plans checks, runs them
 * in a real browser, and each check lands with a verdict — ending on
 * "4 passed · 1 failed — ▶ watch the run".
 *
 * Built like PrCheckDemo: the final verdict frame is the default markup state,
 * the animation plays from it, it pauses off-screen, and reduced-motion
 * renders the finished run.
 */
---

<div class="nlr-frame" id="demo" data-nlr-demo aria-label="Example: a Kery browser run written in plain English">
  <div class="nlr-chrome" aria-hidden="true">
    <span class="nlr-dots"><i></i><i></i><i></i></span>
    <span class="nlr-url">app.kery.dev · run #214</span>
    <span class="nlr-live"><i></i>live browser</span>
  </div>

  <div class="nlr-body">
    <div class="nlr-prompt">
      <span class="nlr-you" aria-hidden="true">You</span>
      <p class="nlr-prompt-text"><span class="nlr-typed">Test my sign-up form</span><i class="nlr-caret" aria-hidden="true"></i></p>
    </div>

    <div class="nlr-reply">
      <img class="nlr-avatar" src="/kery.png" alt="" width="32" height="32" loading="lazy" />
      <div class="nlr-reply-main">
        <div class="nlr-status">
          <p class="nlr-status-running" aria-hidden="true">
            <i class="nlr-spinner"></i>
            Planned 5 checks — running them in a real browser…
          </p>
          <p class="nlr-status-done">
            <strong><b class="ok">4 passed</b> · <b class="bad">1 failed</b></strong>
            <span class="nlr-sep">—</span>
            <a class="nlr-watch" href="#demo">▶ watch the run</a>
          </p>
        </div>

        <ul class="nlr-checks">
          <li class="nlr-check row-1 ok">
            <span class="nlr-ico ok" aria-hidden="true">✓</span>
            <span>Sign-up page opens from the header button</span>
          </li>
          <li class="nlr-check row-2 ok">
            <span class="nlr-ico ok" aria-hidden="true">✓</span>
            <span>Email field accepts a valid address</span>
          </li>
          <li class="nlr-check row-3 ok">
            <span class="nlr-ico ok" aria-hidden="true">✓</span>
            <span>Password field accepts a valid password</span>
          </li>
          <li class="nlr-check row-4 ok">
            <span class="nlr-ico ok" aria-hidden="true">✓</span>
            <span>Create account submits the form</span>
          </li>
          <li class="nlr-check row-5 bad">
            <span class="nlr-ico bad" aria-hidden="true">✕</span>
            <div class="nlr-check-main">
              <span>Success message appears after signing up</span>
              <p class="nlr-evidence">Submitted fine, then the page reloaded to an empty form. No confirmation shown.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .nlr-frame {
    --nlr-loop: 13s;
    --nlr-bg: #171714;
    --nlr-surface: #1d1b16;
    --nlr-line: rgba(255, 248, 232, 0.12);
    --nlr-fg: #fff8e8;
    --nlr-muted: rgba(255, 248, 232, 0.6);
    --nlr-green: #8bdba0;
    --nlr-red: #ff9388;
    --nlr-yellow: #ffcf49;
    overflow: hidden;
    border: 1px solid rgba(255, 248, 232, 0.14);
    border-radius: 14px;
    background: var(--nlr-bg);
    box-shadow:
      0 26px 70px rgba(38, 33, 21, 0.28),
      inset 0 1px 0 rgba(255, 248, 232, 0.06);
    color: var(--nlr-fg);
  }

  .nlr-chrome {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.68rem 0.9rem;
    border-bottom: 1px solid var(--nlr-line);
    background: #12120f;
  }

  .nlr-dots {
    display: flex;
    gap: 0.35rem;
  }

  .nlr-dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: #ff5f57;
  }

  .nlr-dots i:nth-child(2) { background: #febc2e; }
  .nlr-dots i:nth-child(3) { background: #28c840; }

  .nlr-url {
    flex: 1;
    max-width: 17rem;
    margin-inline: auto;
    overflow: hidden;
    padding: 0.22rem 0.85rem;
    border: 1px solid var(--nlr-line);
    border-radius: 6px;
    background: var(--nlr-bg);
    color: var(--nlr-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nlr-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--nlr-green);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .nlr-live i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
  }

  .is-animating .nlr-live i {
    animation: nlr-blink 1s steps(2, end) infinite;
  }

  .nlr-body {
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  /* ── You: the plain-English prompt ── */
  .nlr-prompt {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nlr-you {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.45rem;
    border: 1px solid var(--nlr-line);
    border-radius: 999px;
    background: var(--nlr-surface);
    color: var(--nlr-muted);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .nlr-prompt-text {
    display: flex;
    align-items: center;
    min-width: 0;
    flex: 1;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--nlr-line);
    border-radius: 10px;
    background: var(--nlr-surface);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .nlr-typed {
    display: inline-block;
    overflow: hidden;
    max-width: 100%;
    white-space: nowrap;
  }

  .nlr-caret {
    flex: 0 0 auto;
    width: 2px;
    height: 1.1em;
    margin-left: 0.15rem;
    background: var(--nlr-yellow);
    opacity: 0;
  }

  /* ── Kery's reply ── */
  .nlr-reply {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
  }

  .nlr-avatar {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--nlr-line);
    border-radius: 999px;
    background: #fff8e8;
    object-fit: contain;
  }

  .nlr-reply-main {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.75rem 0.85rem 0.85rem;
    border: 1px solid var(--nlr-line);
    border-radius: 10px;
    background: var(--nlr-surface);
  }

  .nlr-status {
    display: grid;
    align-items: start;
    min-height: 1.45rem;
  }

  .nlr-status p {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .nlr-status-running {
    color: var(--nlr-muted);
    opacity: 0;
    visibility: hidden;
  }

  .nlr-status-done strong {
    color: var(--nlr-fg);
    font-weight: 800;
  }

  .nlr-status-done b.ok {
    color: var(--nlr-green);
  }

  .nlr-status-done b.bad {
    color: var(--nlr-red);
  }

  .nlr-sep {
    color: var(--nlr-muted);
  }

  .nlr-spinner {
    flex: 0 0 auto;
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid rgba(255, 248, 232, 0.22);
    border-top-color: var(--nlr-fg);
    border-radius: 999px;
  }

  .nlr-watch {
    color: var(--nlr-yellow);
    font-weight: 800;
    border-radius: 6px;
  }

  .nlr-watch:hover {
    text-decoration: underline;
  }

  /* ── The checks ── */
  .nlr-checks {
    display: grid;
    border-top: 1px solid var(--nlr-line);
  }

  .nlr-check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.62rem 0.1rem;
    border-bottom: 1px solid var(--nlr-line);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .nlr-check:last-child {
    border-bottom: 0;
    padding-bottom: 0.1rem;
  }

  .nlr-check-main {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .nlr-ico {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.12rem;
    height: 1.12rem;
    margin-top: 0.18rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
  }

  .nlr-ico.ok {
    background: rgba(139, 219, 160, 0.14);
    color: var(--nlr-green);
  }

  .nlr-ico.bad {
    background: rgba(255, 147, 136, 0.14);
    color: var(--nlr-red);
  }

  .nlr-evidence {
    padding-left: 0.8rem;
    border-left: 2px solid var(--nlr-line);
    color: var(--nlr-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  /* ── Animation ──
     Defaults above are the final frame; the loop plays from it. */

  .is-animating .nlr-typed {
    animation: nlr-type var(--nlr-loop) steps(16, end) infinite both;
  }

  .is-animating .nlr-caret {
    animation: nlr-caret var(--nlr-loop) linear infinite both;
  }

  .is-animating .nlr-reply {
    animation: nlr-reveal-reply var(--nlr-loop) ease infinite both;
  }

  .is-animating .nlr-status-running {
    animation: nlr-status-running var(--nlr-loop) steps(1, end) infinite both;
  }

  .is-animating .nlr-spinner {
    animation: nlr-spin 0.9s linear infinite;
  }

  .is-animating .nlr-status-done {
    animation: nlr-status-done var(--nlr-loop) steps(1, end) infinite both;
  }

  .is-animating .nlr-watch {
    animation: nlr-watch-pulse var(--nlr-loop) ease infinite both;
  }

  .is-animating .nlr-check.row-1 { animation: nlr-row-1 var(--nlr-loop) ease infinite both; }
  .is-animating .nlr-check.row-2 { animation: nlr-row-2 var(--nlr-loop) ease infinite both; }
  .is-animating .nlr-check.row-3 { animation: nlr-row-3 var(--nlr-loop) ease infinite both; }
  .is-animating .nlr-check.row-4 { animation: nlr-row-4 var(--nlr-loop) ease infinite both; }
  .is-animating .nlr-check.row-5 { animation: nlr-row-5 var(--nlr-loop) ease infinite both; }
  .is-animating .nlr-evidence { animation: nlr-evidence var(--nlr-loop) ease infinite both; }

  .is-paused .nlr-typed,
  .is-paused .nlr-caret,
  .is-paused .nlr-reply,
  .is-paused .nlr-status-running,
  .is-paused .nlr-spinner,
  .is-paused .nlr-status-done,
  .is-paused .nlr-watch,
  .is-paused .nlr-check,
  .is-paused .nlr-evidence,
  .is-paused .nlr-live i {
    animation-play-state: paused;
  }

  /* Frame 1 — the prompt types out (0–14%) */
  @keyframes nlr-type {
    0%, 2% { max-width: 0; }
    14%, 100% { max-width: 14em; }
  }

  @keyframes nlr-caret {
    0% { opacity: 1; }
    2% { opacity: 0; }
    4% { opacity: 1; }
    6% { opacity: 0; }
    8% { opacity: 1; }
    10% { opacity: 0; }
    12% { opacity: 1; }
    15% { opacity: 1; }
    17%, 100% { opacity: 0; }
  }

  /* Frame 2 — Kery plans the checks (~18%) */
  @keyframes nlr-reveal-reply {
    0%, 17% { opacity: 0; transform: translateY(0.5rem); }
    20%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlr-status-running {
    0%, 17% { opacity: 0; visibility: hidden; }
    18%, 61% { opacity: 1; visibility: visible; }
    62%, 100% { opacity: 0; visibility: hidden; }
  }

  @keyframes nlr-status-done {
    0%, 61% { opacity: 0; visibility: hidden; }
    62%, 100% { opacity: 1; visibility: visible; }
  }

  @keyframes nlr-spin {
    to { transform: rotate(360deg); }
  }

  /* Frame 3 — checks land one at a time; rhythm breaks on the failure */
  @keyframes nlr-row-1 {
    0%, 25% { opacity: 0; transform: translateY(0.35rem); }
    28%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlr-row-2 {
    0%, 30% { opacity: 0; transform: translateY(0.35rem); }
    33%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlr-row-3 {
    0%, 35% { opacity: 0; transform: translateY(0.35rem); }
    38%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlr-row-4 {
    0%, 40% { opacity: 0; transform: translateY(0.35rem); }
    43%, 100% { opacity: 1; transform: translateY(0); }
  }

  /* longer pause, harder landing */
  @keyframes nlr-row-5 {
    0%, 51% { opacity: 0; transform: translateY(0.55rem) scale(0.99); background: transparent; }
    53% { opacity: 1; transform: translateY(0) scale(1.008); background: rgba(255, 147, 136, 0.08); }
    57%, 100% { opacity: 1; transform: translateY(0) scale(1); background: transparent; }
  }

  /* Frame 4 — evidence reveals, then the watch link gets the final beat */
  @keyframes nlr-evidence {
    0%, 63% { opacity: 0; transform: translateY(0.3rem); }
    67%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlr-watch-pulse {
    0%, 67% { box-shadow: none; }
    70% { box-shadow: 0 0 0 5px rgba(255, 207, 73, 0.24); }
    74%, 78% { box-shadow: none; }
    81% { box-shadow: 0 0 0 5px rgba(255, 207, 73, 0.24); }
    85%, 100% { box-shadow: none; }
  }

  @keyframes nlr-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.25; }
  }

  @media (max-width: 640px) {
    .nlr-body {
      padding: 0.85rem;
    }

    .nlr-live {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-animating .nlr-typed,
    .is-animating .nlr-caret,
    .is-animating .nlr-reply,
    .is-animating .nlr-status-running,
    .is-animating .nlr-spinner,
    .is-animating .nlr-status-done,
    .is-animating .nlr-watch,
    .is-animating .nlr-check,
    .is-animating .nlr-evidence,
    .is-animating .nlr-live i {
      animation: none;
    }
  }
</style>

<script>
  const nlrDemo = document.querySelector('[data-nlr-demo]');
  if (nlrDemo instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    nlrDemo.classList.add('is-animating');
    const nlrObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          nlrDemo.classList.toggle('is-paused', !entry.isIntersecting);
        });
      },
      { threshold: 0.12 }
    );
    nlrObserver.observe(nlrDemo);
  }
</script>
