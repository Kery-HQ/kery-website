---
const steps = [
  {
    num: '01',
    title: 'Connect your app.',
    desc: 'Register the URL (and auth if needed). Kery uses real environments — the same surfaces your users hit.',
  },
  {
    num: '02',
    title: 'Discover and plan.',
    desc: 'A breadth-first crawl maps pages, forms, and flows. Agents and saved tests turn intents into browser actions.',
  },
  {
    num: '03',
    title: 'Run, regress, iterate.',
    desc: 'Executions run in Playwright with LLM guidance, optional self-healing selectors, and a regression path that replays green runs without model calls.',
  },
];
---

<section class="how-it-works section">
  <div class="container">
    <div class="reveal">
      <h2>
        From URL to bugs you<br />
        can actually fix.
      </h2>
    </div>
    <div class="steps-grid reveal">
      {steps.map((step) => (
        <div class="step-card">
          <span class="step-num">{step.num}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works {
    text-align: center;
  }

  .how-it-works h2 {
    margin-bottom: var(--space-xl);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: left;
  }

  .step-card {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
    display: block;
  }

  .step-card h3 {
    margin-bottom: 0.5rem;
  }

  .step-card p {
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
