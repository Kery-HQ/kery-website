---
const agents = [
  {
    name: 'navigator',
    color: '#f59e0b',
    colorDim: 'rgba(245,158,11,0.15)',
    desc: 'Drives a real Chromium session. 15 action types. Flags broken UI, failed submissions, and state drift in real-time.',
  },
  {
    name: 'reviewer',
    color: '#3b82f6',
    colorDim: 'rgba(59,130,246,0.15)',
    desc: 'Post-run pass over the full flow. Catches functional gaps and state mismatches the navigator couldn\'t see mid-action.',
  },
  {
    name: 'filmstrip',
    color: '#a855f7',
    colorDim: 'rgba(168,85,247,0.15)',
    desc: 'Compares screenshots across the entire journey. Flags layout shifts, broken nav, and visual regressions.',
  },
  {
    name: 'memory_curator',
    color: '#22c55e',
    colorDim: 'rgba(34,197,94,0.15)',
    desc: 'Extracts navigation paths and bug patterns after each run. Proposes memory entries with confidence scores.',
  },
];
---

<hr class="section-divider" />
<section class="agents-section section">
  <div class="container">
    <div class="agents-header reveal">
      <span class="section-badge agents-badge">Architecture</span>
      <h2>Four agents. One run.</h2>
      <p class="agents-desc">
        Each agent has one job. Bugs from all sources are merged and deduplicated.
      </p>
    </div>
    <div class="agents-grid reveal">
      {agents.map((a) => (
        <div class="agent-card">
          <div class="agent-name-row">
            <span class="agent-dot" style={`background:${a.color}`}></span>
            <span class="agent-name">{a.name}</span>
          </div>
          <p class="agent-desc">{a.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .agents-section {
    background: #141816;
    color: #e8ece9;
    position: relative;
  }

  .agents-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .agents-badge {
    background: #1c211e;
    border-color: #2f3833;
    color: #c99882;
  }

  .agents-header h2 {
    color: #f2f5f3;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .agents-desc {
    color: #a8b0ab;
    max-width: 560px;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.7;
  }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #2a302c;
    border: 1px solid #2a302c;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .agent-card {
    background: #1c211e;
    padding: 2rem 1.75rem;
    transition: background 0.2s;
  }

  .agent-card:hover {
    background: #202620;
  }

  .agent-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .agent-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .agent-name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: #e8ece9;
    letter-spacing: 0.01em;
  }

  .agent-desc {
    font-size: 0.875rem;
    color: #8a948f;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .agents-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .agents-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
