---
import HangingMango from './HangingMango.astro';
---

<hr class="section-divider" />
<section class="feature-section section">
  <div class="container">
    <div class="feature-split reverse reveal">
      <div class="feature-text">
        <span class="section-badge">Works behind auth</span>
        <h2>Your login page is not a wall.</h2>
        <p>
          Most testing tools stop at login. Kery authenticates natively, including multi-factor, so you can
          test real app flows behind real auth.
        </p>
        <p>
          Supports form-based login, Clerk, and Supabase Auth.
        </p>
      </div>
      <div class="feature-visual">
        <div class="auth-icon-grid">
          <!-- Clerk -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap auth-icon-clerk">
              <img src="/icons/clerk-dark.png" width="32" height="32" alt="Clerk" loading="lazy" />
            </div>
            <span class="auth-icon-label">Clerk</span>
          </div>
          <!-- Supabase -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap auth-icon-supabase">
              <img src="/icons/supabase.webp" width="32" height="32" alt="Supabase" loading="lazy" />
            </div>
            <span class="auth-icon-label">Supabase</span>
          </div>
          <!-- Form Login -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap auth-icon-form">
              <img src="/icons/form-login.svg" width="36" height="36" alt="Form Login" loading="lazy" />
            </div>
            <span class="auth-icon-label">Form Login</span>
          </div>
        </div>
        <div class="auth-soon-row">
          <div class="auth-soon-box"></div>
          <div class="auth-soon-box"></div>
          <div class="auth-soon-box"></div>
        </div>
        <p class="auth-soon-label">More providers planned</p>
      </div>
    </div>
  </div>
</section>


<style>
  .feature-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .feature-split.reverse {
    direction: rtl;
  }

  .feature-split.reverse > * {
    direction: ltr;
  }

  .feature-text {
    max-width: 520px;
  }

  .feature-text h2 {
    margin-bottom: var(--space-sm);
  }

  .feature-text p {
    margin-bottom: var(--space-sm);
  }

  .feature-note {
    font-style: italic;
    color: var(--color-text-muted) !important;
    font-size: 0.9rem !important;
    margin-top: var(--space-sm);
  }

  .feature-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .mockup-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 2rem;
    width: 100%;
    max-width: 540px;
  }

  .agent-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  .agent-badge {
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-accent-muted);
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .agent-flow {
    font-size: 0.9rem;
  }

  .agent-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .agent-row-success {
    border-bottom: none;
  }

  .agent-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .agent-mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .agent-arrow {
    text-align: center;
    color: var(--color-accent);
    font-size: 0.85rem;
    padding: 0.15rem 0;
  }

  .heartbeat-dark {
    background: #141816;
    color: #e8ece9;
    position: relative;
    overflow: hidden;
  }

  .dark-badge {
    background: #1c211e;
    border-color: #2f3833;
    color: var(--color-accent-muted);
  }

  .badge-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
    margin-right: 0.35rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .heartbeat-dark h2 {
    color: #f2f5f3;
  }

  .dark-text {
    color: #a8b0ab !important;
  }

  .dark-text strong {
    color: #e8ece9;
  }

  .dark-list {
    list-style: none;
    margin-top: var(--space-sm);
  }

  .dark-list li {
    padding: 0.35rem 0;
    font-size: 0.9rem;
    color: #9aa39e;
    padding-left: 1.25rem;
    position: relative;
  }

  .dark-list li::before {
    content: '↳';
    position: absolute;
    left: 0;
    color: #5c6560;
  }

  .dark-mockup {
    background: #1c211e;
    border: 1px solid #2a302c;
  }

  .reg-block {
    font-size: 0.88rem;
  }

  .reg-header {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #6b756f;
    margin-bottom: 1rem;
  }

  .reg-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid #2a302c;
    color: #c5ccc7;
  }

  .reg-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
  }

  .reg-explore {
    background: rgba(184, 92, 58, 0.2);
    color: #e8b09a;
  }

  .reg-record {
    background: rgba(155, 196, 168, 0.15);
    color: #9bc4a8;
  }

  .reg-replay {
    background: rgba(155, 196, 168, 0.15);
    color: #9bc4a8;
  }

  .reg-heal {
    background: rgba(245, 158, 11, 0.15);
    color: #f5b84b;
  }

  .reg-fail {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  .reg-step-last {
    border-bottom: none;
  }

  .dark-code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: rgba(255,255,255,0.07);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    color: #9bc4a8;
  }

  .dash-mock {
    font-size: 0.88rem;
  }

  .dash-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .dash-head {
    font-weight: 600;
    color: var(--color-text);
  }

  .dash-pill {
    margin-left: auto;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: 500;
  }

  .dash-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0.75rem 0 1rem;
  }

  .dash-kpi {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dash-k {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dash-v {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
  }

  .dash-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-muted);
    flex-shrink: 0;
  }

  .dash-warn {
    background: #c99882;
  }

  .dash-mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-left: auto;
  }

  /* Auth icon grid */
  .auth-icon-grid {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: flex-start;
  }

  .auth-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .auth-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.15s, opacity 0.15s;
  }

  .auth-icon-wrap img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .auth-icon-form img {
    width: 36px;
    height: 36px;
  }

  /* Per-brand backgrounds */
  .auth-icon-form {
    background: #f0eeec;
  }

  .auth-icon-clerk {
    background: #f5f4f2;
  }

  .auth-icon-supabase {
    background: #1c1f1e;
  }

  .auth-icon-item:hover .auth-icon-wrap {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .auth-soon-row {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .auth-soon-box {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    border: 1.5px dashed var(--color-border);
    background: transparent;
  }

  .auth-soon-label {
    text-align: center;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-top: 0.75rem;
  }

  .auth-icon-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .oss-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: var(--space-md);
  }

  .oss-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .oss-card strong {
    font-size: 0.9rem;
  }

  .oss-card span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .heal-mock {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .heal-line {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .heal-bad {
    color: #b85c3a;
  }

  .heal-x {
    color: var(--color-text-muted);
    margin-left: 0.5rem;
  }

  .heal-resolve {
    border-bottom: none;
    padding-top: 1rem;
  }

  .heal-good {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .feature-split {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .feature-split.reverse {
      direction: ltr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-pulse {
      animation: none;
    }
  }
</style>
