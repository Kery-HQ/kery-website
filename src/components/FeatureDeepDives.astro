---
import HangingMango from './HangingMango.astro';
---

<hr class="section-divider" />
<section class="feature-section section heartbeat-dark" id="regression-section">
  <HangingMango left="72%" wire={64} delay={0} />
  <div class="container">
    <div class="feature-split reveal">
      <div class="feature-text">
        <span class="section-badge dark-badge">
          <span class="badge-pulse"></span>
          Regression engine
        </span>
        <h2>Every deploy is a regression test.</h2>
        <p class="dark-text">
          The first run explores your app and compiles a <code class="dark-code">.spec.ts</code> file.
          That script runs on every subsequent deploy - no prompts, no LLM calls, no maintenance.
          If a selector drifts, the <code class="dark-code">heal</code> agent patches it and keeps going.
          If a flow breaks, you hear about it before your users do.
        </p>
        <ul class="dark-list">
          <li>Drop the compiled script into any CI pipeline</li>
          <li>Selectors self-heal - no manual selector upkeep</li>
          <li>Replay cost: ~$0.001 per run</li>
        </ul>
      </div>
      <div class="feature-visual">
        <div class="mockup-card dark-mockup">
          <div class="reg-block">
            <div class="reg-header">On every deploy</div>
            <div class="reg-step">
              <span class="reg-tag reg-replay">Replay</span>
              <span>Run compiled <code class="dark-code">.spec.ts</code> - no LLM</span>
            </div>
            <div class="reg-step">
              <span class="reg-tag reg-heal">Heal</span>
              <span>Broken selector? Patch from a11y tree, continue</span>
            </div>
            <div class="reg-step reg-step-last">
              <span class="reg-tag reg-fail">Fail</span>
              <span>Flow actually broke - alert fired, run stopped</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="section-divider" />
<section class="feature-section section">
  <div class="container">
    <div class="feature-split reverse reveal">
      <div class="feature-text">
        <span class="section-badge">Works behind auth</span>
        <h2>Your login page is not a wall.</h2>
        <p>
          Most testing tools stop at login. Kery authenticates natively, including multi-factor, so you can
          test real app flows behind real auth.
        </p>
        <p>
          Supports Clerk, Supabase Auth, OAuth 2.0, API tokens, TOTP/2FA, and custom providers.
        </p>
      </div>
      <div class="feature-visual">
        <div class="auth-icon-grid">
          <!-- Clerk -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M19 8.5C17.3 5.5 14.4 3.5 12 3.5a8.5 8.5 0 0 0-8.5 8.5A8.5 8.5 0 0 0 12 20.5c2.4 0 5.3-2 7-5"/>
              </svg>
            </div>
            <span class="auth-icon-label">Clerk</span>
          </div>
          <!-- Supabase -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2L4.5 13.5H11L9 22l10.5-12H13z"/>
              </svg>
            </div>
            <span class="auth-icon-label">Supabase</span>
          </div>
          <!-- OAuth -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <rect x="5" y="11" width="14" height="11" rx="2"/>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
              </svg>
            </div>
            <span class="auth-icon-label">OAuth 2.0</span>
          </div>
          <!-- GitHub -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
              </svg>
            </div>
            <span class="auth-icon-label">GitHub</span>
          </div>
          <!-- API Token -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="7.5" cy="15.5" r="5.5"/>
                <path d="M21 2l-9.6 9.6M15.5 7.5l3 3"/>
              </svg>
            </div>
            <span class="auth-icon-label">API Token</span>
          </div>
          <!-- TOTP / 2FA -->
          <div class="auth-icon-item">
            <div class="auth-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <span class="auth-icon-label">TOTP / 2FA</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .feature-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .feature-split.reverse {
    direction: rtl;
  }

  .feature-split.reverse > * {
    direction: ltr;
  }

  .feature-text {
    max-width: 520px;
  }

  .feature-text h2 {
    margin-bottom: var(--space-sm);
  }

  .feature-text p {
    margin-bottom: var(--space-sm);
  }

  .feature-note {
    font-style: italic;
    color: var(--color-text-muted) !important;
    font-size: 0.9rem !important;
    margin-top: var(--space-sm);
  }

  .feature-visual {
    display: flex;
    justify-content: center;
  }

  .mockup-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 2rem;
    width: 100%;
    max-width: 540px;
  }

  .agent-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  .agent-badge {
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-accent-muted);
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .agent-flow {
    font-size: 0.9rem;
  }

  .agent-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .agent-row-success {
    border-bottom: none;
  }

  .agent-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .agent-mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .agent-arrow {
    text-align: center;
    color: var(--color-accent);
    font-size: 0.85rem;
    padding: 0.15rem 0;
  }

  .heartbeat-dark {
    background: #141816;
    color: #e8ece9;
    position: relative;
    overflow: hidden;
  }

  .dark-badge {
    background: #1c211e;
    border-color: #2f3833;
    color: var(--color-accent-muted);
  }

  .badge-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
    margin-right: 0.35rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .heartbeat-dark h2 {
    color: #f2f5f3;
  }

  .dark-text {
    color: #a8b0ab !important;
  }

  .dark-text strong {
    color: #e8ece9;
  }

  .dark-list {
    list-style: none;
    margin-top: var(--space-sm);
  }

  .dark-list li {
    padding: 0.35rem 0;
    font-size: 0.9rem;
    color: #9aa39e;
    padding-left: 1.25rem;
    position: relative;
  }

  .dark-list li::before {
    content: '↳';
    position: absolute;
    left: 0;
    color: #5c6560;
  }

  .dark-mockup {
    background: #1c211e;
    border: 1px solid #2a302c;
  }

  .reg-block {
    font-size: 0.88rem;
  }

  .reg-header {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #6b756f;
    margin-bottom: 1rem;
  }

  .reg-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid #2a302c;
    color: #c5ccc7;
  }

  .reg-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
  }

  .reg-explore {
    background: rgba(184, 92, 58, 0.2);
    color: #e8b09a;
  }

  .reg-record {
    background: rgba(155, 196, 168, 0.15);
    color: #9bc4a8;
  }

  .reg-replay {
    background: rgba(155, 196, 168, 0.15);
    color: #9bc4a8;
  }

  .reg-heal {
    background: rgba(245, 158, 11, 0.15);
    color: #f5b84b;
  }

  .reg-fail {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  .reg-step-last {
    border-bottom: none;
  }

  .dark-code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: rgba(255,255,255,0.07);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    color: #9bc4a8;
  }

  .dash-mock {
    font-size: 0.88rem;
  }

  .dash-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .dash-head {
    font-weight: 600;
    color: var(--color-text);
  }

  .dash-pill {
    margin-left: auto;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: 500;
  }

  .dash-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0.75rem 0 1rem;
  }

  .dash-kpi {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dash-k {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dash-v {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
  }

  .dash-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-muted);
    flex-shrink: 0;
  }

  .dash-warn {
    background: #c99882;
  }

  .dash-mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-left: auto;
  }

  /* Auth icon grid */
  .auth-icon-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 360px;
  }

  .auth-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .auth-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .auth-icon-item:hover .auth-icon-wrap {
    border-color: var(--color-accent-muted);
    color: var(--color-text);
    background: var(--color-accent-soft);
  }

  .auth-icon-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }

  .oss-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: var(--space-md);
  }

  .oss-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .oss-card strong {
    font-size: 0.9rem;
  }

  .oss-card span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .heal-mock {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .heal-line {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .heal-bad {
    color: #b85c3a;
  }

  .heal-x {
    color: var(--color-text-muted);
    margin-left: 0.5rem;
  }

  .heal-resolve {
    border-bottom: none;
    padding-top: 1rem;
  }

  .heal-good {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .feature-split {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .feature-split.reverse {
      direction: ltr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-pulse {
      animation: none;
    }
  }
</style>
