---
const features = [
  {
    abbr: 'DISC',
    title: 'Discovery',
    desc: 'Point Kery at a URL. It crawls pages, maps forms and interactions, and suggests test flows before you write anything.',
  },
  {
    abbr: 'BUG',
    title: 'Bug Detection',
    desc: 'Find functional, visual, UX, and API bugs during and after runs with screenshots, severity, and context.',
  },
  {
    abbr: 'HEAL',
    title: 'Self-Healing',
    desc: "Selectors break. Kery doesn't. Intent-based element resolution helps runs survive UI changes.",
  },
  {
    abbr: 'REPL',
    title: 'Regression Replay',
    desc: 'Successful runs compile into Playwright scripts so later runs are deterministic and near-zero cost.',
  },
  {
    abbr: 'AUTH',
    title: 'Auth',
    desc: 'Clerk, Supabase, OAuth, API tokens, and TOTP/2FA support for testing real flows behind login.',
  },
  {
    abbr: 'MEM',
    title: 'Memory',
    desc: 'Kery learns navigation paths and failure patterns over time, so tests get better with use.',
  },
];
---

<section class="features-section section">
  <div class="container">
    <div class="features-header reveal">
      <span class="section-badge">Feature primitives</span>
      <h2>
        Core capabilities,<br />
        clearly separated.
      </h2>
    </div>
    <div class="features-grid reveal">
      {features.map((f) => (
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">{f.abbr}</span>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .features-header h2 {
    margin-top: 0.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    transition: border-color 0.2s ease;
  }

  .feature-card:hover {
    border-color: var(--color-accent-muted);
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-light);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-accent-hover);
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }

  .feature-card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .feature-card p {
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
