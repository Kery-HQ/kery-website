---
const identities = [
  {
    title: 'Browser test engine.',
    desc: 'Runs real flows in Playwright and reports reproducible failures with screenshots and steps.',
  },
  {
    title: 'Intent-first checks.',
    desc: 'Describe the product path once. Kery plans the route, executes it, and shows what happened.',
  },
  {
    title: 'MCP + SDK + API.',
    desc: 'Call the same testing backend from editor agents, scripts, or product workflows.',
  },
  {
    title: 'Open-source and self-hosted.',
    desc: 'Bring your own model provider and keep run artifacts inside your infrastructure.',
  },
];
---

<hr class="section-divider" />
<section class="what-is-section section">
  <div class="container reveal">
    <span class="section-badge">What Kery is</span>
    <h2>A browser testing loop your agents can use.</h2>
    <div class="identity-grid">
      {identities.map((item) => (
        <div class="identity-card">
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .what-is-section h2 {
    margin-top: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  .identity-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .identity-card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }

  .identity-card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .identity-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .identity-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
