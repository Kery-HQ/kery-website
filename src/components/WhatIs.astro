---
const identities = [
  {
    title: 'Open-source testing engine.',
    desc: 'Explores your app in a real browser and reports functional, visual, and API bugs with evidence.',
  },
  {
    title: 'Intent-first workflow.',
    desc: 'Describe what to test in plain English, then let Kery explore and execute the flow end-to-end.',
  },
  {
    title: 'Compiled regression replay.',
    desc: 'Successful runs become deterministic Playwright scripts so repeat runs do not burn LLM tokens.',
  },
  {
    title: 'MCP + SDK + API.',
    desc: 'Use Kery from your editor agent, CLI, or backend integration with one shared execution backend.',
  },
  {
    title: 'Self-healing selectors.',
    desc: 'Intent-based element resolution helps tests survive UI changes without constant selector rewrites.',
  },
  {
    title: 'Self-hosted by default.',
    desc: 'Apache 2.0. Run it on your infrastructure and bring your own model provider and pricing.',
  },
];
---

<hr class="section-divider" />
<section class="what-is-section section">
  <div class="container reveal">
    <span class="section-badge">What Kery is</span>
    <h2>Built to ship, not babysit tests.</h2>
    <div class="identity-grid">
      {identities.map((item) => (
        <div class="identity-card">
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .what-is-section h2 {
    margin-top: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  .identity-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .identity-card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }

  .identity-card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .identity-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .identity-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
